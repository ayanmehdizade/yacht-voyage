<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Marmaris Yacht Tours - Rezervasyon</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 font-sans text-slate-800">
    <!-- Top CRM Bar -->
    <div class="bg-slate-900 text-white text-xs py-2 px-6 flex justify-between items-center">
        <div class="flex items-center space-x-2">
            <span class="bg-teal-500 text-slate-950 px-2 py-0.5 rounded text-[10px] font-bold uppercase">Canlı CRM</span>
            <span>Marmaris Yacht Tours & Rezervasyon Sistemi</span>
        </div>
        <a href="/admin" class="bg-teal-600 hover:bg-teal-500 text-white px-3 py-1 rounded font-semibold transition">Admin Panele Giriş →</a>
    </div>

    <!-- Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <a href="/" class="flex items-center space-x-2.5">
                <i class="fa-solid fa-sailboat text-2xl text-teal-600"></i>
                <span class="font-bold text-lg text-slate-900">Marmaris Yacht Tours</span>
            </a>
            <nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-slate-600">
                <a href="#turlar" class="hover:text-teal-600 transition">Turlar</a>
                <a href="#avantajlar" class="hover:text-teal-600 transition">Avantajlar</a>
                <a href="/admin" class="text-teal-700 font-semibold hover:underline">CRM Panel</a>
            </nav>
            <a href="#turlar" class="bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">Rezervasyon</a>
        </div>
    </header>

    <!-- Hero & Filtre -->
    <div class="relative bg-slate-900 text-white py-20 px-6">
        <div class="absolute inset-0 opacity-35 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1569263979104-865ab9cd8d5e?auto=format&fit=crop&w=1920&q=80')"></div>
        <div class="max-w-7xl mx-auto relative z-10 space-y-8">
            <div class="max-w-2xl">
                <h1 class="text-3xl md:text-5xl font-extrabold leading-tight mb-3">Marmaris koylarını kendi rotanda keşfet</h1>
                <p class="text-slate-200 text-base">Marmaris’te günlük ve özel yat turları, hızlı rezervasyon ve şeffaf fiyatlarla.</p>
            </div>

            <form action="/" method="GET" class="bg-white text-slate-800 p-4 rounded-2xl shadow-xl grid grid-cols-1 md:grid-cols-4 gap-3 items-end">
                <div>
                    <label class="block text-[11px] font-bold text-slate-400 uppercase mb-1">Kalkış Noktası</label>
                    <select name="location" class="w-full p-2.5 text-sm border border-slate-200 rounded-xl bg-slate-50">
                        <option value="all">Tümü</option>
                        <% locations.forEach(loc => { %>
                            <option value="<%= loc %>" <%= filters.location === loc ? 'selected' : '' %>><%= loc %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-400 uppercase mb-1">Kişi Sayısı (Min)</label>
                    <input type="number" name="guests" min="1" value="<%= filters.guests %>" placeholder="Örn: 4" class="w-full p-2.5 text-sm border border-slate-200 rounded-xl bg-slate-50">
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-400 uppercase mb-1">Tur Tipi</label>
                    <select name="type" class="w-full p-2.5 text-sm border border-slate-200 rounded-xl bg-slate-50">
                        <option value="all">Tümü</option>
                        <% types.forEach(t => { %>
                            <option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= t %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="flex space-x-2">
                    <button type="submit" class="flex-1 bg-teal-600 hover:bg-teal-700 text-white py-2.5 px-4 rounded-xl text-sm font-bold transition">Turları Keşfet</button>
                    <a href="/" class="px-3 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-500 hover:bg-slate-50 flex items-center" title="Sıfırla"><i class="fa-solid fa-rotate-left"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Turlar -->
    <main id="turlar" class="max-w-7xl mx-auto px-6 py-12 space-y-6">
        <% if (bookedRef) { %>
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-4 rounded-xl flex items-center justify-between text-sm">
                <div>
                    <i class="fa-solid fa-circle-check mr-2 text-emerald-600"></i>
                    Rezervasyon talebiniz alındı! Referans kodunuz: <strong><%= bookedRef %></strong>. CRM paneline eklendi.
                </div>
                <a href="/admin" class="font-bold underline">CRM'de Gör</a>
            </div>
        <% } %>

        <div class="flex items-center justify-between">
            <h2 class="text-2xl font-bold text-slate-900">Popüler Turlar</h2>
            <span class="text-xs text-slate-500"><%= yachts.length %> tur listeleniyor</span>
        </div>

        <% if (yachts.length === 0) { %>
            <div class="bg-white p-10 rounded-2xl border border-slate-200 text-center text-slate-500">
                Seçilen kriterlere uygun tur bulunamadı. <a href="/" class="text-teal-600 font-semibold underline">Filtreleri temizle</a>
            </div>
        <% } %>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <% yachts.forEach(yacht => { %>
                <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm flex flex-col justify-between">
                    <div>
                        <img src="<%= yacht.image %>" alt="<%= yacht.name %>" class="h-48 w-full object-cover">
                        <div class="p-5">
                            <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
                                <span><%= yacht.type %></span>
                                <span><%= yacht.location %></span>
                            </div>
                            <h3 class="text-lg font-bold text-slate-900"><%= yacht.name %></h3>
                            <p class="text-xs text-slate-500 mt-1"><%= yacht.description %></p>
                            <div class="flex items-center space-x-4 text-xs text-slate-600 mt-3">
                                <span><i class="fa-regular fa-clock text-teal-600 mr-1"></i><%= yacht.duration %></span>
                                <span><i class="fa-solid fa-users text-teal-600 mr-1"></i>En fazla <%= yacht.guests %> kişi</span>
                            </div>
                            <p class="text-teal-700 font-extrabold text-lg mt-4"><%= yacht.price %> € <span class="text-xs font-normal text-slate-400">'dan başlayan fiyatlar</span></p>
                        </div>
                    </div>

                    <form action="/book" method="POST" class="p-5 pt-4 border-t border-slate-100 space-y-2.5 bg-slate-50/60">
                        <input type="hidden" name="yachtName" value="<%= yacht.name %>">
                        <input type="text" name="customerName" placeholder="Adınız Soyadınız" required class="w-full p-2 text-sm border border-slate-300 rounded-lg bg-white">
                        <div class="grid grid-cols-2 gap-2">
                            <input type="date" name="date" required class="p-2 text-xs border border-slate-300 rounded-lg bg-white">
                            <input type="number" name="guests" min="1" max="<%= yacht.guests %>" value="2" required class="p-2 text-xs border border-slate-300 rounded-lg bg-white" placeholder="Kişi">
                        </div>
                        <input type="text" name="phone" placeholder="Telefon (İsteğe bağlı)" class="w-full p-2 text-xs border border-slate-300 rounded-lg bg-white">
                        <button type="submit" class="w-full bg-slate-900 hover:bg-teal-600 text-white py-2.5 rounded-lg text-sm font-semibold transition">Rezerv Et</button>
                    </form>
                </div>
            <% }) %>
        </div>

        <!-- Avantajlar Bar -->
        <section id="avantajlar" class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-6 border-t border-slate-200 text-sm text-slate-700">
            <div class="bg-white p-4 rounded-xl border border-slate-200 flex items-center space-x-3">
                <i class="fa-solid fa-shield-halved text-teal-600 text-lg"></i>
                <span class="font-medium">Lisanslı kaptanlar</span>
            </div>
            <div class="bg-white p-4 rounded-xl border border-slate-200 flex items-center space-x-3">
                <i class="fa-solid fa-ship text-teal-600 text-lg"></i>
                <span class="font-medium">Güvenli tekneler</span>
            </div>
            <div class="bg-white p-4 rounded-xl border border-slate-200 flex items-center space-x-3">
                <i class="fa-brands fa-whatsapp text-teal-600 text-lg"></i>
                <span class="font-medium">WhatsApp desteği</span>
            </div>
            <div class="bg-white p-4 rounded-xl border border-slate-200 flex items-center space-x-3">
                <i class="fa-regular fa-calendar-check text-teal-600 text-lg"></i>
                <span class="font-medium">Ücretsiz iptal seçeneği</span>
            </div>
        </section>
    </main>
</body>
</html>