<%- include('../partials/header') %>

<main class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden">
        <div class="bg-[#0B1F3A] text-white p-8 text-center space-y-3">
            <div class="w-16 h-16 rounded-full bg-emerald-500/20 border border-emerald-400 text-emerald-300 flex items-center justify-center mx-auto text-2xl">
                <i class="fa-solid fa-check"></i>
            </div>
            <span class="inline-block bg-white/10 text-sky-200 text-xs font-bold px-3.5 py-1 rounded-full">
                Durum: <%= booking.status %>
            </span>
            <h1 class="text-2xl md:text-3xl font-extrabold">Rezervasyonunuz Alındı!</h1>
            <p class="text-slate-300 text-sm">Mavi yolculuk voucher belgeniz oluşturuldu. PNR kodunuz ile dilediğiniz zaman sorgulama yapabilirsiniz.</p>

            <div class="pt-2 flex items-center justify-center space-x-2">
                <span id="pnrCodeText" class="bg-white text-[#0B1F3A] font-mono font-extrabold text-lg px-4 py-1.5 rounded-xl tracking-wider"><%= booking.id %></span>
                <button type="button" id="copyPnrBtn" class="no-print bg-white/15 hover:bg-white/25 text-white px-3.5 py-2 rounded-xl text-xs font-bold transition">
                    <i class="fa-regular fa-copy mr-1"></i>Kopyala
                </button>
            </div>
        </div>

        <div class="p-6 md:p-8 space-y-6">
            <div class="flex flex-col sm:flex-row items-center gap-4 bg-slate-50 p-4 rounded-2xl border border-slate-100">
                <img src="<%= yacht.images[0] %>" alt="<%= yacht.name %>" class="w-full sm:w-32 h-24 object-cover rounded-xl">
                <div class="flex-1 text-center sm:text-left">
                    <div class="text-xs font-bold text-teal-700 uppercase"><%= booking.charterType %></div>
                    <h2 class="text-xl font-extrabold text-slate-900"><%= booking.yacht %></h2>
                    <p class="text-xs text-slate-500"><%= yacht.location %> Marina • <%= yacht.length %> • <%= booking.guests %> Misafir</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div class="bg-slate-50 p-4 rounded-xl">
                    <span class="text-slate-400 block">Giriş — Çıkış Tarihi</span>
                    <strong class="text-sm text-slate-900"><%= booking.checkIn %> → <%= booking.checkOut %> (<%= booking.days %> Gün)</strong>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl">
                    <span class="text-slate-400 block">Misafir Bilgileri</span>
                    <strong class="text-sm text-slate-900"><%= booking.customer %></strong>
                    <span class="text-slate-500 block mt-0.5"><%= booking.email %> • <%= booking.phone %></span>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl">
                    <span class="text-slate-400 block">Ödeme Planı &amp; Yöntemi</span>
                    <strong class="text-sm text-slate-900"><%= booking.paymentType %> • <%= booking.paymentMethod || 'Kart' %></strong>
                </div>
                <div class="bg-sky-50 p-4 rounded-xl border border-sky-100">
                    <span class="text-sky-700 block font-semibold">Ödeme Özeti</span>
                    <strong class="text-sm text-[#0B1F3A]">Ödenen: €<%= booking.paidAmount.toLocaleString() %> / Toplam: €<%= booking.totalAmount.toLocaleString() %></strong>
                    <span class="text-[11px] text-slate-500 block mt-0.5">Marinada Kalan: €<%= (booking.totalAmount - booking.paidAmount).toLocaleString() %></span>
                </div>
            </div>

            <% if (booking.extras && booking.extras.length > 0) { %>
                <div class="text-xs bg-slate-50 p-4 rounded-xl">
                    <span class="text-slate-400 font-bold uppercase block mb-1.5">Seçilen Ekstra VIP Hizmetler</span>
                    <div class="flex flex-wrap gap-2">
                        <% for (let i = 0; i < booking.extras.length; i++) { %>
                            <span class="bg-white border border-slate-200 px-3 py-1 rounded-lg font-semibold text-slate-700">✓ <%= booking.extras[i] %></span>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <% if (booking.notes) { %>
                <div class="text-xs bg-amber-50/70 border border-amber-200 p-4 rounded-xl text-amber-900">
                    <strong>Misafir Notu:</strong> <%= booking.notes %>
                </div>
            <% } %>

            <div class="no-print flex flex-wrap justify-between items-center gap-3 pt-4 border-t border-slate-100">
                <a href="/" class="px-5 py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-xl text-xs font-bold transition">
                    ← Ana Sayfaya Dön
                </a>

                <div class="flex flex-wrap gap-2.5">
                    <a id="waVoucherBtn" href="#" target="_blank" class="px-4 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition">
                        <i class="fa-brands fa-whatsapp mr-1.5"></i>WhatsApp'a Gönder
                    </a>
                    <button type="button" id="printVoucherBtn" class="px-5 py-3 bg-[#0B1F3A] hover:bg-sky-900 text-white rounded-xl text-xs font-bold transition">
                        <i class="fa-solid fa-print mr-1.5"></i>Voucher Yazdır / PDF
                    </button>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    const pnrText = document.getElementById('pnrCodeText').innerText.trim();
    const copyBtn = document.getElementById('copyPnrBtn');
    if (copyBtn) {
        copyBtn.addEventListener('click', function() {
            navigator.clipboard.writeText(pnrText);
            this.innerHTML = '<i class="fa-solid fa-check mr-1"></i>Kopyalandı';
        });
    }

    const printBtn = document.getElementById('printVoucherBtn');
    if (printBtn) {
        printBtn.addEventListener('click', function() {
            window.print();
        });
    }

    const waBtn = document.getElementById('waVoucherBtn');
    if (waBtn) {
        const msg = encodeURIComponent('YachtVoyage Rezervasyon Onayım — PNR: ' + pnrText + ' | Yat: <%= booking.yacht %> | Tarih: <%= booking.checkIn %> - <%= booking.checkOut %>');
        waBtn.href = 'https://wa.me/902521234567?text=' + msg;
    }
</script>

<%- include('../partials/footer') %>