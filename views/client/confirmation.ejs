<%- include('../partials/header') %>

<% const confIsEn = (typeof isEn !== 'undefined') ? Boolean(isEn) : (typeof lang !== 'undefined' && lang === 'en'); %>
<% const cSite = (typeof siteSettings !== 'undefined' && siteSettings) ? siteSettings : {
    brandName: 'YachtVoyage',
    whatsappNumber: '902521234567'
}; %>
<% const cleanWaNum = String(cSite.whatsappNumber || '902521234567').replace(/\D/g, '') || '902521234567'; %>

<% const rawConfStatus = String(booking.status || ''); %>
<% const isCancelled = ['İptal Edildi', 'İptal', 'Cancelled'].includes(rawConfStatus); %>
<% const isRejected = ['Reddedildi', 'Reddedildi (Hava Muhalefeti)', 'Rejected'].includes(rawConfStatus); %>
<% const isApproved = !isCancelled && !isRejected && ['Onaylandı', 'Approved', 'Confirmed'].includes(rawConfStatus); %>
<% const isPendingApproval = !isCancelled && !isRejected && !isApproved; %>

<% const bTotal = Number(booking.totalAmount || 0); %>
<% const bPaid = Number(booking.paidAmount || 0); %>
<% const bRefunded = Number(booking.refundedAmount || 0); %>
<% const remainingBal = (isCancelled || isRejected) ? 0 : Math.max(0, bTotal - bPaid); %>

<% const statusDisplay = confIsEn
    ? (isCancelled
        ? 'Cancelled'
        : (isRejected
            ? 'Rejected'
            : (isApproved ? 'Approved' : 'Pending Admin Approval')))
    : (isCancelled
        ? 'İptal Edildi'
        : (isRejected
            ? 'Reddedildi'
            : (isApproved ? 'Onaylandı' : 'Admin Onayı Bekliyor'))); %>

<% const charterTypeMap = {
    'Özel Yat Kiralama (Konaklamalı)': 'Private Yacht Charter (Overnight)',
    'Özel Yat Kiralama': 'Private Yacht Charter',
    'Günlük VIP Koy Turu': 'Daily VIP Cove Tour'
}; %>
<% const charterDisplay = confIsEn
    ? (booking.charterTypeEn || charterTypeMap[booking.charterType] || booking.charterType || 'Private Yacht Charter')
    : (booking.charterType || 'Özel Yat Kiralama'); %>

<% const payTypeMap = {
    'Hisseli Ödeme': 'Installment Plan',
    'Tam Ödeme (İndirimli)': 'Full Payment (Discounted)',
    'Standart': 'Standard'
}; %>
<% const payMethodMap = {
    'Kredi / Banka Kartı': 'Credit / Debit Card',
    'Havale / EFT': 'Bank Transfer / EFT',
    'Marinada Ödeme': 'Marina Payment',
    'Nakit / Marina Ödemesi': 'Cash / Marina Payment',
    'Kart': 'Card'
}; %>
<% const payTypeDisplay = confIsEn
    ? (booking.paymentTypeEn || payTypeMap[booking.paymentType] || booking.paymentType || 'Standard')
    : (booking.paymentType || 'Standart'); %>
<% const payMethodDisplay = confIsEn
    ? (booking.paymentMethodEn || payMethodMap[booking.paymentMethod] || booking.paymentMethod || 'Card')
    : (booking.paymentMethod || 'Kart'); %>

<% const extrasTrToEn = {
    'VIP Havalimanı Transferi': 'VIP Airport Transfer',
    'Özel Şef & Gurme Menü': 'Private Chef & Gourmet Menu',
    'Jet Ski & Seabob Paketi': 'Jet Ski & Seabob Package',
    'Seabob & Su Sporları Paketi': 'Seabob & Water Sports Package'
}; %>
<% const daysCount = Number(booking.days || 1); %>
<% const guestsCount = Number(booking.guests || 1); %>
<% const confImgSrc = (yacht && Array.isArray(yacht.images) && yacht.images[0]) ? yacht.images[0] : 'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=1000&q=80'; %>

<% const captainName = (booking.captainName || booking.assignedCaptain || '').trim(); %>
<% const captainPhone = (booking.captainPhone || '').trim(); %>
<% const transferPhone = (booking.transferPhone || booking.transferContactPhone || '').trim(); %>
<% const transferDriver = (booking.transferContactName || booking.transferDriver || '').trim(); %>
<% const boardingInfo = (booking.boardingDetails || booking.marinaPier || '').trim(); %>
<% const rejectionReasonText = (booking.rejectionReason || booking.rejectReason || '').trim(); %>
<% const refundRuleText = (booking.refundRuleReason || booking.refundPolicyNote || '').trim(); %>

<main class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden">
        <div class="bg-[#0B1F3A] text-white p-8 text-center space-y-3">
            <div class="w-16 h-16 rounded-full <%= (isCancelled || isRejected) ? 'bg-rose-500/20 border-rose-400 text-rose-300' : (isPendingApproval ? 'bg-amber-500/20 border-amber-400 text-amber-300' : 'bg-emerald-500/20 border-emerald-400 text-emerald-300') %> border flex items-center justify-center mx-auto text-2xl">
                <i class="fa-solid <%= (isCancelled || isRejected) ? 'fa-ban' : (isPendingApproval ? 'fa-hourglass-half' : 'fa-check') %>"></i>
            </div>
            <span class="inline-block bg-white/10 text-sky-200 text-xs font-bold px-3.5 py-1 rounded-full">
                <%= confIsEn ? 'Status:' : 'Durum:' %> <%= statusDisplay %>
            </span>
            <h1 class="text-2xl md:text-3xl font-extrabold">
                <% if (isCancelled) { %>
                    <%= confIsEn ? 'Booking Cancelled' : 'Rezervasyon İptal Edildi' %>
                <% } else if (isRejected) { %>
                    <%= confIsEn ? 'Booking Rejected' : 'Rezervasyon Reddedildi' %>
                <% } else if (isApproved) { %>
                    <%= confIsEn ? 'Your Booking Is Approved!' : 'Rezervasyonunuz Onaylandı!' %>
                <% } else { %>
                    <%= confIsEn ? 'Request Received — Awaiting Admin Approval' : 'Talep Alındı — Admin Onayı Bekleniyor' %>
                <% } %>
            </h1>
            <p class="text-slate-300 text-sm">
                <% if (isCancelled) { %>
                    <%= confIsEn
                        ? 'Your booking has been cancelled. Refund calculation and details are shown below.'
                        : 'Rezervasyonunuz iptal edildi. İade hesaplaması ve detaylar aşağıda yer almaktadır.' %>
                <% } else if (isRejected) { %>
                    <%= confIsEn
                        ? 'Your booking request could not be approved. Please review the reason below.'
                        : 'Rezervasyon talebiniz onaylanamadı. Lütfen aşağıdaki red sebebini inceleyin.' %>
                <% } else if (isApproved) { %>
                    <%= confIsEn
                        ? 'Your booking has been approved by our team. Assigned captain, transfer contact, and boarding details are included below.'
                        : 'Rezervasyonunuz ekibimiz tarafından onaylandı. Atanan kaptan, transfer iletişim numarası ve biniş detayları aşağıdadır.' %>
                <% } else { %>
                    <%= confIsEn
                        ? 'Your booking is pending admin approval. Captain assignment, transfer phone, and final boarding details will be shared once approved.'
                        : 'Rezervasyonunuz admin onayı için beklemede tutulmaktadır. Onaylandıktan sonra kaptan, transfer numarası ve biniş detayları paylaşılacaktır.' %>
                <% } %>
            </p>

            <div class="pt-2 flex items-center justify-center space-x-2">
                <span id="pnrCodeText" class="bg-white text-[#0B1F3A] font-mono font-extrabold text-lg px-4 py-1.5 rounded-xl tracking-wider"><%= booking.id %></span>
                <button type="button" id="copyPnrBtn" class="no-print bg-white/15 hover:bg-white/25 text-white px-3.5 py-2 rounded-xl text-xs font-bold transition">
                    <i class="fa-regular fa-copy mr-1"></i><%= confIsEn ? 'Copy' : 'Kopyala' %>
                </button>
            </div>
        </div>

        <div class="p-6 md:p-8 space-y-6">
            <% if (isRejected) { %>
                <div class="bg-rose-50 border border-rose-200 rounded-2xl p-4 text-xs text-rose-900 space-y-1">
                    <div class="font-extrabold text-sm text-rose-800">
                        <%= confIsEn ? 'Reason for Rejection' : 'Red Sebebi' %>
                    </div>
                    <p><%= rejectionReasonText || (confIsEn ? 'Weather conditions or operational unavailability.' : 'Hava koşulları veya operasyonel uygunsuzluk.') %></p>
                    <% if (refundRuleText || bRefunded > 0) { %>
                        <p class="font-semibold pt-1">
                            <%= confIsEn ? 'Refunded Amount:' : 'İade Edilen Tutar:' %> €<%= bRefunded.toLocaleString() %>
                            <% if (refundRuleText) { %> — <%= refundRuleText %><% } %>
                        </p>
                    <% } %>
                </div>
            <% } %>

            <% if (isApproved) { %>
                <div class="bg-emerald-50/80 border border-emerald-200 rounded-2xl p-5 space-y-3 text-xs text-slate-800">
                    <div class="font-extrabold text-sm text-emerald-900">
                        <%= confIsEn ? 'Captain, Transfer & Boarding Details' : 'Kaptan, Transfer ve Biniş Bilgileri' %>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="bg-white/90 border border-emerald-200/80 rounded-xl p-3">
                            <span class="text-[11px] font-bold uppercase text-slate-400 block"><%= confIsEn ? 'Captain' : 'Kaptan' %></span>
                            <strong class="text-sm text-slate-900 block mt-0.5"><%= captainName || (confIsEn ? 'Assigned Captain' : 'Atanan Kaptan') %></strong>
                            <% if (captainPhone) { %>
                                <span class="text-emerald-800 font-semibold block mt-0.5"><i class="fa-solid fa-phone mr-1"></i><%= captainPhone %></span>
                            <% } %>
                        </div>
                        <div class="bg-white/90 border border-emerald-200/80 rounded-xl p-3">
                            <span class="text-[11px] font-bold uppercase text-slate-400 block"><%= confIsEn ? 'Transfer Contact' : 'Transfer İletişim' %></span>
                            <strong class="text-sm text-slate-900 block mt-0.5"><%= transferPhone || (confIsEn ? 'Shared by Operations' : 'Operasyon Tarafından Paylaşılır') %></strong>
                            <% if (transferDriver) { %>
                                <span class="text-slate-600 block mt-0.5"><%= confIsEn ? 'Driver / Contact:' : 'Sürücü / İletişim:' %> <%= transferDriver %></span>
                            <% } %>
                        </div>
                    </div>
                    <% if (boardingInfo) { %>
                        <div class="bg-white/90 border border-emerald-200/80 rounded-xl p-3">
                            <span class="text-[11px] font-bold uppercase text-slate-400 block"><%= confIsEn ? 'Boarding & Marina Notes' : 'Biniş ve Marina Notları' %></span>
                            <span class="text-slate-800 font-medium block mt-0.5"><%= boardingInfo %></span>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <% if (isCancelled) { %>
                <% const confRefundReason = refundRuleText || (bRefunded > 0
                    ? (confIsEn ? 'Refund applied per cancellation policy.' : 'İptal kuralına göre iade uygulandı.')
                    : (confIsEn ? 'No refund due under cancellation policy.' : 'İptal kuralına göre iade uygulanmadı.')); %>
                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-xs text-slate-800 space-y-1">
                    <div class="font-extrabold text-sm text-rose-700">
                        <%= confIsEn ? 'Cancellation & Refund Summary' : 'İptal ve İade Özeti' %>
                    </div>
                    <div>
                        <strong><%= confIsEn ? 'Refunded Amount:' : 'İade Edilen Tutar:' %></strong> €<%= bRefunded.toLocaleString() %>
                    </div>
                    <% if (booking.cancelReason) { %>
                        <p class="text-slate-600">
                            <strong><%= confIsEn ? 'Cancellation Reason:' : 'İptal Sebebi:' %></strong> <%= booking.cancelReason %>
                        </p>
                    <% } %>
                    <p class="text-slate-600">
                        <strong><%= confIsEn ? 'Refund Details:' : 'İade Detayı:' %></strong> <%= confRefundReason %>
                    </p>
                </div>
            <% } %>

            <div class="flex flex-col sm:flex-row items-center gap-4 bg-slate-50 p-4 rounded-2xl border border-slate-100">
                <img id="confYachtImg" src="<%= confImgSrc %>" alt="<%= booking.yacht %>" class="w-full sm:w-32 h-24 object-cover rounded-xl">
                <div class="flex-1 text-center sm:text-left">
                    <div class="text-xs font-bold text-teal-700 uppercase"><%= charterDisplay %></div>
                    <h2 class="text-xl font-extrabold text-slate-900"><%= booking.yacht %></h2>
                    <p class="text-xs text-slate-500">
                        <%= (yacht && yacht.location) ? (yacht.location + ' Marina • ') : '' %><%= (yacht && yacht.length) ? (yacht.length + ' • ') : '' %><%= guestsCount %> <%= confIsEn ? (guestsCount === 1 ? 'Guest' : 'Guests') : 'Misafir' %>
                    </p>
                </div>
            </div>

            <% if (booking.packageName) { %>
                <div class="text-xs bg-teal-50/80 border border-teal-200 p-3.5 rounded-xl text-teal-900 font-bold">
                    <%= confIsEn ? 'Package:' : 'Paket:' %> <%= booking.packageName %>
                </div>
            <% } %>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div class="bg-slate-50 p-4 rounded-xl">
                    <span class="text-slate-400 block"><%= confIsEn ? 'Check-in — Check-out Date' : 'Giriş — Çıkış Tarihi' %></span>
                    <strong class="text-sm text-slate-900">
                        <%= booking.checkIn %> → <%= booking.checkOut %> (<%= daysCount %> <%= confIsEn ? (daysCount === 1 ? 'Day' : 'Days') : 'Gün' %>)
                        <% if (booking.tourTimeSlot) { %> • <%= booking.tourTimeSlot %><% } %>
                    </strong>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl">
                    <span class="text-slate-400 block"><%= confIsEn ? 'Guest Details' : 'Misafir Bilgileri' %></span>
                    <strong class="text-sm text-slate-900"><%= booking.customer %></strong>
                    <span class="text-slate-500 block mt-0.5"><%= booking.email || '' %> <%= booking.phone ? ('• ' + booking.phone) : '' %></span>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl">
                    <span class="text-slate-400 block"><%= confIsEn ? 'Payment Plan & Method' : 'Ödeme Planı & Yöntemi' %></span>
                    <strong class="text-sm text-slate-900"><%= payTypeDisplay %> • <%= payMethodDisplay %></strong>
                </div>
                <div class="bg-sky-50 p-4 rounded-xl border border-sky-100 space-y-0.5">
                    <span class="text-sky-700 block font-semibold"><%= confIsEn ? 'Payment & Balance Summary' : 'Ödeme & Bakiye Özeti' %></span>
                    <strong class="text-sm text-[#0B1F3A] block">
                        <%= confIsEn ? 'Total Amount:' : 'Toplam Tutar:' %> €<%= bTotal.toLocaleString() %>
                    </strong>
                    <% if (isCancelled || isRejected) { %>
                        <span class="text-[11px] font-bold text-rose-700 block">
                            <%= confIsEn ? 'Refunded Amount:' : 'İade Edilen Tutar:' %> €<%= bRefunded.toLocaleString() %>
                        </span>
                    <% } else { %>
                        <span class="text-[11px] font-semibold text-emerald-700 block">
                            <%= confIsEn
                                ? ('Paid: €' + bPaid.toLocaleString() + ' • Remaining: €' + remainingBal.toLocaleString())
                                : ('Ödenen: €' + bPaid.toLocaleString() + ' • Kalan: €' + remainingBal.toLocaleString()) %>
                        </span>
                    <% } %>
                </div>
            </div>

            <% if (booking.extras && booking.extras.length > 0) { %>
                <div class="text-xs bg-slate-50 p-4 rounded-xl">
                    <span class="text-slate-400 font-bold uppercase block mb-1.5">
                        <%= confIsEn ? 'Selected Extra VIP Services' : 'Seçilen Ekstra VIP Hizmetler' %>
                    </span>
                    <div class="flex flex-wrap gap-2">
                        <% for (let i = 0; i < booking.extras.length; i++) { %>
                            <% const exName = confIsEn ? (extrasTrToEn[booking.extras[i]] || booking.extras[i]) : booking.extras[i]; %>
                            <span class="bg-white border border-slate-200 px-3 py-1 rounded-lg font-semibold text-slate-700">✓ <%= exName %></span>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <% if (booking.notes) { %>
                <div class="text-xs bg-amber-50/70 border border-amber-200 p-4 rounded-xl text-amber-900">
                    <strong><%= confIsEn ? 'Guest Note:' : 'Misafir Notu:' %></strong> <%= booking.notes %>
                </div>
            <% } %>

            <div class="no-print flex flex-wrap justify-between items-center gap-3 pt-4 border-t border-slate-100">
                <div class="flex flex-wrap gap-2">
                    <a href="/" class="px-4 py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-xl text-xs font-bold transition">
                        <%= confIsEn ? '← Home' : '← Ana Sayfa' %>
                    </a>
                    <a href="/my-booking?pnr=<%= encodeURIComponent(booking.id) %>" class="px-4 py-3 bg-slate-100 hover:bg-slate-200 text-[#0B1F3A] rounded-xl text-xs font-bold transition">
                        <%= confIsEn ? 'Manage Booking' : 'Rezervasyonu Yönet' %>
                    </a>
                </div>

                <div class="flex flex-wrap gap-2.5">
                    <a id="waVoucherBtn"
                       href="#"
                       target="_blank"
                       rel="noopener noreferrer"
                       data-wa-num="<%= cleanWaNum %>"
                       data-wa-brand="<%= cSite.brandName || 'YachtVoyage' %>"
                       data-wa-status="<%= statusDisplay %>"
                       data-wa-yacht="<%= booking.yacht || '' %>"
                       data-wa-checkin="<%= booking.checkIn || '' %>"
                       data-wa-checkout="<%= booking.checkOut || '' %>"
                       class="px-4 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition">
                        <i class="fa-brands fa-whatsapp mr-1.5"></i><%= confIsEn ? 'Send via WhatsApp' : "WhatsApp'a Gönder" %>
                    </a>
                    <button type="button" id="printVoucherBtn" class="px-5 py-3 bg-[#0B1F3A] hover:bg-sky-900 text-white rounded-xl text-xs font-bold transition">
                        <i class="fa-solid fa-print mr-1.5"></i><%= confIsEn ? 'Print / Save PDF Voucher' : 'Voucher Yazdır / PDF' %>
                    </button>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    const isEnConf = document.documentElement.dataset.yvEn === '1';
    const pnrEl = document.getElementById('pnrCodeText');
    const pnrText = pnrEl ? pnrEl.innerText.trim() : '';

    const confImgEl = document.getElementById('confYachtImg');
    if (confImgEl) {
        confImgEl.addEventListener('error', function() {
            if (typeof fallbackYachtImg === 'function') {
                fallbackYachtImg(this);
            } else if (!this.dataset.fallbackApplied) {
                this.dataset.fallbackApplied = '1';
                this.src = 'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=1000&q=80';
            }
        });
    }

    const copyBtn = document.getElementById('copyPnrBtn');
    if (copyBtn && pnrText) {
        copyBtn.addEventListener('click', function() {
            const btn = this;
            const origHtml = btn.innerHTML;
            const markCopied = function() {
                btn.innerHTML = '<i class="fa-solid fa-check mr-1"></i>' + (isEnConf ? 'Copied' : 'Kopyalandı');
                setTimeout(function() { btn.innerHTML = origHtml; }, 2000);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(pnrText).then(markCopied).catch(function() {
                    const ta = document.createElement('textarea');
                    ta.value = pnrText;
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                    markCopied();
                });
            } else {
                const ta = document.createElement('textarea');
                ta.value = pnrText;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                markCopied();
            }
        });
    }

    const printBtn = document.getElementById('printVoucherBtn');
    if (printBtn) {
        printBtn.addEventListener('click', function() {
            window.print();
        });
    }

    const waBtn = document.getElementById('waVoucherBtn');
    if (waBtn) {
        const waNum = waBtn.dataset.waNum || '902521234567';
        const waBrand = waBtn.dataset.waBrand || 'YachtVoyage';
        const waStatus = waBtn.dataset.waStatus || '';
        const waYacht = waBtn.dataset.waYacht || '';
        const waCheckIn = waBtn.dataset.waCheckin || '';
        const waCheckOut = waBtn.dataset.waCheckout || '';
        const waMsg = isEnConf
            ? (waBrand + ' Booking (' + waStatus + ') — PNR: ' + pnrText + ' | Yacht: ' + waYacht + ' | Dates: ' + waCheckIn + ' - ' + waCheckOut)
            : (waBrand + ' Rezervasyon (' + waStatus + ') — PNR: ' + pnrText + ' | Yat: ' + waYacht + ' | Tarih: ' + waCheckIn + ' - ' + waCheckOut);
        waBtn.href = 'https://wa.me/' + encodeURIComponent(waNum) + '?text=' + encodeURIComponent(waMsg);
    }
</script>

<%- include('../partials/footer') %>