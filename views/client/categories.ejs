<%- include('../partials/header') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    <div class="border-b border-slate-200 pb-5">
        <span class="text-xs font-extrabold uppercase tracking-wider text-teal-600">Filo Tipleri</span>
        <h1 class="text-3xl md:text-4xl font-extrabold text-[#0B1F3A] mt-1">Yat Kategorilerimiz</h1>
    </div>

    <% const catImgMap = {
        'Motor Yachts': 'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=600&q=80',
        'Gulets': 'https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=600&q=80',
        'Sailing Yachts': 'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=600&q=80',
        'Catamarans': 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=600&q=80',
        'Superyachts': 'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=600&q=80'
    }; %>
    <% const listCats = (typeof categories !== 'undefined' && Array.isArray(categories)) ? categories : []; %>

    <% if (listCats.length === 0) { %>
        <div class="bg-white p-10 rounded-2xl border border-slate-200 text-center space-y-2">
            <p class="text-sm font-bold text-slate-700">Henüz kategori tanımlanmamış.</p>
            <p class="text-xs text-slate-500">Admin paneldeki <strong>Turlar &amp; Kategoriler</strong> bölümünden yeni kategori ekleyebilirsiniz.</p>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <% listCats.forEach(cat => { %>
                <% const catTitle = cat.nameTr || cat.title || cat.key; %>
                <% const catImg = cat.img || catImgMap[cat.key] || catImgMap['Motor Yachts']; %>
                <a href="/yachts?category=<%= encodeURIComponent(cat.key) %>" class="group bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition flex flex-col justify-between">
                    <div>
                        <div class="h-44 overflow-hidden">
                            <img src="<%= catImg %>" onerror="fallbackYachtImg(this)" alt="<%= catTitle %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                        </div>
                        <div class="p-5 space-y-1.5">
                            <h2 class="font-extrabold text-slate-900 text-base"><%= catTitle %></h2>
                            <p class="text-xs text-slate-500 leading-relaxed"><%= cat.desc || 'Özel yat kategorisi' %></p>
                        </div>
                    </div>
                    <div class="px-5 py-3.5 bg-slate-50 border-t border-slate-100 text-xs font-bold text-teal-700">
                        Bu Kategorideki Yatları Gör →
                    </div>
                </a>
            <% }) %>
        </div>
    <% } %>
</main>

<%- include('../partials/footer') %>