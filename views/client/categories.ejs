<%- include('../partials/header') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    <div class="border-b border-slate-200 pb-5">
        <span class="text-xs font-extrabold uppercase tracking-wider text-teal-600">Filo Tipleri</span>
        <h1 class="text-3xl md:text-4xl font-extrabold text-[#0B1F3A] mt-1">Yat Kategorilerimiz</h1>
    </div>

    <% const categories = [
        { key: 'Motor Yachts', title: 'Motor Yatlar', desc: 'Yüksek seyir hızı, modern salon ve geniş güneşlenme güvertesi.', img: 'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=600&q=80' },
        { key: 'Gulets', title: 'Guletler', desc: 'Geleneksel ahşap zarafet, geniş kabinler ve kalabalık gruplar için ideal yapı.', img: 'https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=600&q=80' },
        { key: 'Sailing Yachts', title: 'Yelkenli Yatlar', desc: 'Rüzgârla uyumlu, sportif ve keyifli koy keşifleri için tasarlanmış tekneler.', img: 'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=600&q=80' },
        { key: 'Catamarans', title: 'Katamaranlar', desc: 'Çift gövdeli ekstra denge, ferah yaşam alanı ve aile dostu konfor.', img: 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=600&q=80' },
        { key: 'Superyachts', title: 'Süperyatlar', desc: 'Özel mürettebat, üst düzey lüks donanım ve VIP deniz deneyimi.', img: 'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=600&q=80' }
    ]; %>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% categories.forEach(cat => { %>
            <a href="/yachts?category=<%= encodeURIComponent(cat.key) %>" class="group bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition flex flex-col justify-between">
                <div>
                    <div class="h-44 overflow-hidden">
                        <img src="<%= cat.img %>" onerror="fallbackYachtImg(this)" alt="<%= cat.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                    </div>
                    <div class="p-5 space-y-1.5">
                        <h2 class="font-extrabold text-slate-900 text-base"><%= cat.title %></h2>
                        <p class="text-xs text-slate-500 leading-relaxed"><%= cat.desc %></p>
                    </div>
                </div>
                <div class="px-5 py-3.5 bg-slate-50 border-t border-slate-100 text-xs font-bold text-teal-700">
                    Bu Kategorideki Yatları Gör →
                </div>
            </a>
        <% }) %>
    </div>
</main>

<%- include('../partials/footer') %>