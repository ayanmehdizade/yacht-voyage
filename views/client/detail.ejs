<%- include('../partials/header') %>

<% const ydIsEn = (typeof isEn !== 'undefined') ? Boolean(isEn) : (typeof lang !== 'undefined' && lang === 'en'); %>
<% const dSite = (typeof siteSettings !== 'undefined' && siteSettings) ? siteSettings : {
    brandName: 'YachtVoyage',
    whatsappNumber: '902521234567'
}; %>
<% const cleanWaNum = String(dSite.whatsappNumber || '902521234567').replace(/\D/g, '') || '902521234567'; %>
<% const planCfg = (typeof paymentPlanSettings !== 'undefined' && paymentPlanSettings) ? paymentPlanSettings : {
    installmentPercent: 50,
    installmentInterestPercent: 0,
    fullPaymentDiscountPercent: 10
}; %>
<% const extrasTrToEn = {
    'VIP Havalimanı Transferi': 'VIP Airport Transfer',
    'Özel Şef & Gurme Menü': 'Private Chef & Gourmet Menu',
    'Jet Ski & Seabob Paketi': 'Jet Ski & Seabob Package',
    'Seabob & Su Sporları Paketi': 'Seabob & Water Sports Package'
}; %>
<% const activeExtras = (typeof extrasList !== 'undefined' && Array.isArray(extrasList) && extrasList.length) ? extrasList : [
    { name: 'VIP Havalimanı Transferi', nameEn: 'VIP Airport Transfer', pricePerGuest: 45 },
    { name: 'Özel Şef & Gurme Menü', nameEn: 'Private Chef & Gourmet Menu', pricePerGuest: 120 },
    { name: 'Seabob & Su Sporları Paketi', nameEn: 'Seabob & Water Sports Package', pricePerGuest: 85 }
]; %>
<% const catSingularEn = {
    'Motor Yachts': 'Motor Yacht',
    'Gulets': 'Gulet',
    'Sailing Yachts': 'Sailing Yacht',
    'Catamarans': 'Catamaran',
    'Superyachts': 'Superyacht'
}; %>
<% const yCatLabel = ydIsEn
    ? (catSingularEn[yacht.category] || catSingularEn[yacht.categoryEn] || yacht.categoryEn || yacht.category || yacht.categoryTr)
    : (yacht.categoryTr || yacht.category); %>
<% const yDesc = (ydIsEn && yacht.descriptionEn) ? yacht.descriptionEn : yacht.description; %>
<% const yFeatures = (ydIsEn && Array.isArray(yacht.featuresEn) && yacht.featuresEn.length) ? yacht.featuresEn : (yacht.features || []); %>
<% const yInclusions = (ydIsEn && Array.isArray(yacht.inclusionsEn) && yacht.inclusionsEn.length) ? yacht.inclusionsEn : (yacht.inclusions || []); %>
<% const yItinerary = (ydIsEn && Array.isArray(yacht.itineraryEn) && yacht.itineraryEn.length) ? yacht.itineraryEn : (yacht.itinerary || []); %>
<% const yImages = (Array.isArray(yacht.images) && yacht.images.length) ? yacht.images : ['https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=1000&q=80']; %>
<% const nowLocal = new Date(); %>
<% const todayLocalYmd = nowLocal.getFullYear() + '-' + String(nowLocal.getMonth() + 1).padStart(2, '0') + '-' + String(nowLocal.getDate()).padStart(2, '0'); %>
<% const upcomingBookings = (yachtBookings || []).filter(b => b.checkOut >= todayLocalYmd); %>
<% const defaultGuests = Math.min(Number(yacht.guests) || 12, 6); %>

<div id="detailBookedDates" class="hidden">
    <% upcomingBookings.forEach(function(b) { %>
        <span class="booked-range" data-in="<%= b.checkIn %>" data-out="<%= b.checkOut %>"></span>
    <% }) %>
</div>

<main id="yachtDetailRoot"
      data-yacht-id="<%= yacht.id %>"
      data-daily-rate="<%= yacht.price %>"
      data-max-guests="<%= yacht.guests %>"
      data-installment-pct="<%= planCfg.installmentPercent %>"
      data-interest-pct="<%= planCfg.installmentInterestPercent %>"
      data-yacht-title="<%= yacht.name %> (<%= yacht.location %>)"
      data-wa-num="<%= cleanWaNum %>"
      data-brand-name="<%= dSite.brandName || 'YachtVoyage' %>"
      data-total-photos="<%= yImages.length %>"
      class="max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8">

    <% if (reviewSaved) { %>
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-3.5 rounded-2xl text-sm font-semibold">
            <i class="fa-solid fa-circle-check mr-2"></i>
            <%= ydIsEn ? 'Thank you! Your review has been published.' : 'Teşekkürler! Değerlendirmeniz başarıyla yayınlandı.' %>
        </div>
    <% } %>

    <div class="space-y-3">
        <div class="relative rounded-2xl overflow-hidden h-[320px] md:h-[450px] bg-slate-200">
            <img id="mainPhoto" src="<%= yImages[0] %>" alt="<%= yacht.name %>" class="detail-img w-full h-full object-cover">
            <span id="photoCounterBadge" data-no-auto-translate="true" class="absolute bottom-4 left-4 bg-[#0B1F3A]/85 text-white text-xs font-bold px-3 py-1.5 rounded-lg">
                1 / <%= yImages.length %> <%= ydIsEn ? 'Photos' : 'Fotoğraf' %>
            </span>
        </div>
        <div class="grid grid-cols-4 gap-3">
            <% for (let i = 0; i < yImages.length; i++) { %>
                <button type="button"
                        data-img-src="<%= yImages[i] %>"
                        data-img-idx="<%= i + 1 %>"
                        class="thumb-btn rounded-xl overflow-hidden h-20 md:h-24 border-2 <%= i === 0 ? 'border-[#0B1F3A]' : 'border-transparent' %> hover:border-[#0B1F3A] transition">
                    <img src="<%= yImages[i] %>" alt="<%= yacht.name %>" class="detail-img w-full h-full object-cover">
                </button>
            <% } %>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2 space-y-6">
            <div class="border-b border-slate-200 pb-5 flex flex-wrap justify-between items-start gap-4">
                <div>
                    <div class="flex items-center space-x-2.5">
                        <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900"><%= yacht.name %></h1>
                        <span class="bg-[#0B1F3A] text-white text-xs font-extrabold px-2.5 py-1 rounded-lg"><%= Number(yacht.rating || 5).toFixed(1) %> / 5</span>
                    </div>
                    <p class="text-xs text-slate-500 mt-1"><%= yCatLabel %> • <%= yacht.length %> • <%= yacht.year %> • <%= yacht.location %> Marina</p>
                </div>
                <div class="flex flex-wrap gap-2 text-xs">
                    <span class="bg-emerald-50 text-emerald-700 font-bold px-3 py-1.5 rounded-lg">
                        <%= ydIsEn ? '✓ Free Cancellation Up to 7 Days Prior' : '✓ 7 Gün Öncesine Kadar Ücretsiz İptal' %>
                    </span>
                    <span class="bg-sky-50 text-sky-700 font-bold px-3 py-1.5 rounded-lg">
                        <%= ydIsEn ? ('✓ ' + planCfg.installmentPercent + '% Down Payment') : ('✓ %' + planCfg.installmentPercent + ' Ön Ödeme') %>
                    </span>
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div class="bg-white p-4 rounded-xl border border-slate-200 text-center">
                    <i class="fa-solid fa-users text-[#0B1F3A] mb-1"></i>
                    <div class="font-bold text-sm"><%= yacht.guests %> <%= ydIsEn ? (Number(yacht.guests) === 1 ? 'Guest' : 'Guests') : 'Misafir' %></div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 text-center">
                    <i class="fa-solid fa-bed text-[#0B1F3A] mb-1"></i>
                    <div class="font-bold text-sm"><%= yacht.cabins %> <%= ydIsEn ? (Number(yacht.cabins) === 1 ? 'Cabin' : 'Cabins') : 'Kabin' %></div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 text-center">
                    <i class="fa-solid fa-user-tie text-[#0B1F3A] mb-1"></i>
                    <div class="font-bold text-sm"><%= yacht.crew %> <%= ydIsEn ? (Number(yacht.crew) === 1 ? 'Crew Member' : 'Crew Members') : 'Mürettebat' %></div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 text-center">
                    <i class="fa-solid fa-gauge-high text-[#0B1F3A] mb-1"></i>
                    <div class="font-bold text-sm"><%= yacht.speed %></div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 bg-slate-50 border border-slate-200 rounded-2xl p-4 text-xs">
                <div class="flex items-start space-x-2.5">
                    <i class="fa-solid fa-shield-halved text-teal-600 mt-0.5"></i>
                    <div>
                        <strong class="text-slate-900 block"><%= ydIsEn ? 'Private Yacht Exclusively for Your Group' : 'Sadece Grubunuza Özel Tekne' %></strong>
                        <span class="text-slate-500">
                            <%= ydIsEn
                                ? ('Private charter; full yacht capacity (' + yacht.guests + ' guests) is reserved for you.')
                                : ('Paylaşımsız kiralama; tüm tekne kapasitesi (' + yacht.guests + ' kişi) size ayrılır.') %>
                        </span>
                    </div>
                </div>
                <div class="flex items-start space-x-2.5">
                    <i class="fa-solid fa-gas-pump text-teal-600 mt-0.5"></i>
                    <div>
                        <strong class="text-slate-900 block"><%= ydIsEn ? 'Captain, Crew & Route Fuel Included' : 'Kaptan, Mürettebat & Rota Yakıtı Dahil' %></strong>
                        <span class="text-slate-500">
                            <%= ydIsEn
                                ? 'Standard cove route fuel and port clearance fees are included.'
                                : 'Standart koy rotası yakıtı ve liman çıkış işlemleri fiyata dahildir.' %>
                        </span>
                    </div>
                </div>
                <div class="flex items-start space-x-2.5">
                    <i class="fa-solid fa-utensils text-teal-600 mt-0.5"></i>
                    <div>
                        <strong class="text-slate-900 block"><%= ydIsEn ? 'Dining & Refreshments Info' : 'Yemek & İkram Bilgisi' %></strong>
                        <span class="text-slate-500">
                            <%= ydIsEn
                                ? 'Welcome refreshments included; custom gourmet menu can be selected as an extra.'
                                : 'Hoş geldiniz ikramları dahildir; özel gurme menü ekstra olarak seçilebilir.' %>
                        </span>
                    </div>
                </div>
                <div class="flex items-start space-x-2.5">
                    <i class="fa-solid fa-cloud-sun-rain text-teal-600 mt-0.5"></i>
                    <div>
                        <strong class="text-slate-900 block"><%= ydIsEn ? 'Bad Weather Guarantee' : 'Olumsuz Hava Garantisi' %></strong>
                        <span class="text-slate-500">
                            <%= ydIsEn
                                ? 'Free date change or 100% refund is provided in case of navigation restrictions.'
                                : 'Seyir engeli durumunda ücretsiz tarih değişikliği veya %100 iade sağlanır.' %>
                        </span>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-4">
                <div class="flex flex-wrap gap-5 border-b border-slate-100 pb-3 text-xs sm:text-sm font-bold">
                    <button type="button" data-tab="desc" id="tab-desc" class="tab-btn text-[#0B1F3A] border-b-2 border-[#0B1F3A] pb-3 -mb-3.5"><%= ydIsEn ? 'Overview' : 'Açıklama' %></button>
                    <button type="button" data-tab="specs" id="tab-specs" class="tab-btn text-slate-400 hover:text-slate-700 pb-3 -mb-3.5"><%= ydIsEn ? 'Specifications' : 'Teknik Özellikler' %></button>
                    <button type="button" data-tab="inc" id="tab-inc" class="tab-btn text-slate-400 hover:text-slate-700 pb-3 -mb-3.5"><%= ydIsEn ? "What's Included" : 'Dahil Olanlar' %></button>
                    <button type="button" data-tab="avail" id="tab-avail" class="tab-btn text-slate-400 hover:text-slate-700 pb-3 -mb-3.5"><%= ydIsEn ? 'Availability' : 'Müsaitlik' %></button>
                    <button type="button" data-tab="loc" id="tab-loc" class="tab-btn text-slate-400 hover:text-slate-700 pb-3 -mb-3.5"><%= ydIsEn ? 'Location & Meeting' : 'Konum & Buluşma' %></button>
                </div>

                <div id="content-desc" class="text-sm text-slate-600 leading-relaxed space-y-3 pt-2">
                    <p><%= yDesc %></p>
                    <div class="grid grid-cols-2 gap-2 pt-2 text-xs font-medium text-slate-800">
                        <% for (let i = 0; i < yFeatures.length; i++) { %>
                            <div><i class="fa-solid fa-check text-emerald-600 mr-1.5"></i><%= yFeatures[i] %></div>
                        <% } %>
                    </div>
                </div>

                <div id="content-specs" class="hidden text-sm text-slate-700 pt-2">
                    <div class="grid grid-cols-2 gap-3 text-xs">
                        <div class="bg-slate-50 p-3 rounded-lg"><strong><%= ydIsEn ? 'Length:' : 'Uzunluk:' %></strong> <%= yacht.length %></div>
                        <div class="bg-slate-50 p-3 rounded-lg"><strong><%= ydIsEn ? 'Year:' : 'Model Yılı:' %></strong> <%= yacht.year %></div>
                        <div class="bg-slate-50 p-3 rounded-lg"><strong><%= ydIsEn ? 'Cabins:' : 'Kabin Sayısı:' %></strong> <%= yacht.cabins %></div>
                        <div class="bg-slate-50 p-3 rounded-lg"><strong><%= ydIsEn ? 'Cruising Speed:' : 'Seyir Hızı:' %></strong> <%= yacht.speed %></div>
                    </div>
                </div>

                <div id="content-inc" class="hidden text-sm text-slate-600 space-y-2 pt-2">
                    <% for (let i = 0; i < yInclusions.length; i++) { %>
                        <div class="flex items-center space-x-2 text-xs">
                            <i class="fa-solid fa-circle-check text-teal-600"></i>
                            <span><%= yInclusions[i] %></span>
                        </div>
                    <% } %>
                </div>

                <div id="content-avail" class="hidden text-sm text-slate-600 pt-2 space-y-2">
                    <p class="text-xs">
                        <%= ydIsEn
                            ? 'Real-time availability is checked for future dates starting from today.'
                            : 'Bugünden itibaren ileri tarihler için anlık müsaitlik kontrolü yapılır.' %>
                    </p>
                    <% if (upcomingBookings.length > 0) { %>
                        <div class="text-xs text-amber-800 bg-amber-50 p-3 rounded-xl space-y-1">
                            <strong><%= ydIsEn ? 'Upcoming Booked Dates:' : 'Yaklaşan Dolu Tarihler:' %></strong>
                            <div class="flex flex-wrap gap-1.5 pt-1">
                                <% upcomingBookings.forEach(function(b) { %>
                                    <span class="px-2 py-0.5 rounded bg-white border border-amber-200 font-semibold"><%= b.checkIn %> → <%= b.checkOut %></span>
                                <% }) %>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="inline-block bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-lg">
                            <%= ydIsEn ? 'Available for Upcoming Dates' : 'İleri Tarihlerde Müsaitlik Açık' %>
                        </div>
                    <% } %>
                </div>

                <div id="content-loc" class="hidden text-sm text-slate-600 pt-2">
                    <div class="bg-slate-50 rounded-xl p-5 border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                        <div>
                            <div class="font-bold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-location-dot text-[#0B1F3A]"></i>
                                <span><%= yacht.location %> Marina — <%= ydIsEn ? 'Main Pier VIP Boarding Point' : 'Ana İskele VIP Biniş Noktası' %></span>
                            </div>
                            <p class="text-xs text-slate-500 mt-1">
                                <%= ydIsEn
                                    ? 'Our captain will greet your group at the marina entrance gate 15 minutes before departure.'
                                    : 'Kalkıştan 15 dakika önce kaptanımız marina giriş kapısında grubunuzu karşılar.' %>
                            </p>
                        </div>
                        <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(yacht.location + ' Marina') %>" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-xl bg-white border border-slate-300 hover:border-[#0B1F3A] text-xs font-bold text-[#0B1F3A] shrink-0">
                            <%= ydIsEn ? 'Open in Maps ↗' : 'Haritada Aç ↗' %>
                        </a>
                    </div>
                </div>
            </div>

            <% if (yItinerary.length > 0) { %>
                <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-4">
                    <h2 class="text-lg font-extrabold text-[#0B1F3A] flex items-center space-x-2">
                        <i class="fa-solid fa-route text-teal-600"></i>
                        <span><%= ydIsEn ? 'Sample Daily Tour Route & Schedule' : 'Örnek Günlük Tur Rotası & Saat Akışı' %></span>
                    </h2>
                    <div class="space-y-4 border-l-2 border-teal-100 ml-3 pl-5">
                        <% for (let i = 0; i < yItinerary.length; i++) { %>
                            <div class="relative">
                                <span class="w-3 h-3 rounded-full bg-teal-600 absolute -left-[27px] top-1.5 ring-4 ring-white"></span>
                                <div class="text-xs font-extrabold text-teal-700"><%= yItinerary[i].time %> — <span class="text-slate-900"><%= yItinerary[i].title %></span></div>
                                <p class="text-xs text-slate-500 mt-0.5"><%= yItinerary[i].desc %></p>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <div id="reviewsSection" class="bg-white rounded-2xl border border-slate-200 p-6 space-y-6">
                <div class="flex justify-between items-center border-b border-slate-100 pb-4">
                    <div>
                        <h2 class="text-lg font-extrabold text-[#0B1F3A]"><%= ydIsEn ? 'Guest Reviews' : 'Misafir Değerlendirmeleri' %></h2>
                        <p class="text-xs text-slate-500">
                            <%= ydIsEn ? 'Average Rating:' : 'Ortalama Puan:' %> <strong><%= Number(yacht.rating || 5).toFixed(1) %> / 5.0</strong> (<%= yacht.reviews %> <%= ydIsEn ? (Number(yacht.reviews) === 1 ? 'review' : 'reviews') : 'yorum' %>)
                        </p>
                    </div>
                    <span class="bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-full"><%= ydIsEn ? '✓ Verified Guests' : '✓ Doğrulanmış Misafirler' %></span>
                </div>

                <div class="space-y-4">
                    <% const rList = yacht.reviewList || []; %>
                    <% for (let i = 0; i < rList.length; i++) { %>
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 space-y-1.5">
                            <div class="flex justify-between items-center text-xs">
                                <strong class="text-slate-900"><%= rList[i].author %></strong>
                                <span class="text-amber-500 font-bold">★ <%= rList[i].rating %>.0 <span class="text-slate-400 font-normal ml-1"><%= rList[i].date %></span></span>
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed"><%= rList[i].comment %></p>
                        </div>
                    <% } %>
                </div>

                <form action="/yachts/<%= yacht.id %>/reviews" method="POST" class="pt-4 border-t border-slate-100 space-y-3">
                    <div class="text-xs font-bold text-slate-800 uppercase"><%= ydIsEn ? 'Share Your Experience' : 'Deneyiminizi Paylaşın' %></div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <input type="text" name="author" placeholder="<%= ydIsEn ? 'Your Full Name' : 'Adınız Soyadınız' %>" required class="p-2.5 text-xs border border-slate-200 rounded-xl">
                        <select name="rating" class="p-2.5 text-xs font-semibold border border-slate-200 rounded-xl bg-white">
                            <option value="5"><%= ydIsEn ? '★★★★★ (5 - Excellent)' : '★★★★★ (5 - Mükemmel)' %></option>
                            <option value="4"><%= ydIsEn ? '★★★★☆ (4 - Very Good)' : '★★★★☆ (4 - Çok İyi)' %></option>
                            <option value="3"><%= ydIsEn ? '★★★☆☆ (3 - Good)' : '★★★☆☆ (3 - İyi)' %></option>
                        </select>
                    </div>
                    <textarea name="comment" rows="2" placeholder="<%= ydIsEn ? 'Your review about the yacht, captain and route...' : 'Yat, kaptan ve rota hakkındaki yorumunuz...' %>" required class="w-full p-3 text-xs border border-slate-200 rounded-xl"></textarea>
                    <button type="submit" class="bg-[#0B1F3A] hover:bg-sky-900 text-white px-5 py-2.5 rounded-xl text-xs font-bold transition">
                        <%= ydIsEn ? 'Publish Review' : 'Yorumu Yayınla' %>
                    </button>
                </form>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xl h-fit sticky top-24 space-y-5">
            <div class="flex items-baseline justify-between">
                <div>
                    <span class="text-xs text-slate-400 block"><%= ydIsEn ? 'Daily Yacht Rate' : 'Tekne Günlük Fiyatı' %></span>
                    <span class="text-3xl font-extrabold text-[#0B1F3A]">€<%= Number(yacht.price || 0).toLocaleString() %></span>
                    <span class="text-xs text-slate-400"><%= ydIsEn ? '/ day' : '/ gün' %></span>
                </div>
                <span id="detailAvailStatus" data-no-auto-translate="true" class="text-[11px] font-bold px-2.5 py-1 rounded-full bg-amber-50 text-amber-800"><%= ydIsEn ? 'Select Dates' : 'Tarih Seçin' %></span>
            </div>

            <form id="detailBookingForm" action="/checkout" method="GET" class="space-y-4">
                <input type="hidden" name="yachtId" value="<%= yacht.id %>">
                <input type="hidden" id="detailExtrasCsvInput" name="extrasCsv" value="">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1"><%= ydIsEn ? 'CHECK-IN *' : 'Giriş *' %></label>
                        <input type="date" id="inDate" name="checkIn" min="<%= todayLocalYmd %>" value="<%= (checkIn && checkIn >= todayLocalYmd) ? checkIn : '' %>" required class="w-full p-2.5 text-xs font-semibold border border-slate-200 rounded-xl">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1"><%= ydIsEn ? 'CHECK-OUT *' : 'Çıkış *' %></label>
                        <input type="date" id="outDate" name="checkOut" min="<%= todayLocalYmd %>" value="<%= (checkOut && checkIn && checkOut > checkIn && checkIn >= todayLocalYmd) ? checkOut : '' %>" required class="w-full p-2.5 text-xs font-semibold border border-slate-200 rounded-xl">
                    </div>
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">
                        <%= ydIsEn ? ('GUESTS (MAX. ' + yacht.guests + ')') : ('Misafir Sayısı (Maks. ' + yacht.guests + ')') %>
                    </label>
                    <input type="number" id="guestNum" name="guests" min="1" max="<%= yacht.guests %>" value="<%= defaultGuests %>" class="w-full p-2.5 text-sm font-semibold border border-slate-200 rounded-xl">
                </div>

                <div class="space-y-2 pt-1">
                    <div class="flex items-center justify-between">
                        <label class="block text-[11px] font-bold text-slate-500 uppercase">
                            <%= ydIsEn ? 'EXTRA SERVICES (PER GUEST)' : 'Ekstra Hizmetler (Kişi Başı)' %>
                        </label>
                        <span class="text-[10px] font-bold text-teal-700">
                            <%= ydIsEn ? 'Transferred to checkout' : "Checkout'a aktarılır" %>
                        </span>
                    </div>
                    <% activeExtras.forEach(function(ex) { %>
                        <% const pGuest = Number(ex.pricePerGuest || 0); %>
                        <% const exLabel = ydIsEn ? (ex.nameEn || extrasTrToEn[ex.name] || ex.name) : ex.name; %>
                        <label class="flex items-center justify-between p-2.5 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 text-xs">
                            <span class="flex items-center space-x-2">
                                <input type="checkbox" name="extras" value="<%= ex.name %>" data-display-label="<%= exLabel %>" data-per-guest="<%= pGuest %>" class="detail-extra-cb rounded text-[#0B1F3A]">
                                <span>
                                    <span class="font-semibold text-slate-800 block"><%= exLabel %></span>
                                    <span class="text-[10px] text-slate-400">€<%= pGuest.toLocaleString() %> <%= ydIsEn ? '/ guest' : '/ kişi' %></span>
                                </span>
                            </span>
                            <span class="detail-extra-price font-bold text-[#0B1F3A]">+€<%= (pGuest * defaultGuests).toLocaleString() %></span>
                        </label>
                    <% }) %>
                </div>

                <div id="detailSummaryBox" data-no-auto-translate="true" class="bg-slate-50 p-4 rounded-xl space-y-1.5 text-xs">
                    <div class="flex justify-between text-slate-600">
                        <span><%= ydIsEn ? 'Yacht Charter' : 'Yat Kirası' %> (<span id="dayCount">0</span> <%= ydIsEn ? 'days' : 'gün' %>)</span>
                        <span id="baseRentTotal" class="font-semibold text-slate-800">€0</span>
                    </div>
                    <div class="flex justify-between text-slate-600">
                        <span><%= ydIsEn ? 'Extras' : 'Ekstralar' %> (<span id="detailGuestLabel"><%= defaultGuests %></span> <%= ydIsEn ? 'guests' : 'kişi' %>)</span>
                        <span id="detailExtrasTotal" class="font-semibold text-teal-700">+€0</span>
                    </div>
                    <div id="detailAutoDiscRow" class="hidden flex justify-between text-emerald-700 font-bold">
                        <span><%= ydIsEn ? '5+ Days Discount (5%)' : '5+ Gün İndirimi (%5)' %></span>
                        <span id="detailAutoDisc">-€0</span>
                    </div>
                    <div class="flex justify-between text-sm font-extrabold text-slate-900 pt-1.5 border-t border-slate-200">
                        <span><%= ydIsEn ? 'Total Amount' : 'Toplam Tutar' %></span>
                        <span id="grandTotal">€0</span>
                    </div>
                    <div class="flex justify-between text-sky-800 font-bold bg-sky-100/70 px-2.5 py-1.5 rounded-lg mt-1">
                        <span><%= ydIsEn ? ('Pay Now (' + planCfg.installmentPercent + '%)') : ('Şimdi Ödenecek (%' + planCfg.installmentPercent + ')') %></span>
                        <span id="detailPayNow">€0</span>
                    </div>
                    <div class="flex justify-between text-slate-400 text-[11px]">
                        <span><%= ydIsEn ? 'Remaining Balance at Marina' : 'Marinada Kalan Bakiye' %></span>
                        <span id="detailRemaining">€0</span>
                    </div>
                </div>

                <button type="submit" id="detailSubmitBtn" class="w-full bg-[#0B1F3A] hover:bg-sky-900 text-white py-3.5 rounded-xl font-bold text-sm transition shadow-lg">
                    <%= ydIsEn ? 'Continue to Booking →' : 'Rezervasyona Devam Et →' %>
                </button>
            </form>

            <a id="waLink" href="#" target="_blank" rel="noopener noreferrer" class="w-full bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 py-3 rounded-xl font-bold text-xs transition flex items-center justify-center space-x-2">
                <i class="fa-brands fa-whatsapp text-base text-emerald-600"></i>
                <span><%= ydIsEn ? 'Ask Availability on WhatsApp' : 'WhatsApp ile Müsaitlik Sor' %></span>
            </a>
        </div>
    </div>
</main>

<script>
    const isEnYd = document.documentElement.dataset.yvEn === '1';
    const root = document.getElementById('yachtDetailRoot');
    const yachtId = Number(root.dataset.yachtId);
    const dailyRate = Number(root.dataset.dailyRate);
    const maxGuests = Number(root.dataset.maxGuests) || 12;
    const installmentPct = Number(root.dataset.installmentPct) || 50;
    const interestPct = Number(root.dataset.interestPct) || 0;
    const yachtTitle = root.dataset.yachtTitle || '';
    const waNum = root.dataset.waNum || '902521234567';
    const brandName = root.dataset.brandName || 'YachtVoyage';
    const totalPhotos = Number(root.dataset.totalPhotos) || 1;

    function toYMD(dateObj) {
        const y = dateObj.getFullYear();
        const m = String(dateObj.getMonth() + 1).padStart(2, '0');
        const d = String(dateObj.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
    }

    function addDaysYMD(ymdStr, deltaDays) {
        const parts = ymdStr.split('-').map(Number);
        const dt = new Date(parts[0], (parts[1] || 1) - 1, (parts[2] || 1) + deltaDays);
        return toYMD(dt);
    }

    function diffDaysYMD(startYmd, endYmd) {
        const p1 = startYmd.split('-').map(Number);
        const p2 = endYmd.split('-').map(Number);
        const utc1 = Date.UTC(p1[0], (p1[1] || 1) - 1, p1[2] || 1);
        const utc2 = Date.UTC(p2[0], (p2[1] || 1) - 1, p2[2] || 1);
        return Math.round((utc2 - utc1) / 86400000);
    }

    const existingBookings = Array.from(document.querySelectorAll('.booked-range')).map(function(el) {
        return { checkIn: el.dataset.in, checkOut: el.dataset.out };
    });

    let recent = JSON.parse(localStorage.getItem('yv_recent') || '[]').filter(function(x) { return x !== yachtId; });
    recent.unshift(yachtId);
    localStorage.setItem('yv_recent', JSON.stringify(recent.slice(0, 4)));

    document.querySelectorAll('.detail-img').forEach(function(img) {
        img.addEventListener('error', function() {
            if (typeof fallbackYachtImg === 'function') {
                fallbackYachtImg(this);
            } else if (!this.dataset.fallbackApplied) {
                this.dataset.fallbackApplied = '1';
                this.src = 'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=1000&q=80';
            }
        });
    });

    const photoCounterBadge = document.getElementById('photoCounterBadge');
    document.querySelectorAll('.thumb-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const mp = document.getElementById('mainPhoto');
            delete mp.dataset.fallbackApplied;
            mp.src = this.dataset.imgSrc;

            const idx = this.dataset.imgIdx || '1';
            if (photoCounterBadge) {
                photoCounterBadge.textContent = idx + ' / ' + totalPhotos + ' ' + (isEnYd ? 'Photos' : 'Fotoğraf');
            }

            document.querySelectorAll('.thumb-btn').forEach(function(b) {
                b.classList.remove('border-[#0B1F3A]');
                b.classList.add('border-transparent');
            });
            this.classList.remove('border-transparent');
            this.classList.add('border-[#0B1F3A]');
        });
    });

    function calcPrice() {
        const inInput = document.getElementById('inDate');
        const outInput = document.getElementById('outDate');
        const guestInput = document.getElementById('guestNum');
        const statusBadge = document.getElementById('detailAvailStatus');
        const submitBtn = document.getElementById('detailSubmitBtn');
        const extrasCsvEl = document.getElementById('detailExtrasCsvInput');

        let guests = Math.max(1, Number(guestInput.value) || 1);
        if (guests > maxGuests) {
            guests = maxGuests;
            guestInput.value = maxGuests;
        }

        const inVal = inInput.value;
        if (inVal && /^\d{4}-\d{2}-\d{2}$/.test(inVal)) {
            outInput.min = addDaysYMD(inVal, 1);
            if (outInput.value && outInput.value <= inVal) {
                outInput.value = '';
            }
        }
        const outVal = outInput.value;

        let diff = 0;
        if (inVal && outVal && outVal > inVal) {
            diff = Math.max(0, diffDaysYMD(inVal, outVal));
        }

        const conflict = (inVal && outVal && outVal > inVal)
            ? existingBookings.find(b => inVal < b.checkOut && outVal > b.checkIn)
            : null;

        if (!inVal || !outVal || outVal <= inVal) {
            statusBadge.className = 'text-[11px] font-bold px-2.5 py-1 rounded-full bg-amber-50 text-amber-800';
            statusBadge.innerText = isEnYd ? 'Select Dates' : 'Tarih Seçin';
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        } else if (conflict) {
            statusBadge.className = 'text-[11px] font-bold px-2.5 py-1 rounded-full bg-rose-50 text-rose-700';
            statusBadge.innerText = isEnYd ? 'Booked Dates' : 'Dolu Tarih';
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        } else {
            statusBadge.className = 'text-[11px] font-bold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700';
            statusBadge.innerText = isEnYd ? '✓ Available' : '✓ Müsait';
            submitBtn.disabled = false;
            submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }

        let extrasSum = 0;
        const selectedExtras = [];
        const rawSelectedExtras = [];
        document.querySelectorAll('.detail-extra-cb').forEach(function(cb) {
            const perGuest = Number(cb.dataset.perGuest || 0);
            const itemTotal = perGuest * guests;
            const priceEl = cb.closest('label') ? cb.closest('label').querySelector('.detail-extra-price') : null;
            if (priceEl) priceEl.innerText = '+€' + itemTotal.toLocaleString();
            if (cb.checked) {
                extrasSum += itemTotal;
                selectedExtras.push(cb.dataset.displayLabel || cb.value);
                rawSelectedExtras.push(cb.value);
            }
        });
        if (extrasCsvEl) extrasCsvEl.value = rawSelectedExtras.join(',');

        const rentTotal = diff * dailyRate;
        const autoDisc = diff >= 5 ? Math.round(rentTotal * 0.05) : 0;
        const subTotal = Math.max(0, rentTotal - autoDisc + extrasSum);
        const total = interestPct > 0 ? Math.round(subTotal * (1 + interestPct / 100)) : subTotal;
        const payNow = Math.round(total * (installmentPct / 100));
        const remaining = Math.max(0, total - payNow);

        document.getElementById('dayCount').innerText = diff;
        document.getElementById('detailGuestLabel').innerText = guests;
        document.getElementById('baseRentTotal').innerText = '€' + rentTotal.toLocaleString();
        document.getElementById('detailExtrasTotal').innerText = '+€' + extrasSum.toLocaleString();

        const discRow = document.getElementById('detailAutoDiscRow');
        if (autoDisc > 0) {
            discRow.classList.remove('hidden');
            document.getElementById('detailAutoDisc').innerText = '-€' + autoDisc.toLocaleString();
        } else {
            discRow.classList.add('hidden');
        }

        document.getElementById('grandTotal').innerText = '€' + total.toLocaleString();
        document.getElementById('detailPayNow').innerText = '€' + payNow.toLocaleString();
        document.getElementById('detailRemaining').innerText = '€' + remaining.toLocaleString();

        const dayUnit = isEnYd ? (diff === 1 ? 'day' : 'days') : 'gün';
        const guestUnit = isEnYd ? (guests === 1 ? 'guest' : 'guests') : 'misafir';
        const dateText = (inVal && outVal)
            ? `${inVal} - ${outVal} (${diff} ${dayUnit})`
            : (isEnYd ? 'Dates not specified' : 'Tarih belirtilmedi');
        const extraNote = selectedExtras.length > 0
            ? ((isEnYd ? ' | Extras: ' : ' | Ekstralar: ') + selectedExtras.join(', '))
            : '';
        const waText = isEnYd
            ? ('Hello ' + brandName + ', I would like to inquire about ' + yachtTitle + ' for ' + dateText + ', ' + guests + ' ' + guestUnit + extraNote + (total > 0 ? ', estimated €' + total.toLocaleString() : '') + '.')
            : ('Merhaba ' + brandName + ', ' + yachtTitle + ' için ' + dateText + ', ' + guests + ' ' + guestUnit + extraNote + (total > 0 ? ', tahmini €' + total.toLocaleString() : '') + ' hakkında bilgi almak istiyorum.');
        document.getElementById('waLink').href = 'https://wa.me/' + encodeURIComponent(waNum) + '?text=' + encodeURIComponent(waText);
    }

    document.getElementById('inDate').addEventListener('change', calcPrice);
    document.getElementById('outDate').addEventListener('change', calcPrice);
    document.getElementById('guestNum').addEventListener('input', calcPrice);
    document.querySelectorAll('.detail-extra-cb').forEach(function(cb) {
        cb.addEventListener('change', calcPrice);
    });
    calcPrice();

    document.querySelectorAll('.tab-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const tab = this.dataset.tab;
            ['desc', 'specs', 'inc', 'avail', 'loc'].forEach(function(t) {
                document.getElementById('content-' + t).classList.add('hidden');
                document.getElementById('tab-' + t).className = 'tab-btn text-slate-400 hover:text-slate-700 pb-3 -mb-3.5';
            });
            document.getElementById('content-' + tab).classList.remove('hidden');
            document.getElementById('tab-' + tab).className = 'tab-btn text-[#0B1F3A] border-b-2 border-[#0B1F3A] pb-3 -mb-3.5';
        });
    });
</script>

<%- include('../partials/footer') %>