<%- include('../partials/header') %>

<main id="yachtDetailRoot" data-yacht-id="<%= yacht.id %>" data-daily-rate="<%= yacht.price %>" data-yacht-title="<%= yacht.name %> (<%= yacht.location %>)" class="max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8">
    <% if (reviewSaved) { %>
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-3.5 rounded-2xl text-sm font-semibold">
            <i class="fa-solid fa-circle-check mr-2"></i>Teşekkürler! Değerlendirmeniz başarıyla yayınlandı.
        </div>
    <% } %>

    <div class="space-y-3">
        <div class="relative rounded-2xl overflow-hidden h-[320px] md:h-[450px] bg-slate-200">
            <img id="mainPhoto" src="<%= yacht.images[0] %>" alt="<%= yacht.name %>" class="detail-img w-full h-full object-cover">
            <span class="absolute bottom-4 left-4 bg-[#0B1F3A]/85 text-white text-xs font-bold px-3 py-1.5 rounded-lg">
                1 / <%= yacht.images.length %> Fotoğraf
            </span>
        </div>
        <div class="grid grid-cols-4 gap-3">
            <% for (let i = 0; i < yacht.images.length; i++) { %>
                <button type="button" data-img-src="<%= yacht.images[i] %>" class="thumb-btn rounded-xl overflow-hidden h-20 md:h-24 border-2 border-transparent hover:border-[#0B1F3A] transition">
                    <img src="<%= yacht.images[i] %>" alt="<%= yacht.name %>" class="detail-img w-full h-full object-cover">
                </button>
            <% } %>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2 space-y-6">
            <div class="border-b border-slate-200 pb-5 flex flex-wrap justify-between items-start gap-4">
                <div>
                    <div class="flex items-center space-x-2.5">
                        <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900"><%= yacht.name %></h1>
                        <span class="bg-[#0B1F3A] text-white text-xs font-extrabold px-2.5 py-1 rounded-lg"><%= yacht.rating.toFixed(1) %> / 5</span>
                    </div>
                    <p class="text-xs text-slate-500 mt-1"><%= yacht.categoryTr %> • <%= yacht.length %> • <%= yacht.year %> • <%= yacht.location %> Marina</p>
                </div>
                <div class="flex flex-wrap gap-2 text-xs">
                    <span class="bg-emerald-50 text-emerald-700 font-bold px-3 py-1.5 rounded-lg">✓ Ücretsiz İptal</span>
                    <span class="bg-sky-50 text-sky-700 font-bold px-3 py-1.5 rounded-lg">✓ %30 Kapora</span>
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div class="bg-white p-4 rounded-xl border border-slate-200 text-center">
                    <i class="fa-solid fa-users text-[#0B1F3A] mb-1"></i>
                    <div class="font-bold text-sm"><%= yacht.guests %> Misafir</div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 text-center">
                    <i class="fa-solid fa-bed text-[#0B1F3A] mb-1"></i>
                    <div class="font-bold text-sm"><%= yacht.cabins %> Kabin</div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 text-center">
                    <i class="fa-solid fa-user-tie text-[#0B1F3A] mb-1"></i>
                    <div class="font-bold text-sm"><%= yacht.crew %> Mürettebat</div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 text-center">
                    <i class="fa-solid fa-gauge-high text-[#0B1F3A] mb-1"></i>
                    <div class="font-bold text-sm"><%= yacht.speed %></div>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-4">
                <div class="flex flex-wrap gap-5 border-b border-slate-100 pb-3 text-xs sm:text-sm font-bold">
                    <button type="button" data-tab="desc" id="tab-desc" class="tab-btn text-[#0B1F3A] border-b-2 border-[#0B1F3A] pb-3 -mb-3.5">Açıklama</button>
                    <button type="button" data-tab="specs" id="tab-specs" class="tab-btn text-slate-400 hover:text-slate-700 pb-3 -mb-3.5">Teknik Özellikler</button>
                    <button type="button" data-tab="inc" id="tab-inc" class="tab-btn text-slate-400 hover:text-slate-700 pb-3 -mb-3.5">Dahil Olanlar</button>
                    <button type="button" data-tab="avail" id="tab-avail" class="tab-btn text-slate-400 hover:text-slate-700 pb-3 -mb-3.5">Müsaitlik</button>
                    <button type="button" data-tab="loc" id="tab-loc" class="tab-btn text-slate-400 hover:text-slate-700 pb-3 -mb-3.5">Konum</button>
                </div>

                <div id="content-desc" class="text-sm text-slate-600 leading-relaxed space-y-3 pt-2">
                    <p><%= yacht.description %></p>
                    <div class="grid grid-cols-2 gap-2 pt-2 text-xs font-medium text-slate-800">
                        <% for (let i = 0; i < yacht.features.length; i++) { %>
                            <div><i class="fa-solid fa-check text-emerald-600 mr-1.5"></i><%= yacht.features[i] %></div>
                        <% } %>
                    </div>
                </div>

                <div id="content-specs" class="hidden text-sm text-slate-700 pt-2">
                    <div class="grid grid-cols-2 gap-3 text-xs">
                        <div class="bg-slate-50 p-3 rounded-lg"><strong>Uzunluk:</strong> <%= yacht.length %></div>
                        <div class="bg-slate-50 p-3 rounded-lg"><strong>Model Yılı:</strong> <%= yacht.year %></div>
                        <div class="bg-slate-50 p-3 rounded-lg"><strong>Kabin Sayısı:</strong> <%= yacht.cabins %></div>
                        <div class="bg-slate-50 p-3 rounded-lg"><strong>Seyir Hızı:</strong> <%= yacht.speed %></div>
                    </div>
                </div>

                <div id="content-inc" class="hidden text-sm text-slate-600 space-y-2 pt-2">
                    <% for (let i = 0; i < yacht.inclusions.length; i++) { %>
                        <div class="flex items-center space-x-2 text-xs">
                            <i class="fa-solid fa-circle-check text-teal-600"></i>
                            <span><%= yacht.inclusions[i] %></span>
                        </div>
                    <% } %>
                </div>

                <div id="content-avail" class="hidden text-sm text-slate-600 pt-2 space-y-2">
                    <p class="text-xs">Seçili tarih aralığı için anında müsaitlik kontrolü yapılır.</p>
                    <% if (yachtBookings && yachtBookings.length > 0) { %>
                        <div class="text-xs text-amber-800 bg-amber-50 p-3 rounded-xl">
                            <strong>Dolu Tarihler:</strong>
                            <% for (let i = 0; i < yachtBookings.length; i++) { %>
                                <span class="ml-1 font-semibold"><%= yachtBookings[i].checkIn %> → <%= yachtBookings[i].checkOut %></span>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="inline-block bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-lg">Tüm Tarihler Müsait</div>
                    <% } %>
                </div>

                <div id="content-loc" class="hidden text-sm text-slate-600 pt-2">
                    <div class="bg-slate-100 rounded-xl p-6 text-center border border-slate-200">
                        <i class="fa-solid fa-location-dot text-2xl text-[#0B1F3A] mb-2"></i>
                        <div class="font-bold text-slate-800"><%= yacht.location %> Marina</div>
                        <p class="text-xs text-slate-500 mt-1">Kalkış ve dönüş noktası: <%= yacht.location %></p>
                    </div>
                </div>
            </div>

            <% if (yacht.itinerary && yacht.itinerary.length > 0) { %>
                <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-4">
                    <h2 class="text-lg font-extrabold text-[#0B1F3A] flex items-center space-x-2">
                        <i class="fa-solid fa-route text-teal-600"></i>
                        <span>Örnek Günlük Tur Rotası &amp; Saat Akışı</span>
                    </h2>
                    <div class="space-y-4 border-l-2 border-teal-100 ml-3 pl-5">
                        <% for (let i = 0; i < yacht.itinerary.length; i++) { %>
                            <div class="relative">
                                <span class="w-3 h-3 rounded-full bg-teal-600 absolute -left-[27px] top-1.5 ring-4 ring-white"></span>
                                <div class="text-xs font-extrabold text-teal-700"><%= yacht.itinerary[i].time %> — <span class="text-slate-900"><%= yacht.itinerary[i].title %></span></div>
                                <p class="text-xs text-slate-500 mt-0.5"><%= yacht.itinerary[i].desc %></p>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <!-- DOĞRULANMIŞ MİSAFİR YORUMLARI VE YORUM EKLEME -->
            <div id="reviewsSection" class="bg-white rounded-2xl border border-slate-200 p-6 space-y-6">
                <div class="flex justify-between items-center border-b border-slate-100 pb-4">
                    <div>
                        <h2 class="text-lg font-extrabold text-[#0B1F3A]">Misafir Değerlendirmeleri</h2>
                        <p class="text-xs text-slate-500">Ortalama Puan: <strong><%= yacht.rating.toFixed(1) %> / 5.0</strong> (<%= yacht.reviews %> yorum)</p>
                    </div>
                    <span class="bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-full">✓ Doğrulanmış Misafirler</span>
                </div>

                <div class="space-y-4">
                    <% const rList = yacht.reviewList || []; %>
                    <% for (let i = 0; i < rList.length; i++) { %>
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 space-y-1.5">
                            <div class="flex justify-between items-center text-xs">
                                <strong class="text-slate-900"><%= rList[i].author %></strong>
                                <span class="text-amber-500 font-bold">★ <%= rList[i].rating %>.0 <span class="text-slate-400 font-normal ml-1"><%= rList[i].date %></span></span>
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed"><%= rList[i].comment %></p>
                        </div>
                    <% } %>
                </div>

                <form action="/yachts/<%= yacht.id %>/reviews" method="POST" class="pt-4 border-t border-slate-100 space-y-3">
                    <div class="text-xs font-bold text-slate-800 uppercase">Deneyiminizi Paylaşın</div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <input type="text" name="author" placeholder="Adınız Soyadınız" required class="p-2.5 text-xs border border-slate-200 rounded-xl">
                        <select name="rating" class="p-2.5 text-xs font-semibold border border-slate-200 rounded-xl bg-white">
                            <option value="5">★★★★★ (5 - Mükemmel)</option>
                            <option value="4">★★★★☆ (4 - Çok İyi)</option>
                            <option value="3">★★★☆☆ (3 - İyi)</option>
                        </select>
                    </div>
                    <textarea name="comment" rows="2" placeholder="Yat, kaptan ve rota hakkındaki yorumunuz..." required class="w-full p-3 text-xs border border-slate-200 rounded-xl"></textarea>
                    <button type="submit" class="bg-[#0B1F3A] hover:bg-sky-900 text-white px-5 py-2.5 rounded-xl text-xs font-bold transition">
                        Yorumu Yayınla
                    </button>
                </form>
            </div>
        </div>

        <!-- SAĞ REZERVASYON KARTI + CANLI EKSTRA KALKÜLATÖR -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xl h-fit sticky top-24 space-y-5">
            <div>
                <span class="text-xs text-slate-400 block">Günlük Fiyat</span>
                <span class="text-3xl font-extrabold text-[#0B1F3A]">€<%= yacht.price.toLocaleString() %></span>
                <span class="text-xs text-slate-400">/ gün</span>
            </div>

            <form id="detailBookingForm" action="/checkout" method="GET" class="space-y-4">
                <input type="hidden" name="yachtId" value="<%= yacht.id %>">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Giriş</label>
                        <input type="date" id="inDate" name="checkIn" value="<%= checkIn %>" class="w-full p-2.5 text-xs font-semibold border border-slate-200 rounded-xl">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Çıkış</label>
                        <input type="date" id="outDate" name="checkOut" value="<%= checkOut %>" class="w-full p-2.5 text-xs font-semibold border border-slate-200 rounded-xl">
                    </div>
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Misafir Sayısı</label>
                    <input type="number" id="guestNum" name="guests" min="1" max="<%= yacht.guests %>" value="6" class="w-full p-2.5 text-sm font-semibold border border-slate-200 rounded-xl">
                </div>

                <!-- CANLI EKSTRA HİZMET KALKÜLATÖRÜ -->
                <div class="space-y-2 pt-1">
                    <label class="block text-[11px] font-bold text-slate-500 uppercase">Ekstra Hizmetler (Canlı Hesap)</label>
                    <label class="flex items-center justify-between p-2.5 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 text-xs">
                        <span class="flex items-center space-x-2">
                            <input type="checkbox" name="extras" value="Özel Şef & Gurme Menü" data-price="450" class="detail-extra-cb rounded text-[#0B1F3A]">
                            <span class="font-semibold text-slate-800">Özel Şef &amp; Menü</span>
                        </span>
                        <span class="font-bold text-[#0B1F3A]">+€450</span>
                    </label>
                    <label class="flex items-center justify-between p-2.5 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 text-xs">
                        <span class="flex items-center space-x-2">
                            <input type="checkbox" name="extras" value="VIP Havalimanı Transferi" data-price="200" class="detail-extra-cb rounded text-[#0B1F3A]">
                            <span class="font-semibold text-slate-800">VIP Transfer</span>
                        </span>
                        <span class="font-bold text-[#0B1F3A]">+€200</span>
                    </label>
                    <label class="flex items-center justify-between p-2.5 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 text-xs">
                        <span class="flex items-center space-x-2">
                            <input type="checkbox" name="extras" value="Jet Ski & Seabob Paketi" data-price="350" class="detail-extra-cb rounded text-[#0B1F3A]">
                            <span class="font-semibold text-slate-800">Jet Ski &amp; Seabob</span>
                        </span>
                        <span class="font-bold text-[#0B1F3A]">+€350</span>
                    </label>
                </div>

                <div class="bg-slate-50 p-4 rounded-xl space-y-1.5 text-xs">
                    <div class="flex justify-between text-slate-600">
                        <span>Yat (<span id="dayCount">3</span> gün)</span>
                        <span id="baseRentTotal" class="font-semibold text-slate-800">€<%= (yacht.price * 3).toLocaleString() %></span>
                    </div>
                    <div class="flex justify-between text-slate-600">
                        <span>Ekstralar</span>
                        <span id="detailExtrasTotal" class="font-semibold text-teal-700">+€0</span>
                    </div>
                    <div class="flex justify-between text-sm font-extrabold text-slate-900 pt-1.5 border-t border-slate-200">
                        <span>Tahmini Toplam</span>
                        <span id="grandTotal">€<%= (yacht.price * 3).toLocaleString() %></span>
                    </div>
                    <div id="multiDayBadge" class="text-[11px] text-emerald-600 font-bold">✓ 3+ gün seçiminde ödeme adımında %5 otomatik indirim</div>
                </div>

                <button type="submit" class="w-full bg-[#0B1F3A] hover:bg-sky-900 text-white py-3.5 rounded-xl font-bold text-sm transition shadow-lg">
                    Rezervasyona Devam Et →
                </button>
            </form>

            <a id="waLink" href="#" target="_blank" class="w-full bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 py-3 rounded-xl font-bold text-xs transition flex items-center justify-center space-x-2">
                <i class="fa-brands fa-whatsapp text-base text-emerald-600"></i>
                <span>WhatsApp ile Hızlı Bilgi Al</span>
            </a>
        </div>
    </div>
</main>

<script>
    const root = document.getElementById('yachtDetailRoot');
    const yachtId = Number(root.dataset.yachtId);
    const dailyRate = Number(root.dataset.dailyRate);
    const yachtTitle = root.dataset.yachtTitle;

    let recent = JSON.parse(localStorage.getItem('yv_recent') || '[]').filter(function(x) { return x !== yachtId; });
    recent.unshift(yachtId);
    localStorage.setItem('yv_recent', JSON.stringify(recent.slice(0, 4)));

    document.querySelectorAll('.detail-img').forEach(function(img) {
        img.addEventListener('error', function() {
            if (typeof fallbackYachtImg === 'function') fallbackYachtImg(this);
        });
    });

    document.querySelectorAll('.thumb-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const mp = document.getElementById('mainPhoto');
            delete mp.dataset.fallbackApplied;
            mp.src = this.dataset.imgSrc;
        });
    });

    function calcPrice() {
        const inVal = document.getElementById('inDate').value;
        const outVal = document.getElementById('outDate').value;
        const guests = document.getElementById('guestNum').value;
        const d1 = new Date(inVal);
        const d2 = new Date(outVal);
        let diff = Math.round((d2 - d1) / (1000 * 60 * 60 * 24));
        if (isNaN(diff) || diff < 1) diff = 1;

        let extrasSum = 0;
        const selectedExtras = [];
        document.querySelectorAll('.detail-extra-cb:checked').forEach(function(cb) {
            extrasSum += Number(cb.dataset.price || 0);
            selectedExtras.push(cb.value);
        });

        const rentTotal = diff * dailyRate;
        const total = rentTotal + extrasSum;

        document.getElementById('dayCount').innerText = diff;
        document.getElementById('baseRentTotal').innerText = '€' + rentTotal.toLocaleString();
        document.getElementById('detailExtrasTotal').innerText = '+€' + extrasSum.toLocaleString();
        document.getElementById('grandTotal').innerText = '€' + total.toLocaleString();
        document.getElementById('multiDayBadge').classList.toggle('hidden', diff < 3);

        const extraNote = selectedExtras.length > 0 ? ' | Ekstralar: ' + selectedExtras.join(', ') : '';
        const msg = encodeURIComponent('Merhaba YachtVoyage, ' + yachtTitle + ' için ' + inVal + ' - ' + outVal + ' tarihleri (' + diff + ' gün, ' + guests + ' misafir' + extraNote + ', tahmini €' + total.toLocaleString() + ') hakkında bilgi almak istiyorum.');
        document.getElementById('waLink').href = 'https://wa.me/902521234567?text=' + msg;
    }

    document.getElementById('inDate').addEventListener('change', calcPrice);
    document.getElementById('outDate').addEventListener('change', calcPrice);
    document.getElementById('guestNum').addEventListener('input', calcPrice);
    document.querySelectorAll('.detail-extra-cb').forEach(function(cb) {
        cb.addEventListener('change', calcPrice);
    });
    calcPrice();

    document.querySelectorAll('.tab-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const tab = this.dataset.tab;
            ['desc', 'specs', 'inc', 'avail', 'loc'].forEach(function(t) {
                document.getElementById('content-' + t).classList.add('hidden');
                document.getElementById('tab-' + t).className = 'tab-btn text-slate-400 hover:text-slate-700 pb-3 -mb-3.5';
            });
            document.getElementById('content-' + tab).classList.remove('hidden');
            document.getElementById('tab-' + tab).className = 'tab-btn text-[#0B1F3A] border-b-2 border-[#0B1F3A] pb-3 -mb-3.5';
        });
    });
</script>

<%- include('../partials/footer') %>