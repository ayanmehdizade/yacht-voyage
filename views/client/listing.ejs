<%- include('../partials/header') %>

<div class="bg-[#0B1F3A] text-white py-10 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-3xl md:text-4xl font-extrabold">Yat Filomuz</h1>
            <p class="text-slate-300 text-sm mt-1">Seçili tarihler (<%= filters.checkIn %> → <%= filters.checkOut %> • <%= selectedDays %> gün) için anında müsaitlik ve şeffaf fiyat</p>
        </div>
        <div class="flex flex-wrap gap-2 text-xs">
            <span class="bg-white/10 border border-white/15 px-3 py-1.5 rounded-full text-emerald-300 font-semibold">
                <i class="fa-solid fa-shield-halved mr-1"></i>7 Gün Kalaya Kadar Ücretsiz İptal
            </span>
            <span class="bg-white/10 border border-white/15 px-3 py-1.5 rounded-full text-sky-300 font-semibold">
                <i class="fa-solid fa-percent mr-1"></i>3+ Günde Otomatik %5 İndirim
            </span>
        </div>
    </div>
</div>

<main class="max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8">
    <!-- HIZLI FİLTRE CHIP'LERİ -->
    <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="text-slate-400 font-bold uppercase mr-1">Hızlı Filtre:</span>
        <a href="/yachts" class="px-3.5 py-2 rounded-full font-bold border transition <%= filters.category === 'all' && filters.features.length === 0 ? 'bg-[#0B1F3A] text-white border-[#0B1F3A]' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-100' %>">Tümü</a>
        <a href="/yachts?feature=Jakuzi" class="px-3.5 py-2 rounded-full font-bold border transition <%= filters.features.includes('Jakuzi') ? 'bg-[#0B1F3A] text-white border-[#0B1F3A]' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-100' %>">Jakuzili Yatlar</a>
        <a href="/yachts?feature=Su+Oyuncakları" class="px-3.5 py-2 rounded-full font-bold border transition <%= filters.features.includes('Su Oyuncakları') ? 'bg-[#0B1F3A] text-white border-[#0B1F3A]' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-100' %>">Su Oyuncakları</a>
        <a href="/yachts?guests=7-12" class="px-3.5 py-2 rounded-full font-bold border transition <%= filters.guests === '7-12' ? 'bg-[#0B1F3A] text-white border-[#0B1F3A]' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-100' %>">7-12 Misafir</a>
        <button type="button" id="onlyFavsBtn" class="px-3.5 py-2 rounded-full font-bold border bg-white text-rose-600 border-rose-200 hover:bg-rose-50 transition">
            <i class="fa-solid fa-heart mr-1"></i>Favorilerim (<span id="favCountBadge">0</span>)
        </button>
    </div>

    <!-- KARŞILAŞTIRMA ÇUBUĞU -->
    <div id="compareBar" class="hidden bg-white border-2 border-[#0B1F3A] rounded-2xl p-5 shadow-lg space-y-4">
        <div class="flex justify-between items-center">
            <div class="font-extrabold text-sm text-[#0B1F3A]">
                <i class="fa-solid fa-scale-balanced text-teal-600 mr-2"></i>Seçili Yatları Karşılaştır (<span id="compareCount">0</span>)
            </div>
            <button type="button" id="clearCompareBtn" class="text-xs font-bold text-rose-600 hover:underline">Seçimi Temizle</button>
        </div>
        <div id="compareGrid" class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- SOL FİLTRE PANELİ -->
        <aside class="bg-white p-6 rounded-2xl border border-slate-200 h-fit space-y-6 shadow-sm">
            <div class="flex justify-between items-center pb-4 border-b border-slate-100">
                <h2 class="font-bold text-slate-900 text-base">Sonuçları Filtrele</h2>
                <a href="/yachts" class="text-xs font-semibold text-sky-700 hover:underline">Temizle</a>
            </div>

            <% const locOptions = [
                { val: 'all', label: 'Tüm Limanlar', sub: 'Tüm Ege & Akdeniz rotaları' },
                { val: 'Göcek', label: 'Göcek', sub: 'Koylar & D-Marin kalkış' },
                { val: 'Marmaris', label: 'Marmaris', sub: 'Netsel Marina & Hisarönü' },
                { val: 'Fethiye', label: 'Fethiye', sub: 'Ece Marina & Ölüdeniz' },
                { val: 'Bodrum', label: 'Bodrum', sub: 'Yalıkavak & Türkbükü' }
            ]; %>
            <% const activeLocObj = locOptions.find(function(o) { return o.val === filters.location; }) || locOptions[0]; %>

            <% const guestOptions = [
                { val: '', label: 'Fark Etmez' },
                { val: '1-6', label: '1 - 6 Misafir' },
                { val: '7-12', label: '7 - 12 Misafir' },
                { val: '13+', label: '13+ Misafir' }
            ]; %>
            <% const activeGuestObj = guestOptions.find(function(o) { return o.val === filters.guests; }) || guestOptions[0]; %>

            <form action="/yachts" method="GET" class="space-y-5">
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Giriş</label>
                        <input type="date" name="checkIn" value="<%= filters.checkIn %>" class="w-full p-2 text-xs border border-slate-200 rounded-xl bg-slate-50">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Çıkış</label>
                        <input type="date" name="checkOut" value="<%= filters.checkOut %>" class="w-full p-2 text-xs border border-slate-200 rounded-xl bg-slate-50">
                    </div>
                </div>

                <!-- KALKIŞ LİMANI ÖZEL DROPDOWN -->
                <div class="yv-dropdown relative">
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Kalkış Limanı</label>
                    <input type="hidden" name="location" value="<%= activeLocObj.val %>">
                    <button type="button" class="yv-dd-trigger w-full px-3.5 py-2.5 text-sm border border-slate-200 rounded-xl bg-slate-50 hover:bg-slate-100/70 flex items-center justify-between text-left transition focus:outline-none">
                        <span class="yv-dd-label font-semibold text-slate-800"><%= activeLocObj.label %></span>
                        <i class="yv-dd-chevron fa-solid fa-chevron-down text-xs text-slate-400 transition-transform duration-200"></i>
                    </button>
                    <div class="yv-dd-menu hidden left-0 right-0 top-[calc(100%+6px)] absolute bg-white rounded-2xl shadow-2xl border border-slate-100 p-1.5 z-40">
                        <% for (let i = 0; i < locOptions.length; i++) { %>
                            <% const isSel = locOptions[i].val === activeLocObj.val; %>
                            <button type="button" data-value="<%= locOptions[i].val %>" data-label="<%= locOptions[i].label %>" class="yv-dd-option w-full px-3 py-2 rounded-xl flex items-center justify-between text-left text-xs transition <%= isSel ? 'bg-slate-100 font-bold text-[#0B1F3A]' : 'text-slate-700 hover:bg-slate-50' %>">
                                <div>
                                    <div><%= locOptions[i].label %></div>
                                    <div class="text-[10px] font-normal text-slate-400"><%= locOptions[i].sub %></div>
                                </div>
                                <i class="yv-dd-check <%= isSel ? '' : 'hidden' %> fa-solid fa-check text-xs text-teal-600"></i>
                            </button>
                        <% } %>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Yat Tipi</label>
                    <div class="space-y-2 text-sm text-slate-600">
                        <% const typeList = [
                            { val: 'all', label: 'Tümü' },
                            { val: 'Motor Yachts', label: 'Motor Yat' },
                            { val: 'Gulets', label: 'Gulet' },
                            { val: 'Sailing Yachts', label: 'Yelkenli Yat' },
                            { val: 'Catamarans', label: 'Katamaran' },
                            { val: 'Superyachts', label: 'Süperyat' }
                        ]; %>
                        <% for (let i = 0; i < typeList.length; i++) { %>
                            <label class="flex items-center space-x-2 cursor-pointer">
                                <input type="radio" name="category" value="<%= typeList[i].val %>" <%= filters.category === typeList[i].val ? 'checked' : '' %> class="text-[#0B1F3A]">
                                <span><%= typeList[i].label %></span>
                            </label>
                        <% } %>
                    </div>
                </div>

                <!-- MİSAFİR KAPASİTESİ ÖZEL DROPDOWN -->
                <div class="yv-dropdown relative">
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Misafir Kapasitesi</label>
                    <input type="hidden" name="guests" value="<%= activeGuestObj.val %>">
                    <button type="button" class="yv-dd-trigger w-full px-3.5 py-2.5 text-sm border border-slate-200 rounded-xl bg-slate-50 hover:bg-slate-100/70 flex items-center justify-between text-left transition focus:outline-none">
                        <span class="yv-dd-label font-semibold text-slate-800"><%= activeGuestObj.label %></span>
                        <i class="yv-dd-chevron fa-solid fa-chevron-down text-xs text-slate-400 transition-transform duration-200"></i>
                    </button>
                    <div class="yv-dd-menu hidden left-0 right-0 top-[calc(100%+6px)] absolute bg-white rounded-2xl shadow-2xl border border-slate-100 p-1.5 z-40">
                        <% for (let i = 0; i < guestOptions.length; i++) { %>
                            <% const isGSel = guestOptions[i].val === activeGuestObj.val; %>
                            <button type="button" data-value="<%= guestOptions[i].val %>" data-label="<%= guestOptions[i].label %>" class="yv-dd-option w-full px-3 py-2.5 rounded-xl flex items-center justify-between text-left text-xs transition <%= isGSel ? 'bg-slate-100 font-bold text-[#0B1F3A]' : 'text-slate-700 hover:bg-slate-50' %>">
                                <span><%= guestOptions[i].label %></span>
                                <i class="yv-dd-check <%= isGSel ? '' : 'hidden' %> fa-solid fa-check text-xs text-teal-600"></i>
                            </button>
                        <% } %>
                    </div>
                </div>

                <div>
                    <div class="flex justify-between text-xs font-bold text-slate-700 uppercase mb-2">
                        <span>Maks. Günlük Fiyat</span>
                        <span id="priceLabel" class="text-sky-700">€<%= Number(filters.maxPrice).toLocaleString() %></span>
                    </div>
                    <input type="range" id="maxPriceRange" name="maxPrice" min="1500" max="10000" step="500" value="<%= filters.maxPrice %>" class="w-full accent-[#0B1F3A]">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Özellikler</label>
                    <div class="space-y-2 text-sm text-slate-600">
                        <% const featList = ['Jakuzi', 'Su Oyuncakları', 'Klima', 'Mürettebat Dahil']; %>
                        <% for (let i = 0; i < featList.length; i++) { %>
                            <label class="flex items-center space-x-2 cursor-pointer">
                                <input type="checkbox" name="feature" value="<%= featList[i] %>" <%= filters.features.includes(featList[i]) ? 'checked' : '' %> class="rounded text-[#0B1F3A]">
                                <span><%= featList[i] %></span>
                            </label>
                        <% } %>
                    </div>
                </div>

                <button type="submit" class="w-full bg-[#0B1F3A] hover:bg-sky-900 text-white py-3 rounded-xl text-sm font-bold transition">
                    Filtreleri Uygula
                </button>
            </form>
        </aside>

        <!-- SAĞ YAT LİSTESİ -->
        <div class="lg:col-span-3 space-y-6">
            <% const sortOptions = [
                { val: 'recommended', label: 'Önerilen' },
                { val: 'price_asc', label: 'Fiyat: Düşükten Yükseğe' },
                { val: 'price_desc', label: 'Fiyat: Yüksekten Düşüğe' },
                { val: 'rating', label: 'En Yüksek Puan' }
            ]; %>
            <% const activeSortObj = sortOptions.find(function(o) { return o.val === filters.sort; }) || sortOptions[0]; %>

            <div class="bg-white px-5 py-3.5 rounded-xl border border-slate-200 flex flex-wrap justify-between items-center gap-3">
                <span class="text-sm font-semibold text-slate-700"><strong><%= yachts.length %></strong> yat bulundu • <span class="text-slate-400 text-xs"><%= selectedDays %> günlük fiyatlar gösteriliyor</span></span>
                <form id="sortForm" action="/yachts" method="GET" class="flex items-center space-x-2.5 text-xs">
                    <input type="hidden" name="location" value="<%= filters.location %>">
                    <input type="hidden" name="category" value="<%= filters.category %>">
                    <input type="hidden" name="checkIn" value="<%= filters.checkIn %>">
                    <input type="hidden" name="checkOut" value="<%= filters.checkOut %>">
                    <span class="text-slate-400 font-semibold">Sırala:</span>
                    <div id="sortDropdown" class="yv-dropdown relative">
                        <input type="hidden" id="sortHiddenInput" name="sort" value="<%= activeSortObj.val %>">
                        <button type="button" class="yv-dd-trigger border border-slate-200 rounded-xl px-3.5 py-2 font-bold text-slate-700 bg-slate-50 hover:bg-slate-100 flex items-center space-x-2.5 transition focus:outline-none">
                            <span class="yv-dd-label"><%= activeSortObj.label %></span>
                            <i class="yv-dd-chevron fa-solid fa-chevron-down text-[10px] text-slate-400 transition-transform duration-200"></i>
                        </button>
                        <div class="yv-dd-menu hidden right-0 w-52 top-[calc(100%+6px)] absolute bg-white rounded-2xl shadow-2xl border border-slate-100 p-1.5 z-40">
                            <% for (let i = 0; i < sortOptions.length; i++) { %>
                                <% const isSSel = sortOptions[i].val === activeSortObj.val; %>
                                <button type="button" data-value="<%= sortOptions[i].val %>" data-label="<%= sortOptions[i].label %>" class="yv-dd-option w-full px-3 py-2 rounded-xl flex items-center justify-between text-left text-xs transition <%= isSSel ? 'bg-slate-100 font-bold text-[#0B1F3A]' : 'text-slate-700 hover:bg-slate-50' %>">
                                    <span><%= sortOptions[i].label %></span>
                                    <i class="yv-dd-check <%= isSSel ? '' : 'hidden' %> fa-solid fa-check text-xs text-teal-600"></i>
                                </button>
                            <% } %>
                        </div>
                    </div>
                </form>
            </div>

            <% if (yachts.length === 0) { %>
                <div class="bg-white p-12 rounded-2xl border border-slate-200 text-center space-y-3">
                    <i class="fa-solid fa-anchor text-3xl text-slate-300"></i>
                    <h3 class="font-bold text-lg text-slate-800">Kriterlerinize uygun yat bulunamadı</h3>
                    <a href="/yachts" class="inline-block bg-[#0B1F3A] text-white px-5 py-2.5 rounded-xl text-xs font-bold">Tüm Yatları Göster</a>
                </div>
            <% } %>

            <% const workingImgs = [
                'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=1000&q=80',
                'https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=1000&q=80',
                'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=1000&q=80',
                'https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=1000&q=80'
            ]; %>

            <% for (let idx = 0; idx < yachts.length; idx++) { %>
                <% const yacht = yachts[idx]; %>
                <% const cardImg = (yacht.images && yacht.images[0] && !yacht.images[0].includes('1569263979104')) ? yacht.images[0] : workingImgs[idx % workingImgs.length]; %>
                <% const rawStay = yacht.price * selectedDays; %>
                <% const stayTotal = selectedDays >= 3 ? Math.round(rawStay * 0.95) : rawStay; %>
                <div class="yacht-card bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-lg transition grid grid-cols-1 md:grid-cols-3 items-stretch"
                     data-id="<%= yacht.id %>"
                     data-name="<%= yacht.name %>"
                     data-price="<%= yacht.price %>"
                     data-location="<%= yacht.location %>"
                     data-category="<%= yacht.categoryTr %>"
                     data-guests="<%= yacht.guests %>"
                     data-cabins="<%= yacht.cabins %>"
                     data-crew="<%= yacht.crew %>"
                     data-length="<%= yacht.length %>"
                     data-speed="<%= yacht.speed %>"
                     data-img="<%= cardImg %>">
                    <div class="relative h-56 md:h-64 w-full overflow-hidden bg-slate-100">
                        <img src="<%= cardImg %>" alt="<%= yacht.name %>" class="yacht-img w-full h-full object-cover">
                        <span class="absolute top-3 left-3 bg-[#0B1F3A]/90 text-white text-[11px] font-bold px-3 py-1 rounded-full">
                            <%= yacht.location %>
                        </span>
                        <% if (yacht.badge) { %>
                            <span class="absolute bottom-3 left-3 bg-amber-400 text-[#0B1F3A] text-[10px] font-extrabold px-2.5 py-1 rounded-md shadow">
                                <%= yacht.badge %>
                            </span>
                        <% } %>
                        <button type="button" data-fav-id="<%= yacht.id %>" class="fav-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 text-slate-600 hover:text-rose-600 flex items-center justify-center shadow transition">
                            <i class="fa-solid fa-heart text-xs"></i>
                        </button>
                    </div>

                    <div class="p-5 md:p-6 md:col-span-2 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start gap-4">
                                <div>
                                    <div class="flex items-center space-x-2">
                                        <h3 class="text-xl font-extrabold text-slate-900"><%= yacht.name %></h3>
                                        <span class="bg-[#0B1F3A] text-white text-xs font-extrabold px-2 py-0.5 rounded-md"><%= yacht.rating.toFixed(1) %></span>
                                    </div>
                                    <p class="text-xs text-slate-500 mt-0.5"><%= yacht.categoryTr %> • <%= yacht.length %> • <%= yacht.year %> • <%= yacht.reviews %> doğrulanmış yorum</p>
                                </div>
                                <div class="text-right shrink-0">
                                    <span class="text-[11px] text-slate-400 block">Günlük €<%= yacht.price.toLocaleString() %></span>
                                    <span class="text-2xl font-extrabold text-[#0B1F3A]">€<%= stayTotal.toLocaleString() %></span>
                                    <span class="text-[11px] text-emerald-600 font-bold block"><%= selectedDays %> gün toplam <%= selectedDays >= 3 ? '(%5 indirimli)' : '' %></span>
                                </div>
                            </div>

                            <div class="flex flex-wrap items-center gap-4 text-xs text-slate-600 mt-3">
                                <span><i class="fa-solid fa-users text-sky-700 mr-1"></i><%= yacht.guests %> Misafir</span>
                                <span><i class="fa-solid fa-bed text-sky-700 mr-1"></i><%= yacht.cabins %> Kabin</span>
                                <span><i class="fa-solid fa-user-tie text-sky-700 mr-1"></i><%= yacht.crew %> Mürettebat</span>
                                <span><i class="fa-solid fa-gauge-high text-sky-700 mr-1"></i><%= yacht.speed %></span>
                            </div>

                            <div class="flex flex-wrap gap-1.5 mt-3">
                                <% for (let fIdx = 0; fIdx < yacht.features.length; fIdx++) { %>
                                    <span class="bg-slate-100 text-slate-600 text-[11px] font-medium px-2.5 py-1 rounded-md"><%= yacht.features[fIdx] %></span>
                                <% } %>
                                <span class="bg-emerald-50 text-emerald-700 text-[11px] font-semibold px-2.5 py-1 rounded-md">✓ Ücretsiz İptal</span>
                                <span class="bg-sky-50 text-sky-700 text-[11px] font-semibold px-2.5 py-1 rounded-md">✓ %30 Kapora</span>
                            </div>
                        </div>

                        <div class="flex flex-wrap justify-between items-center gap-3 mt-5 pt-4 border-t border-slate-100">
                            <label class="flex items-center space-x-2 text-xs font-semibold text-slate-600 cursor-pointer">
                                <input type="checkbox" data-compare-id="<%= yacht.id %>" class="compare-cb rounded text-[#0B1F3A]">
                                <span>Karşılaştır</span>
                            </label>

                            <div class="flex items-center space-x-3">
                                <a href="/yachts/<%= yacht.id %>?checkIn=<%= filters.checkIn %>&checkOut=<%= filters.checkOut %>" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-xl text-xs font-bold transition">
                                    Detayları İncele
                                </a>
                                <a href="/checkout?yachtId=<%= yacht.id %>&checkIn=<%= filters.checkIn %>&checkOut=<%= filters.checkOut %>" class="px-5 py-2.5 bg-[#0B1F3A] hover:bg-sky-900 text-white rounded-xl text-xs font-bold transition">
                                    Hemen Kirala →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- SON İNCELENEN YATLAR ŞERİDİ -->
    <section id="recentSection" class="hidden pt-6 border-t border-slate-200 space-y-4">
        <h2 class="text-lg font-extrabold text-[#0B1F3A]">Son İncelediğiniz Yatlar</h2>
        <div id="recentGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4"></div>
    </section>
</main>

<script>
    const priceRange = document.getElementById('maxPriceRange');
    const priceLabel = document.getElementById('priceLabel');
    if (priceRange && priceLabel) {
        priceRange.addEventListener('input', function() {
            priceLabel.innerText = '€' + Number(this.value).toLocaleString();
        });
    }

    const sortDropdown = document.getElementById('sortDropdown');
    const sortForm = document.getElementById('sortForm');
    if (sortDropdown && sortForm) {
        sortDropdown.querySelectorAll('.yv-dd-option').forEach(function(opt) {
            opt.addEventListener('click', function() {
                setTimeout(function() { sortForm.submit(); }, 60);
            });
        });
    }

    document.querySelectorAll('.yacht-img').forEach(function(img) {
        img.addEventListener('error', function() {
            if (typeof fallbackYachtImg === 'function') fallbackYachtImg(this);
        });
    });

    const allYachts = Array.from(document.querySelectorAll('.yacht-card')).map(function(el) {
        return {
            id: Number(el.dataset.id),
            name: el.dataset.name,
            price: Number(el.dataset.price),
            location: el.dataset.location,
            categoryTr: el.dataset.category,
            guests: el.dataset.guests,
            cabins: el.dataset.cabins,
            crew: el.dataset.crew,
            length: el.dataset.length,
            speed: el.dataset.speed,
            img: el.dataset.img
        };
    });

    let selectedCompareIds = [];
    let favIds = JSON.parse(localStorage.getItem('yv_favs') || '[]');
    let showOnlyFavs = false;

    function renderFavs() {
        const badge = document.getElementById('favCountBadge');
        if (badge) badge.innerText = favIds.length;
        document.querySelectorAll('.fav-btn').forEach(function(btn) {
            const id = Number(btn.dataset.favId);
            btn.className = favIds.includes(id)
                ? 'fav-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-rose-600 text-white flex items-center justify-center shadow transition'
                : 'fav-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 text-slate-600 hover:text-rose-600 flex items-center justify-center shadow transition';
        });
        document.querySelectorAll('.yacht-card').forEach(function(card) {
            const id = Number(card.dataset.id);
            card.classList.toggle('hidden', showOnlyFavs && !favIds.includes(id));
        });
    }

    document.querySelectorAll('.fav-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const id = Number(this.dataset.favId);
            if (favIds.includes(id)) favIds = favIds.filter(function(x) { return x !== id; });
            else favIds.push(id);
            localStorage.setItem('yv_favs', JSON.stringify(favIds));
            renderFavs();
        });
    });

    const onlyFavsBtn = document.getElementById('onlyFavsBtn');
    if (onlyFavsBtn) {
        onlyFavsBtn.addEventListener('click', function() {
            showOnlyFavs = !showOnlyFavs;
            this.classList.toggle('bg-rose-600', showOnlyFavs);
            this.classList.toggle('text-white', showOnlyFavs);
            this.classList.toggle('bg-white', !showOnlyFavs);
            this.classList.toggle('text-rose-600', !showOnlyFavs);
            renderFavs();
        });
    }

    function renderCompare() {
        const bar = document.getElementById('compareBar');
        const grid = document.getElementById('compareGrid');
        document.getElementById('compareCount').innerText = selectedCompareIds.length;

        if (selectedCompareIds.length < 2) {
            bar.classList.add('hidden');
            return;
        }
        bar.classList.remove('hidden');
        const items = allYachts.filter(function(y) { return selectedCompareIds.includes(y.id); });
        grid.innerHTML = items.map(function(y) {
            return '<div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2">' +
                '<div class="flex justify-between items-center">' +
                    '<strong class="text-sm text-slate-900">' + y.name + '</strong>' +
                    '<span class="font-extrabold text-[#0B1F3A]">€' + y.price.toLocaleString() + '/gün</span>' +
                '</div>' +
                '<div class="text-slate-600">Liman: <strong>' + y.location + '</strong> • Tip: <strong>' + y.categoryTr + '</strong></div>' +
                '<div class="text-slate-600">Kapasite: <strong>' + y.guests + ' Kişi</strong> • Kabin: <strong>' + y.cabins + '</strong> • Mürettebat: <strong>' + y.crew + '</strong></div>' +
                '<div class="text-slate-600">Uzunluk: <strong>' + y.length + '</strong> • Hız: <strong>' + y.speed + '</strong></div>' +
                '<a href="/checkout?yachtId=' + y.id + '" class="inline-block mt-2 bg-[#0B1F3A] text-white px-3.5 py-1.5 rounded-lg font-bold">Kirala →</a>' +
            '</div>';
        }).join('');
    }

    document.querySelectorAll('.compare-cb').forEach(function(cb) {
        cb.addEventListener('change', function() {
            const id = Number(this.dataset.compareId);
            if (this.checked) {
                if (selectedCompareIds.length >= 3) {
                    this.checked = false;
                    return;
                }
                if (!selectedCompareIds.includes(id)) selectedCompareIds.push(id);
            } else {
                selectedCompareIds = selectedCompareIds.filter(function(x) { return x !== id; });
            }
            renderCompare();
        });
    });

    const clearCompareBtn = document.getElementById('clearCompareBtn');
    if (clearCompareBtn) {
        clearCompareBtn.addEventListener('click', function() {
            selectedCompareIds = [];
            document.querySelectorAll('.compare-cb').forEach(function(cb) { cb.checked = false; });
            renderCompare();
        });
    }

    const recentIds = JSON.parse(localStorage.getItem('yv_recent') || '[]');
    const recentItems = allYachts.filter(function(y) { return recentIds.includes(y.id); });
    if (recentItems.length > 0) {
        document.getElementById('recentSection').classList.remove('hidden');
        document.getElementById('recentGrid').innerHTML = recentItems.map(function(y) {
            return '<a href="/yachts/' + y.id + '" class="bg-white p-3 rounded-xl border border-slate-200 flex items-center space-x-3 hover:shadow transition">' +
                '<img src="' + y.img + '" class="w-16 h-16 rounded-lg object-cover shrink-0">' +
                '<div>' +
                    '<div class="font-bold text-xs text-slate-900">' + y.name + '</div>' +
                    '<div class="text-[11px] text-slate-500">' + y.location + ' • €' + y.price.toLocaleString() + '/gün</div>' +
                '</div>' +
            '</a>';
        }).join('');
    }

    renderFavs();
</script>

