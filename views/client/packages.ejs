<%- include('../partials/header') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-slate-200 pb-5">
        <div>
            <span class="text-xs font-extrabold uppercase tracking-wider text-teal-600">Hazır Programlar</span>
            <h1 class="text-3xl md:text-4xl font-extrabold text-[#0B1F3A] mt-1">Tur Paketleri &amp; Dahil Olanlar</h1>
        </div>
        <a href="/yachts" class="text-xs font-bold bg-[#0B1F3A] text-white px-4 py-2.5 rounded-xl hover:bg-sky-900 transition">Tüm Yatları Gör →</a>
    </div>

    <% const dynTours = (typeof tours !== 'undefined' && Array.isArray(tours)) ? tours : []; %>
    <% const yachtList = (typeof yachts !== 'undefined' && Array.isArray(yachts)) ? yachts : []; %>

    <% if (dynTours.length === 0) { %>
        <div class="bg-white p-10 rounded-2xl border border-slate-200 text-center space-y-2">
            <p class="text-sm font-bold text-slate-700">Şu an aktif tur paketi bulunmuyor.</p>
            <p class="text-xs text-slate-500">Admin paneldeki <strong>Turlar &amp; Kategoriler</strong> bölümünden yeni tur ekleyebilirsiniz.</p>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
            <% dynTours.forEach(pkg => { %>
                <% const linkedYacht = yachtList.find(y => Number(y.id) === Number(pkg.yachtId)) || yachtList[0]; %>
                <% const pkgImg = pkg.img || (linkedYacht && linkedYacht.images && linkedYacht.images[0]) || 'https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=800&q=80'; %>
                <% const pkgIncluded = (Array.isArray(pkg.included) && pkg.included.length) ? pkg.included : ['Lisanslı kaptan ve mürettebat', 'Rota boyunca koy molaları']; %>
                <% const pkgExcluded = (Array.isArray(pkg.excluded) && pkg.excluded.length) ? pkg.excluded : ['Özel menü ve havalimanı transferi']; %>
                <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition flex flex-col justify-between">
                    <div>
                        <div class="relative">
                            <img src="<%= pkgImg %>" onerror="fallbackYachtImg(this)" alt="<%= pkg.title %>" class="w-full h-52 object-cover">
                            <span class="absolute top-3 left-3 bg-[#0B1F3A]/90 text-white text-[10px] font-bold px-3 py-1 rounded-full tracking-wider"><%= pkg.badge || 'TUR PAKETİ' %></span>
                        </div>
                        <div class="p-6 space-y-4">
                            <div>
                                <h2 class="text-lg font-extrabold text-slate-900"><%= pkg.title %></h2>
                                <p class="text-xs text-slate-500 mt-0.5"><i class="fa-solid fa-compass text-teal-600 mr-1"></i><%= pkg.region %></p>
                            </div>
                            <div class="flex flex-wrap gap-3 text-xs text-slate-600 bg-slate-50 p-3 rounded-xl">
                                <span><i class="fa-regular fa-clock text-teal-600 mr-1"></i><%= pkg.durationLabel || (pkg.durationDays + ' Gün') %></span>
                                <span><i class="fa-solid fa-users text-teal-600 mr-1"></i><%= pkg.capacityLabel || (linkedYacht ? ('En fazla ' + linkedYacht.guests + ' kişi') : 'Özel Grup') %></span>
                            </div>
                            <% if (pkg.summary) { %>
                                <p class="text-xs text-slate-600 leading-relaxed"><%= pkg.summary %></p>
                            <% } %>
                            <div class="space-y-1.5">
                                <div class="text-[11px] font-bold uppercase text-emerald-700 tracking-wider">Pakete Dahil Olanlar</div>
                                <% pkgIncluded.forEach(item => { %>
                                    <div class="text-xs text-slate-700 flex items-start space-x-2">
                                        <i class="fa-solid fa-check text-emerald-600 mt-0.5"></i>
                                        <span><%= item %></span>
                                    </div>
                                <% }) %>
                            </div>
                            <div class="space-y-1 pt-2 border-t border-slate-100">
                                <div class="text-[11px] font-bold uppercase text-slate-400 tracking-wider">Ekstra / Dahil Değil</div>
                                <% pkgExcluded.forEach(ex => { %>
                                    <div class="text-xs text-slate-500 flex items-start space-x-2">
                                        <i class="fa-solid fa-circle-info text-slate-400 mt-0.5"></i>
                                        <span><%= ex %></span>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                    <div class="px-6 py-4 bg-slate-50/70 border-t border-slate-100 flex items-center justify-between">
                        <div>
                            <span class="text-[11px] text-slate-400 block">Başlangıç</span>
                            <span class="font-extrabold text-teal-700 text-lg"><%= Number(pkg.pricePerDay || 0).toLocaleString() %> €</span>
                        </div>
                        <a href="/yachts/<%= linkedYacht ? linkedYacht.id : '' %>" class="bg-[#0B1F3A] hover:bg-sky-900 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition">İncele &amp; Kirala →</a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</main>

<%- include('../partials/footer') %>