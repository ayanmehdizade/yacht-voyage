    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-5">
        <% const categories = [
            { key: 'Motor Yachts', title: 'Motor Yatlar', img: 'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=500&q=80' },
            { key: 'Gulets', title: 'Guletler', img: 'https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=500&q=80' },
            { key: 'Sailing Yachts', title: 'Yelkenli Yatlar', img: 'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=500&q=80' },
            { key: 'Catamarans', title: 'Katamaranlar', img: 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=500&q=80' },
            { key: 'Superyachts', title: 'Süperyatlar', img: 'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=500&q=80' }
