<%- include('../partials/header') %>

<% const homeIsEn = (typeof isEn !== 'undefined') ? Boolean(isEn) : (typeof lang !== 'undefined' && lang === 'en'); %>

<style>
    #homeDateInput::-webkit-calendar-picker-indicator {
        display: none;
        -webkit-appearance: none;
    }
</style>

<% const nowLocal = new Date(); %>
<% const todayIso = nowLocal.getFullYear() + '-' + String(nowLocal.getMonth() + 1).padStart(2, '0') + '-' + String(nowLocal.getDate()).padStart(2, '0'); %>
<% const depList = (typeof departurePoints !== 'undefined' && Array.isArray(departurePoints) && departurePoints.length) ? departurePoints : [
    { name: 'Göcek', desc: homeIsEn ? 'Coves & D-Marin departure' : 'Koylar & D-Marin kalkış' },
    { name: 'Marmaris', desc: homeIsEn ? 'Netsel Marina & Hisarönü' : 'Netsel Marina & Hisarönü' },
    { name: 'Fethiye', desc: homeIsEn ? 'Ece Marina & Ölüdeniz' : 'Ece Marina & Ölüdeniz' },
    { name: 'Bodrum', desc: homeIsEn ? 'Yalıkavak & Türkbükü' : 'Yalıkavak & Türkbükü' }
]; %>
<% const defaultDep = depList[0] || { name: 'Göcek', desc: homeIsEn ? 'Coves & D-Marin departure' : 'Koylar & D-Marin kalkış' }; %>
<% const homeCats = (typeof categories !== 'undefined' && Array.isArray(categories)) ? categories : []; %>

<section class="relative bg-[#0B1F3A] text-white overflow-x-clip">
    <img src="https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=1200&q=85"
         onerror="fallbackYachtImg(this)"
         alt="YachtVoyage Hero"
         class="absolute inset-0 w-full h-full object-cover opacity-35">
    <div class="absolute inset-0 bg-gradient-to-r from-[#0B1F3A] via-[#0B1F3A]/85 to-transparent"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-24 relative z-10">
        <div class="max-w-2xl space-y-4">
            <h1 class="text-4xl md:text-6xl font-extrabold leading-[1.1] tracking-tight">
                <%= homeIsEn ? 'Discover a Unique Yacht Experience' : 'Eşsiz Yat Deneyimini Keşfedin' %>
            </h1>
            <p class="text-slate-200 text-base md:text-lg leading-relaxed">
                <%= homeIsEn
                    ? 'Private yacht charters, daily tour packages and transparent itinerary details across Göcek, Marmaris, Fethiye and Bodrum coves.'
                    : 'Göcek, Marmaris, Fethiye ve Bodrum koylarında özel yat kiralama, günlük tur paketleri ve şeffaf içerik bilgisi.' %>
            </p>
        </div>

        <form action="/yachts" method="GET" class="mt-9 bg-white text-slate-900 p-3 md:p-3.5 rounded-2xl shadow-2xl grid grid-cols-1 md:grid-cols-12 gap-2 items-center max-w-6xl">
            <div class="yv-dropdown relative md:col-span-3 px-3.5 py-2 rounded-xl hover:bg-slate-50 transition">
                <input type="hidden" name="location" value="<%= defaultDep.name %>">
                <button type="button" class="yv-dd-trigger w-full text-left flex items-center justify-between focus:outline-none">
                    <div>
                        <span class="block text-[10px] font-extrabold tracking-wider text-slate-400 uppercase"><%= homeIsEn ? 'Departure Point' : 'Kalkış Noktası' %></span>
                        <span class="flex items-center space-x-2 mt-0.5 text-sm font-bold text-slate-900">
                            <i class="fa-solid fa-location-dot text-teal-600 text-xs"></i>
                            <span class="yv-dd-label"><%= defaultDep.name %></span>
                        </span>
                    </div>
                    <i class="yv-dd-chevron fa-solid fa-chevron-down text-xs text-slate-400 transition-transform duration-200"></i>
                </button>

                <div class="yv-dd-menu hidden max-h-60 overflow-y-auto left-0 right-0 top-[calc(100%+8px)] absolute bg-white rounded-2xl shadow-2xl border border-slate-100 p-1.5 z-50">
                    <% depList.forEach(function(dp, idx) { %>
                        <button type="button" data-value="<%= dp.name %>" data-label="<%= dp.name %>" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left <%= idx === 0 ? 'bg-slate-100 font-bold text-[#0B1F3A]' : 'text-slate-700' %> hover:bg-slate-50 transition">
                            <div>
                                <div class="text-xs <%= idx === 0 ? '' : 'font-semibold' %>"><%= dp.name %></div>
                                <div class="text-[10px] font-normal text-slate-400"><%= dp.desc || '' %></div>
                            </div>
                            <i class="yv-dd-check <%= idx === 0 ? '' : 'hidden' %> fa-solid fa-check text-xs text-teal-600"></i>
                        </button>
                    <% }) %>
                    <button type="button" data-value="all" data-label="<%= homeIsEn ? 'All Points' : 'Tüm Noktalar' %>" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition">
                        <div>
                            <div class="text-xs font-semibold"><%= homeIsEn ? 'All Points' : 'Tüm Noktalar' %></div>
                            <div class="text-[10px] font-normal text-slate-400"><%= homeIsEn ? 'All Aegean & Mediterranean routes' : 'Tüm Ege & Akdeniz rotaları' %></div>
                        </div>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                </div>
            </div>

            <div class="relative md:col-span-3 px-3.5 py-2 rounded-xl hover:bg-slate-50 transition md:border-l md:border-slate-200">
                <div class="flex items-center justify-between">
                    <label for="homeDateInput" class="block text-[10px] font-extrabold tracking-wider text-slate-400 uppercase"><%= homeIsEn ? 'Date' : 'Tarih' %></label>
                    <button type="button" id="homeDateClear" class="text-[10px] font-bold text-slate-400 hover:text-rose-600"><%= homeIsEn ? 'Clear' : 'Temizle' %></button>
                </div>

                <div class="flex items-center space-x-2 mt-0.5">
                    <i class="fa-regular fa-calendar text-teal-600 text-xs"></i>
                    <input type="date" id="homeDateInput" name="checkIn" min="<%= todayIso %>" data-no-flatpickr="true" value="" placeholder="<%= homeIsEn ? 'Select date' : 'Tarih seçin' %>" class="text-sm font-bold text-slate-900 focus:outline-none w-full bg-transparent cursor-pointer">
                </div>

                <div id="homeDatePopover" class="hidden left-0 top-[calc(100%+10px)] absolute w-[340px] max-w-[92vw] bg-white border border-slate-200 rounded-2xl shadow-2xl p-4 space-y-3 z-50 overflow-hidden text-slate-900">
                    <div class="flex items-center justify-between">
                        <button type="button" id="homeCalPrev" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-700 font-bold shrink-0">‹</button>
                        <div id="homeCalTitle" class="text-sm font-extrabold text-[#0B1F3A] text-center"><%= homeIsEn ? 'Calendar' : 'Takvim' %></div>
                        <button type="button" id="homeCalNext" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-700 font-bold shrink-0">›</button>
                    </div>

                    <div class="grid grid-cols-[repeat(7,minmax(0,1fr))] gap-1 text-center text-[11px] font-bold text-slate-400">
                        <div><%= homeIsEn ? 'Mon' : 'Pzt' %></div>
                        <div><%= homeIsEn ? 'Tue' : 'Sal' %></div>
                        <div><%= homeIsEn ? 'Wed' : 'Çar' %></div>
                        <div><%= homeIsEn ? 'Thu' : 'Per' %></div>
                        <div><%= homeIsEn ? 'Fri' : 'Cum' %></div>
                        <div><%= homeIsEn ? 'Sat' : 'Cmt' %></div>
                        <div><%= homeIsEn ? 'Sun' : 'Paz' %></div>
                    </div>

                    <div id="homeCalGrid" class="grid grid-cols-[repeat(7,minmax(0,1fr))] gap-1 text-center text-xs"></div>

                    <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-[11px] font-bold px-1">
                        <span class="inline-flex items-center gap-1.5 text-emerald-700">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block shrink-0"></span>
                            <span><%= homeIsEn ? 'Green: Available' : 'Yeşil: Boş' %></span>
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-rose-700">
                            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 inline-block shrink-0"></span>
                            <span><%= homeIsEn ? 'Red: Booked' : 'Kırmızı: Dolu' %></span>
                        </span>
                    </div>
                </div>
            </div>

            <div class="yv-dropdown relative md:col-span-2 px-3.5 py-2 rounded-xl hover:bg-slate-50 transition md:border-l md:border-slate-200">
                <input type="hidden" name="guests" value="">
                <button type="button" class="yv-dd-trigger w-full text-left flex items-center justify-between focus:outline-none">
                    <div>
                        <span class="block text-[10px] font-extrabold tracking-wider text-slate-400 uppercase"><%= homeIsEn ? 'Guests' : 'Kişi Sayısı' %></span>
                        <span class="flex items-center space-x-2 mt-0.5 text-sm font-bold text-slate-900">
                            <i class="fa-solid fa-users text-teal-600 text-xs"></i>
                            <span class="yv-dd-label"><%= homeIsEn ? 'All' : 'Tümü' %></span>
                        </span>
                    </div>
                    <i class="yv-dd-chevron fa-solid fa-chevron-down text-xs text-slate-400 transition-transform duration-200"></i>
                </button>

                <div class="yv-dd-menu hidden max-h-60 overflow-y-auto left-0 md:-left-4 right-0 md:w-52 top-[calc(100%+8px)] absolute bg-white rounded-2xl shadow-2xl border border-slate-100 p-1.5 z-50">
                    <button type="button" data-value="" data-label="<%= homeIsEn ? 'All' : 'Tümü' %>" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left bg-slate-100 font-bold text-[#0B1F3A] hover:bg-slate-50 transition text-xs">
                        <span><%= homeIsEn ? 'All' : 'Tümü' %></span>
                        <i class="yv-dd-check fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="1-6" data-label="<%= homeIsEn ? '1 - 6 Guests' : '1 - 6 Kişi' %>" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span><%= homeIsEn ? '1 - 6 Guests' : '1 - 6 Kişi' %></span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="7-12" data-label="<%= homeIsEn ? '7 - 12 Guests' : '7 - 12 Kişi' %>" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span><%= homeIsEn ? '7 - 12 Guests' : '7 - 12 Kişi' %></span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="13+" data-label="<%= homeIsEn ? '13+ Guests' : '13+ Kişi' %>" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span><%= homeIsEn ? '13+ Guests' : '13+ Kişi' %></span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                </div>
            </div>

            <div class="yv-dropdown relative md:col-span-2 px-3.5 py-2 rounded-xl hover:bg-slate-50 transition md:border-l md:border-slate-200">
                <input type="hidden" name="category" value="all">
                <button type="button" class="yv-dd-trigger w-full text-left flex items-center justify-between focus:outline-none">
                    <div>
                        <span class="block text-[10px] font-extrabold tracking-wider text-slate-400 uppercase"><%= homeIsEn ? 'Yacht Type' : 'Yat Tipi' %></span>
                        <span class="flex items-center space-x-2 mt-0.5 text-sm font-bold text-slate-900">
                            <i class="fa-solid fa-anchor text-teal-600 text-xs"></i>
                            <span class="yv-dd-label"><%= homeIsEn ? 'All' : 'Tümü' %></span>
                        </span>
                    </div>
                    <i class="yv-dd-chevron fa-solid fa-chevron-down text-xs text-slate-400 transition-transform duration-200"></i>
                </button>

                <div class="yv-dd-menu hidden max-h-60 overflow-y-auto left-0 md:-left-6 right-0 md:w-56 top-[calc(100%+8px)] absolute bg-white rounded-2xl shadow-2xl border border-slate-100 p-1.5 z-50">
                    <button type="button" data-value="all" data-label="<%= homeIsEn ? 'All' : 'Tümü' %>" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left bg-slate-100 font-bold text-[#0B1F3A] hover:bg-slate-50 transition text-xs">
                        <span><%= homeIsEn ? 'All' : 'Tümü' %></span>
                        <i class="yv-dd-check fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="Motor Yachts" data-label="<%= homeIsEn ? 'Motor Yacht' : 'Motor Yat' %>" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span><%= homeIsEn ? 'Motor Yacht' : 'Motor Yat' %></span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="Gulets" data-label="Gulet" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span>Gulet</span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="Sailing Yachts" data-label="<%= homeIsEn ? 'Sailing Yacht' : 'Yelkenli Yat' %>" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span><%= homeIsEn ? 'Sailing Yacht' : 'Yelkenli Yat' %></span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="Catamarans" data-label="<%= homeIsEn ? 'Catamaran' : 'Katamaran' %>" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span><%= homeIsEn ? 'Catamaran' : 'Katamaran' %></span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="Superyachts" data-label="<%= homeIsEn ? 'Superyacht' : 'Süperyat' %>" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span><%= homeIsEn ? 'Superyacht' : 'Süperyat' %></span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                </div>
            </div>

            <div class="md:col-span-2">
                <button type="submit" class="w-full bg-teal-600 hover:bg-teal-700 text-white py-3.5 px-5 rounded-xl font-bold text-sm transition flex items-center justify-center space-x-2 shadow-lg">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span><%= homeIsEn ? 'Explore Yachts' : 'Yatları Keşfet' %></span>
                </button>
            </div>
        </form>
    </div>
</section>

<section class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-7 grid grid-cols-2 md:grid-cols-4 gap-6 text-sm">
        <div class="flex items-center space-x-3">
            <i class="fa-solid fa-user-check text-teal-600 text-xl"></i>
            <span class="font-bold text-slate-800"><%= homeIsEn ? 'Licensed captains' : 'Lisanslı kaptanlar' %></span>
        </div>
        <div class="flex items-center space-x-3">
            <i class="fa-solid fa-shield-halved text-teal-600 text-xl"></i>
            <span class="font-bold text-slate-800"><%= homeIsEn ? 'Safe vessels' : 'Güvenli tekneler' %></span>
        </div>
        <div class="flex items-center space-x-3">
            <i class="fa-brands fa-whatsapp text-teal-600 text-xl"></i>
            <span class="font-bold text-slate-800"><%= homeIsEn ? 'WhatsApp support' : 'WhatsApp desteği' %></span>
        </div>
        <div class="flex items-center space-x-3">
            <i class="fa-regular fa-calendar-check text-teal-600 text-xl"></i>
            <span class="font-bold text-slate-800"><%= homeIsEn ? 'Free cancellation option' : 'Ücretsiz iptal seçeneği' %></span>
        </div>
    </div>
</section>

<section id="tur-paketleri" class="max-w-7xl mx-auto px-4 sm:px-6 pt-16 space-y-8">
    <div class="flex items-center gap-4">
        <div class="flex-1 h-px bg-slate-200"></div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-[#0B1F3A]"><%= homeIsEn ? 'Tour Packages & What’s Included' : 'Tur Paketleri & Dahil Olanlar' %></h2>
        <div class="flex-1 h-px bg-slate-200"></div>
    </div>

    <% const homeTours = (typeof tours !== 'undefined' && Array.isArray(tours)) ? tours : []; %>
    <% const sortedHomeTours = [...homeTours].sort((a, b) => {
        const aM = String(a.region || '').toLowerCase().includes('marmaris') ? 0 : 1;
        const bM = String(b.region || '').toLowerCase().includes('marmaris') ? 0 : 1;
        return aM - bM;
    }); %>
    <% const fallbackTourImgs = [
        'https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=800&q=80',
        'https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=800&q=80',
        'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=800&q=80'
    ]; %>

    <% if (sortedHomeTours.length === 0) { %>
        <div class="bg-white p-8 rounded-2xl border border-slate-200 text-center text-xs text-slate-500">
            <%= homeIsEn ? 'No tour packages published yet. You can add them from the admin panel.' : 'Henüz yayınlanmış tur paketi bulunmuyor. Admin panelden ekleyebilirsiniz.' %>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
            <% sortedHomeTours.slice(0, 3).forEach((pkg, pIdx) => { %>
                <% const linkedYacht = (typeof yachts !== 'undefined' && Array.isArray(yachts)) ? (yachts.find(y => Number(y.id) === Number(pkg.yachtId)) || yachts[0]) : null; %>
                <% const pkgImg = pkg.image || pkg.img || fallbackTourImgs[pIdx % fallbackTourImgs.length]; %>
                <% const pkgTitle = (homeIsEn && pkg.titleEn) ? pkg.titleEn : pkg.title; %>
                <% const pkgRegion = (homeIsEn && pkg.regionEn) ? pkg.regionEn : pkg.region; %>
                <% const meetingSpot = (homeIsEn && pkg.meetingPointEn) ? pkg.meetingPointEn : (pkg.meetingPoint || (pkgRegion + ' Marina')); %>
                <% const pkgIncluded = (homeIsEn && Array.isArray(pkg.includedEn) && pkg.includedEn.length) ? pkg.includedEn : ((Array.isArray(pkg.included) && pkg.included.length) ? pkg.included : (homeIsEn ? ['Licensed captain and fuel', 'Swimming stops and refreshments'] : ['Lisanslı kaptan ve yakıt', 'Yüzme molaları ve ikramlar'])); %>
                <% const pkgExcluded = (homeIsEn && Array.isArray(pkg.excludedEn) && pkg.excludedEn.length) ? pkg.excludedEn : ((Array.isArray(pkg.excluded) && pkg.excluded.length) ? pkg.excluded : (homeIsEn ? ['Custom menu & airport transfer'] : ['Özel menü & havalimanı transferi'])); %>
                <% const pkgDays = Math.max(1, Number(pkg.durationDays || 1)); %>
                <% const pkgPrice = Math.max(0, Number(pkg.pricePerDay || 0)); %>
                <% const pkgDurLabel = pkg.durationLabel || (pkgDays + (homeIsEn ? (pkgDays === 1 ? ' Day' : ' Days') : ' Gün')); %>
                <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition flex flex-col justify-between">
                    <div>
                        <div class="relative">
                            <img src="<%= pkgImg %>" onerror="fallbackYachtImg(this)" alt="<%= pkgTitle %>" class="w-full h-52 object-cover">
                            <span class="absolute top-3 left-3 bg-[#0B1F3A]/90 text-white text-[10px] font-bold px-3 py-1 rounded-full tracking-wider">
                                <%= (homeIsEn && pkg.badgeEn) ? pkg.badgeEn : (pkg.badge || (homeIsEn ? 'TOUR PACKAGE' : 'TUR PAKETİ')) %>
                            </span>
                        </div>
                        <div class="p-6 space-y-4">
                            <div>
                                <h3 class="text-lg font-extrabold text-slate-900"><%= pkgTitle %></h3>
                                <p class="text-xs text-slate-500 mt-0.5"><i class="fa-solid fa-compass text-teal-600 mr-1"></i><%= pkgRegion %></p>
                            </div>

                            <div class="flex flex-wrap gap-3 text-xs text-slate-600 bg-slate-50 p-3 rounded-xl">
                                <span><i class="fa-regular fa-clock text-teal-600 mr-1"></i><strong><%= homeIsEn ? 'Time:' : 'Saat:' %></strong> <%= pkgDurLabel %></span>
                                <span><i class="fa-solid fa-location-dot text-teal-600 mr-1"></i><strong><%= homeIsEn ? 'Meeting:' : 'Buluşma Noktası:' %></strong> <%= meetingSpot %></span>
                                <span><i class="fa-solid fa-users text-teal-600 mr-1"></i><%= pkg.capacityLabel || (linkedYacht ? (homeIsEn ? ('Up to ' + linkedYacht.guests + ' guests') : ('En fazla ' + linkedYacht.guests + ' kişi')) : (homeIsEn ? 'Private Group' : 'Özel Grup')) %></span>
                            </div>

                            <div class="space-y-1.5">
                                <div class="text-[11px] font-bold uppercase text-emerald-700 tracking-wider"><%= homeIsEn ? 'Included in Package' : 'Fiyata Dahil Olanlar' %></div>
                                <% pkgIncluded.forEach(item => { %>
                                    <div class="text-xs text-slate-700 flex items-start space-x-2">
                                        <i class="fa-solid fa-check text-emerald-600 mt-0.5"></i>
                                        <span><%= item %></span>
                                    </div>
                                <% }) %>
                            </div>

                            <div class="space-y-1 pt-2 border-t border-slate-100">
                                <div class="text-[11px] font-bold uppercase text-slate-400 tracking-wider"><%= homeIsEn ? 'Extra / Not Included' : 'Ekstra / Dahil Değil' %></div>
                                <% pkgExcluded.forEach(ex => { %>
                                    <div class="text-xs text-slate-500 flex items-start space-x-2">
                                        <i class="fa-solid fa-circle-info text-slate-400 mt-0.5"></i>
                                        <span><%= ex %></span>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                    <div class="px-6 py-4 bg-slate-50/70 border-t border-slate-100 flex items-center justify-between">
                        <div>
