    <div class="lg:col-span-6 space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-wider text-teal-600">Merak Edilenler</span>
        <h2 class="text-2xl font-extrabold text-[#0B1F3A]">Sıkça Sorulan Sorular</h2>

        <div class="space-y-3" id="faqList">
            <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
