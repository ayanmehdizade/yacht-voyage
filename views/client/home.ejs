<%- include('../partials/header') %>

<style>
    #homeDateInput::-webkit-calendar-picker-indicator {
        display: none;
        -webkit-appearance: none;
    }
</style>

<!-- HERO & ARAMA ÇUBUĞU -->
<section class="relative bg-[#0B1F3A] text-white overflow-x-clip">
    <img src="https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=1200&q=85"
         onerror="fallbackYachtImg(this)"
         alt="YachtVoyage Hero"
         class="absolute inset-0 w-full h-full object-cover opacity-35">
    <div class="absolute inset-0 bg-gradient-to-r from-[#0B1F3A] via-[#0B1F3A]/85 to-transparent"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-24 relative z-10">
        <div class="max-w-2xl space-y-4">
            <h1 class="text-4xl md:text-6xl font-extrabold leading-[1.1] tracking-tight">
                Eşsiz Yat Deneyimini Keşfedin
            </h1>
            <p class="text-slate-200 text-base md:text-lg leading-relaxed">
                Göcek, Marmaris ve Fethiye koylarında özel yat kiralama, günlük tur paketleri ve şeffaf içerik bilgisi.
            </p>
        </div>

        <form action="/yachts" method="GET" class="mt-9 bg-white text-slate-900 p-3 md:p-3.5 rounded-2xl shadow-2xl grid grid-cols-1 md:grid-cols-12 gap-2 items-center max-w-6xl">
            <div class="yv-dropdown relative md:col-span-3 px-3.5 py-2 rounded-xl hover:bg-slate-50 transition">
                <input type="hidden" name="location" value="Göcek">
                <button type="button" class="yv-dd-trigger w-full text-left flex items-center justify-between focus:outline-none">
                    <div>
                        <span class="block text-[10px] font-extrabold tracking-wider text-slate-400 uppercase">Kalkış Noktası</span>
                        <span class="flex items-center space-x-2 mt-0.5 text-sm font-bold text-slate-900">
                            <i class="fa-solid fa-location-dot text-teal-600 text-xs"></i>
                            <span class="yv-dd-label">Göcek</span>
                        </span>
                    </div>
                    <i class="yv-dd-chevron fa-solid fa-chevron-down text-xs text-slate-400 transition-transform duration-200"></i>
                </button>

                <% const depList = (typeof departurePoints !== 'undefined' && Array.isArray(departurePoints) && departurePoints.length) ? departurePoints : [
                    { name: 'Göcek', desc: 'Koylar & D-Marin kalkış' },
                    { name: 'Marmaris', desc: 'Netsel Marina & Hisarönü' },
                    { name: 'Fethiye', desc: 'Ece Marina & Ölüdeniz' },
                    { name: 'Bodrum', desc: 'Yalıkavak & Türkbükü' }
                ]; %>
                <div class="yv-dd-menu hidden max-h-60 overflow-y-auto left-0 right-0 top-[calc(100%+8px)] absolute bg-white rounded-2xl shadow-2xl border border-slate-100 p-1.5 z-50">
                    <% depList.forEach(function(dp, idx) { %>
                        <button type="button" data-value="<%= dp.name %>" data-label="<%= dp.name %>" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left <%= idx === 0 ? 'bg-slate-100 font-bold text-[#0B1F3A]' : 'text-slate-700' %> hover:bg-slate-50 transition">
                            <div>
                                <div class="text-xs <%= idx === 0 ? '' : 'font-semibold' %>"><%= dp.name %></div>
                                <div class="text-[10px] font-normal text-slate-400"><%= dp.desc || '' %></div>
                            </div>
                            <i class="yv-dd-check <%= idx === 0 ? '' : 'hidden' %> fa-solid fa-check text-xs text-teal-600"></i>
                        </button>
                    <% }) %>
                    <button type="button" data-value="all" data-label="Tüm Noktalar" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition">
                        <div>
                            <div class="text-xs font-semibold">Tüm Noktalar</div>
                            <div class="text-[10px] font-normal text-slate-400">Tüm Ege &amp; Akdeniz rotaları</div>
                        </div>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                </div>
            </div>

            <div class="relative md:col-span-3 px-3.5 py-2 rounded-xl hover:bg-slate-50 transition md:border-l md:border-slate-200">
                <label for="homeDateInput" class="block text-[10px] font-extrabold tracking-wider text-slate-400 uppercase">Tarih</label>

                <div class="flex items-center space-x-2 mt-0.5">
                    <i class="fa-regular fa-calendar text-teal-600 text-xs"></i>
                    <input type="date" id="homeDateInput" name="checkIn" data-no-flatpickr="true" value="2026-06-25" class="text-sm font-bold text-slate-900 focus:outline-none w-full bg-transparent cursor-pointer">
                </div>

                <div id="homeDatePopover" class="hidden left-0 top-[calc(100%+10px)] absolute w-[340px] max-w-[92vw] bg-white border border-slate-200 rounded-2xl shadow-2xl p-4 space-y-3 z-50 overflow-hidden text-slate-900">
                    <div class="flex items-center justify-between">
                        <button type="button" id="homeCalPrev" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-700 font-bold shrink-0">‹</button>
                        <div id="homeCalTitle" class="text-sm font-extrabold text-[#0B1F3A] text-center">Haziran 2026</div>
                        <button type="button" id="homeCalNext" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-700 font-bold shrink-0">›</button>
                    </div>

                    <div class="grid grid-cols-[repeat(7,minmax(0,1fr))] gap-1 text-center text-[11px] font-bold text-slate-400">
                        <div>Pzt</div>
                        <div>Sal</div>
                        <div>Çar</div>
                        <div>Per</div>
                        <div>Cum</div>
                        <div>Cmt</div>
                        <div>Paz</div>
                    </div>

                    <div id="homeCalGrid" class="grid grid-cols-[repeat(7,minmax(0,1fr))] gap-1 text-center text-xs"></div>

                    <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-[11px] font-bold px-1">
                        <span class="inline-flex items-center gap-1.5 text-emerald-700">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block shrink-0"></span>
                            <span>Yeşil: Boş</span>
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-rose-700">
                            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 inline-block shrink-0"></span>
                            <span>Kırmızı: Dolu</span>
                        </span>
                    </div>
                </div>
            </div>

            <div class="yv-dropdown relative md:col-span-2 px-3.5 py-2 rounded-xl hover:bg-slate-50 transition md:border-l md:border-slate-200">
                <input type="hidden" name="guests" value="">
                <button type="button" class="yv-dd-trigger w-full text-left flex items-center justify-between focus:outline-none">
                    <div>
                        <span class="block text-[10px] font-extrabold tracking-wider text-slate-400 uppercase">Kişi Sayısı</span>
                        <span class="flex items-center space-x-2 mt-0.5 text-sm font-bold text-slate-900">
                            <i class="fa-solid fa-users text-teal-600 text-xs"></i>
                            <span class="yv-dd-label">Tümü</span>
                        </span>
                    </div>
                    <i class="yv-dd-chevron fa-solid fa-chevron-down text-xs text-slate-400 transition-transform duration-200"></i>
                </button>

                <div class="yv-dd-menu hidden max-h-60 overflow-y-auto left-0 md:-left-4 right-0 md:w-52 top-[calc(100%+8px)] absolute bg-white rounded-2xl shadow-2xl border border-slate-100 p-1.5 z-50">
                    <button type="button" data-value="" data-label="Tümü" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left bg-slate-100 font-bold text-[#0B1F3A] hover:bg-slate-50 transition text-xs">
                        <span>Tümü</span>
                        <i class="yv-dd-check fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="1-6" data-label="1 - 6 Kişi" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span>1 - 6 Kişi</span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="7-12" data-label="7 - 12 Kişi" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span>7 - 12 Kişi</span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="13+" data-label="13+ Kişi" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span>13+ Kişi</span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                </div>
            </div>

            <div class="yv-dropdown relative md:col-span-2 px-3.5 py-2 rounded-xl hover:bg-slate-50 transition md:border-l md:border-slate-200">
                <input type="hidden" name="category" value="all">
                <button type="button" class="yv-dd-trigger w-full text-left flex items-center justify-between focus:outline-none">
                    <div>
                        <span class="block text-[10px] font-extrabold tracking-wider text-slate-400 uppercase">Yat Tipi</span>
                        <span class="flex items-center space-x-2 mt-0.5 text-sm font-bold text-slate-900">
                            <i class="fa-solid fa-anchor text-teal-600 text-xs"></i>
                            <span class="yv-dd-label">Tümü</span>
                        </span>
                    </div>
                    <i class="yv-dd-chevron fa-solid fa-chevron-down text-xs text-slate-400 transition-transform duration-200"></i>
                </button>

                <div class="yv-dd-menu hidden max-h-60 overflow-y-auto left-0 md:-left-6 right-0 md:w-56 top-[calc(100%+8px)] absolute bg-white rounded-2xl shadow-2xl border border-slate-100 p-1.5 z-50">
                    <button type="button" data-value="all" data-label="Tümü" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left bg-slate-100 font-bold text-[#0B1F3A] hover:bg-slate-50 transition text-xs">
                        <span>Tümü</span>
                        <i class="yv-dd-check fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="Motor Yachts" data-label="Motor Yat" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span>Motor Yat</span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="Gulets" data-label="Gulet" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span>Gulet</span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="Sailing Yachts" data-label="Yelkenli Yat" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span>Yelkenli Yat</span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="Catamarans" data-label="Katamaran" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span>Katamaran</span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                    <button type="button" data-value="Superyachts" data-label="Süperyat" class="yv-dd-option w-full px-3.5 py-2.5 rounded-xl flex items-center justify-between text-left text-slate-700 hover:bg-slate-50 transition text-xs">
                        <span>Süperyat</span>
                        <i class="yv-dd-check hidden fa-solid fa-check text-xs text-teal-600"></i>
                    </button>
                </div>
            </div>

            <div class="md:col-span-2">
                <button type="submit" class="w-full bg-teal-600 hover:bg-teal-700 text-white py-3.5 px-5 rounded-xl font-bold text-sm transition flex items-center justify-center space-x-2 shadow-lg">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span>Yatları Keşfet</span>
                </button>
            </div>
        </form>
    </div>
</section>

<!-- GÜVEN ROZETLERİ -->
<section class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-7 grid grid-cols-2 md:grid-cols-4 gap-6 text-sm">
        <div class="flex items-center space-x-3">
            <i class="fa-solid fa-user-check text-teal-600 text-xl"></i>
            <span class="font-bold text-slate-800">Lisanslı kaptanlar</span>
        </div>
        <div class="flex items-center space-x-3">
            <i class="fa-solid fa-shield-halved text-teal-600 text-xl"></i>
            <span class="font-bold text-slate-800">Güvenli tekneler</span>
        </div>
        <div class="flex items-center space-x-3">
            <i class="fa-brands fa-whatsapp text-teal-600 text-xl"></i>
            <span class="font-bold text-slate-800">WhatsApp desteği</span>
        </div>
        <div class="flex items-center space-x-3">
            <i class="fa-regular fa-calendar-check text-teal-600 text-xl"></i>
            <span class="font-bold text-slate-800">Ücretsiz iptal seçeneği</span>
        </div>
    </div>
</section>

<!-- TUR PAKETLERİ VE DAHİL OLANLAR -->
<section id="tur-paketleri" class="max-w-7xl mx-auto px-4 sm:px-6 pt-16 space-y-8">
    <div class="flex items-center gap-4">
        <div class="flex-1 h-px bg-slate-200"></div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-[#0B1F3A]">Tur Paketleri &amp; Dahil Olanlar</h2>
        <div class="flex-1 h-px bg-slate-200"></div>
    </div>

    <% const homeTours = (typeof tours !== 'undefined' && Array.isArray(tours)) ? tours : []; %>

    <% if (homeTours.length === 0) { %>
        <div class="bg-white p-8 rounded-2xl border border-slate-200 text-center text-xs text-slate-500">
            Henüz yayınlanmış tur paketi bulunmuyor. Admin panelden ekleyebilirsiniz.
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
            <% homeTours.slice(0, 3).forEach(pkg => { %>
                <% const linkedYacht = (typeof yachts !== 'undefined' && Array.isArray(yachts)) ? (yachts.find(y => Number(y.id) === Number(pkg.yachtId)) || yachts[0]) : null; %>
                <% const pkgImg = pkg.img || (linkedYacht && linkedYacht.images && linkedYacht.images[0]) || 'https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=800&q=80'; %>
                <% const pkgIncluded = (Array.isArray(pkg.included) && pkg.included.length) ? pkg.included : ['Lisanslı kaptan ve yakıt', 'Yüzme molaları ve ikramlar']; %>
                <% const pkgExcluded = (Array.isArray(pkg.excluded) && pkg.excluded.length) ? pkg.excluded : ['Özel menü & havalimanı transferi']; %>
                <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition flex flex-col justify-between">
                    <div>
                        <div class="relative">
                            <img src="<%= pkgImg %>" onerror="fallbackYachtImg(this)" alt="<%= pkg.title %>" class="w-full h-52 object-cover">
                            <span class="absolute top-3 left-3 bg-[#0B1F3A]/90 text-white text-[10px] font-bold px-3 py-1 rounded-full tracking-wider">
                                <%= pkg.badge || 'TUR PAKETİ' %>
                            </span>
                        </div>
                        <div class="p-6 space-y-4">
                            <div>
                                <h3 class="text-lg font-extrabold text-slate-900"><%= pkg.title %></h3>
                                <p class="text-xs text-slate-500 mt-0.5"><i class="fa-solid fa-compass text-teal-600 mr-1"></i><%= pkg.region %></p>
                            </div>

                            <div class="flex flex-wrap gap-3 text-xs text-slate-600 bg-slate-50 p-3 rounded-xl">
                                <span><i class="fa-regular fa-clock text-teal-600 mr-1"></i><%= pkg.durationLabel || (pkg.durationDays + ' Gün') %></span>
                                <span><i class="fa-solid fa-users text-teal-600 mr-1"></i><%= pkg.capacityLabel || (linkedYacht ? ('En fazla ' + linkedYacht.guests + ' kişi') : 'Özel Grup') %></span>
                            </div>

                            <div class="space-y-1.5">
                                <div class="text-[11px] font-bold uppercase text-emerald-700 tracking-wider">Pakete Dahil Olanlar</div>
                                <% pkgIncluded.forEach(item => { %>
                                    <div class="text-xs text-slate-700 flex items-start space-x-2">
                                        <i class="fa-solid fa-check text-emerald-600 mt-0.5"></i>
                                        <span><%= item %></span>
                                    </div>
                                <% }) %>
                            </div>

                            <div class="space-y-1 pt-2 border-t border-slate-100">
                                <div class="text-[11px] font-bold uppercase text-slate-400 tracking-wider">Ekstra / Dahil Değil</div>
                                <% pkgExcluded.forEach(ex => { %>
                                    <div class="text-xs text-slate-500 flex items-start space-x-2">
                                        <i class="fa-solid fa-circle-info text-slate-400 mt-0.5"></i>
                                        <span><%= ex %></span>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                    <div class="px-6 py-4 bg-slate-50/70 border-t border-slate-100 flex items-center justify-between">
                        <div>
                            <span class="text-[11px] text-slate-400 block">Başlangıç</span>
                            <span class="font-extrabold text-teal-700 text-lg"><%= Number(pkg.pricePerDay || 0).toLocaleString() %> €</span>
                        </div>
                        <a href="/yachts/<%= linkedYacht ? linkedYacht.id : '' %>" class="bg-[#0B1F3A] hover:bg-sky-900 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition">
                            İncele &amp; Kirala →
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</section>

<!-- İNTERAKTİF ROTA & KOY REHBERİ -->
<section id="rotalar" data-home-section class="hidden max-w-7xl mx-auto px-4 sm:px-6 pt-10 space-y-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <span class="text-xs font-extrabold uppercase tracking-wider text-teal-600">Mavi Yolculuk Rotaları</span>
            <h2 class="text-2xl md:text-3xl font-extrabold text-[#0B1F3A] mt-1">Popüler Koy &amp; Liman Rehberi</h2>
        </div>
        <div class="flex flex-wrap gap-2" id="routeTabs">
            <button type="button" data-route="gocek" class="route-tab px-4 py-2 rounded-xl text-xs font-bold bg-[#0B1F3A] text-white transition">Göcek 12 Adalar</button>
            <button type="button" data-route="marmaris" class="route-tab px-4 py-2 rounded-xl text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition">Marmaris &amp; Hisarönü</button>
            <button type="button" data-route="fethiye" class="route-tab px-4 py-2 rounded-xl text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition">Fethiye &amp; Ölüdeniz</button>
            <button type="button" data-route="bodrum" class="route-tab px-4 py-2 rounded-xl text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition">Bodrum Koyları</button>
        </div>
    </div>

    <div id="routeCard" class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden grid grid-cols-1 lg:grid-cols-12 items-stretch">
        <div class="lg:col-span-5 h-60 lg:h-[310px] relative overflow-hidden">
            <img id="routeImg" src="https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=900&q=80" onerror="fallbackYachtImg(this)" alt="Rota" class="w-full h-full object-cover">
            <span id="routeBadge" class="absolute top-4 left-4 bg-[#0B1F3A]/90 text-white text-[11px] font-bold px-3.5 py-1.5 rounded-full">D-Marin Göcek Kalkışlı</span>
        </div>
        <div class="lg:col-span-7 p-6 lg:px-8 lg:py-6 flex flex-col justify-between">
            <div class="space-y-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <h3 id="routeTitle" class="text-xl font-extrabold text-slate-900">Göcek 12 Adalar &amp; Bedri Rahmi Koyu</h3>
                    <span id="routeDuration" class="text-xs font-bold text-teal-700 bg-teal-50 px-3 py-1 rounded-lg"><i class="fa-regular fa-compass mr-1"></i>1 - 3 Gün Önerilir</span>
                </div>
                <p id="routeDesc" class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                    Rüzgâra kapalı sakin koyları, çam ormanlarıyla çevrili turkuaz suları ve kısa seyir mesafeleriyle hem günübirlik hem haftalık mavi yolculukların en gözde rotası.
                </p>
                <div class="pt-1">
                    <span class="block text-[10px] font-bold uppercase text-slate-400 tracking-wider mb-2">Öne Çıkan Duraklar</span>
                    <div id="routeStops" class="flex flex-wrap gap-2 text-xs">
                        <span class="bg-slate-100 text-slate-700 font-semibold px-3 py-1.5 rounded-lg">1. Yassıca Adaları</span>
                        <span class="bg-slate-100 text-slate-700 font-semibold px-3 py-1.5 rounded-lg">2. Bedri Rahmi Koyu</span>
                        <span class="bg-slate-100 text-slate-700 font-semibold px-3 py-1.5 rounded-lg">3. Kleopatra Hamamı</span>
                        <span class="bg-slate-100 text-slate-700 font-semibold px-3 py-1.5 rounded-lg">4. Tersane Adası</span>
                    </div>
                </div>
            </div>
            <div class="pt-4 mt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
                <div id="routeRec" class="text-xs text-slate-500">Önerilen Tekne Tipi: <strong class="text-slate-800">Katamaran &amp; Motor Yat</strong></div>
