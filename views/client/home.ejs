<div id="homeBookedData" data-booked='<%- JSON.stringify(typeof homeBookings !== "undefined" ? homeBookings : []) %>' data-today="<%= todayIso %>" class="hidden"></div>

<script>
    (function () {
        const isEnHome = document.documentElement.dataset.yvEn === '1';
        const bookedEl = document.getElementById('homeBookedData');
        const todayStr = (bookedEl && bookedEl.dataset.today) ? bookedEl.dataset.today : new Date().toISOString().slice(0, 10);
        let bookedRanges = [];
        if (bookedEl && bookedEl.dataset.booked) {
            try {
                bookedRanges = JSON.parse(bookedEl.dataset.booked);
            } catch (e) {
                bookedRanges = [];
            }
        }
        window.HOME_BOOKED_RANGES = bookedRanges;

        const dateInput = document.getElementById('homeDateInput');
        const clearBtn = document.getElementById('homeDateClear');
        const popover = document.getElementById('homeDatePopover');
        const gridEl = document.getElementById('homeCalGrid');
        const titleEl = document.getElementById('homeCalTitle');
        const prevBtn = document.getElementById('homeCalPrev');
        const nextBtn = document.getElementById('homeCalNext');

        const months = isEnHome
            ? ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
            : ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];

        const baseDate = new Date(todayStr + 'T00:00:00');
        let curYear = isNaN(baseDate.getTime()) ? 2026 : baseDate.getFullYear();
        let curMonth = isNaN(baseDate.getTime()) ? 10 : baseDate.getMonth();

        function isBooked(ymd) {
            return bookedRanges.some(function (r) {
                return ymd >= r.checkIn && ymd < r.checkOut;
            });
        }

        function isPast(ymd) {
            return ymd < todayStr;
        }

        function renderCal() {
            if (!gridEl || !titleEl) return;
            titleEl.textContent = months[curMonth] + ' ' + curYear;
            gridEl.innerHTML = '';

            const firstDay = new Date(curYear, curMonth, 1);
            let startOffset = firstDay.getDay() - 1;
            if (startOffset < 0) startOffset = 6;
            const daysCount = new Date(curYear, curMonth + 1, 0).getDate();

            for (let i = 0; i < startOffset; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = 'h-8';
                gridEl.appendChild(emptyCell);
            }

            for (let d = 1; d <= daysCount; d++) {
                const ymd = curYear + '-' + String(curMonth + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
                const past = isPast(ymd);
                const booked = !past && isBooked(ymd);

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = d;

                if (past) {
                    btn.className = 'w-full h-8 rounded-lg font-medium bg-slate-100 text-slate-300 cursor-not-allowed flex items-center justify-center';
                } else if (booked) {
                    btn.className = 'w-full h-8 rounded-lg font-extrabold bg-rose-500 text-white cursor-not-allowed flex items-center justify-center';
                } else {
                    const selected = dateInput && dateInput.value === ymd;
                    btn.className = selected
                        ? 'w-full h-8 rounded-lg font-extrabold bg-[#0B1F3A] text-white ring-2 ring-teal-500 flex items-center justify-center'
                        : 'w-full h-8 rounded-lg font-bold bg-emerald-100 text-emerald-800 hover:bg-emerald-500 hover:text-white transition flex items-center justify-center';

                    btn.addEventListener('click', function () {
                        if (dateInput) {
                            dateInput.value = ymd;
                            dateInput.dispatchEvent(new Event('change', { bubbles: true }));
                        }
                        if (popover) popover.classList.add('hidden');
                    });
                }

                gridEl.appendChild(btn);
            }
        }

        if (clearBtn && dateInput) {
            clearBtn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                dateInput.value = '';
                renderCal();
            });
        }

        if (dateInput && popover) {
            dateInput.addEventListener('mousedown', function (e) {
                e.preventDefault();
                document.querySelectorAll('.yv-dd-menu').forEach(function (m) { m.classList.add('hidden'); });
                const parsed = dateInput.value ? new Date(dateInput.value + 'T00:00:00') : baseDate;
                if (parsed && !isNaN(parsed.getTime())) {
                    curYear = parsed.getFullYear();
                    curMonth = parsed.getMonth();
                }
                renderCal();
                popover.classList.toggle('hidden');
            });

            if (prevBtn) {
                prevBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    curMonth--;
                    if (curMonth < 0) { curMonth = 11; curYear--; }
                    renderCal();
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    curMonth++;
                    if (curMonth > 11) { curMonth = 0; curYear++; }
                    renderCal();
                });
            }

            document.addEventListener('click', function (e) {
                if (!popover.contains(e.target) && e.target !== dateInput) {
                    popover.classList.add('hidden');
                }
            });
        }

        renderCal();

        function switchHomeSection(targetId) {
            const sections = document.querySelectorAll('[data-home-section]');
            if (!sections.length) return;

            sections.forEach(function (sec) {
                if (targetId === 'all' || sec.id === targetId) {
                    sec.classList.remove('hidden');
                } else {
                    sec.classList.add('hidden');
                }
            });

            document.querySelectorAll('.section-switch-btn').forEach(function (btn) {
                const isAll = btn.dataset.sectionSwitch === 'all';
                const active = btn.dataset.sectionSwitch === targetId;
                if (isAll) {
                    btn.className = active
                        ? 'section-switch-btn ml-auto px-4 py-2 rounded-xl text-xs font-bold text-white bg-teal-600 transition'
                        : 'section-switch-btn ml-auto px-4 py-2 rounded-xl text-xs font-bold text-teal-700 bg-teal-50 hover:bg-teal-100 transition';
                } else {
                    btn.className = active
                        ? 'section-switch-btn px-4 py-2 rounded-xl text-xs font-bold bg-[#0B1F3A] text-white transition'
                        : 'section-switch-btn px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 transition';
                }
            });
        }

        document.querySelectorAll('[data-section-switch]').forEach(function (el) {
            el.addEventListener('click', function (e) {
                const target = this.dataset.sectionSwitch;
                if (document.getElementById(target) || target === 'all') {
                    e.preventDefault();
                    switchHomeSection(target);
                    const mobileMenu = document.getElementById('mobileMenu');
                    if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
                        mobileMenu.classList.add('hidden');
                    }
                }
            });
        });

        const routesData = isEnHome ? {
            gocek: {
                title: 'Göcek 12 Islands & Bedri Rahmi Cove',
                badge: 'Departure from D-Marin Göcek',
                duration: '1 - 3 Days Recommended',
                desc: 'A favorite route for both daily and weekly cruises thanks to wind-sheltered coves, turquoise pine-lined waters and short sailing distances.',
                stops: ['1. Yassıca Islands', '2. Bedri Rahmi Cove', '3. Cleopatra Bath', '4. Tersane Island'],
                rec: 'Catamaran & Motor Yacht',
                img: 'https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=900&q=80',
                link: '/yachts?location=G%C3%B6cek'
            },
            marmaris: {
                title: 'Marmaris, Bozburun & Hisarönü Gulf',
                badge: 'Departure from Netsel Marina',
                duration: '2 - 5 Days Recommended',
                desc: 'A peaceful and comfortable cruising experience along the Hisarönü line famous for clear coves, fishing villages and sunset views.',
                stops: ['1. Paradise Island', '2. Kumlubük', '3. Selimiye Cove', '4. Bencik Cove'],
                rec: 'Gulet & Superyacht',
                img: 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=900&q=80',
                link: '/yachts?location=Marmaris'
            },
            fethiye: {
                title: 'Fethiye, Ölüdeniz & Butterfly Valley',
                badge: 'Departure from Ece Marina',
                duration: '1 - 4 Days Recommended',
                desc: 'A favorite for nature and swimming lovers with hidden coves in the shade of high cliffs, Aquarium Cove and St. Nicholas Island.',
                stops: ['1. Kızıl Island', '2. Butterfly Valley', '3. St. Nicholas Island', '4. Tarzan Cove'],
                rec: 'Motor Yacht & Sailing Yacht',
                img: 'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=900&q=80',
                link: '/yachts?location=Fethiye'
            },
            bodrum: {
                title: 'Bodrum, Paradise Cove & Orak Island',
                badge: 'Departure from Yalıkavak & Bodrum',
                duration: '1 - 7 Days Recommended',
                desc: 'A lively and upscale Aegean route with Maldives-blue waters around Orak Island and exclusive beach club stops.',
                stops: ['1. Aquarium Cove', '2. Orak Island', '3. Paradise Cove', '4. Türkbükü'],
                rec: 'Superyacht & Motor Yacht',
                img: 'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=900&q=80',
                link: '/yachts?location=Bodrum'
            }
        } : {
            gocek: {
                title: 'Göcek 12 Adalar & Bedri Rahmi Koyu',
                badge: 'D-Marin Göcek Kalkışlı',
                duration: '1 - 3 Gün Önerilir',
                desc: 'Rüzgâra kapalı sakin koyları, çam ormanlarıyla çevrili turkuaz suları ve kısa seyir mesafeleriyle hem günübirlik hem haftalık mavi yolculukların en gözde rotası.',
                stops: ['1. Yassıca Adaları', '2. Bedri Rahmi Koyu', '3. Kleopatra Hamamı', '4. Tersane Adası'],
                rec: 'Katamaran & Motor Yat',
                img: 'https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=900&q=80',
                link: '/yachts?location=G%C3%B6cek'
            },
            marmaris: {
                title: 'Marmaris, Bozburun & Hisarönü Körfezi',
                badge: 'Netsel Marina Kalkışlı',
                duration: '2 - 5 Gün Önerilir',
                desc: 'Berrak koyları, balıkçı köyleri ve gün batımı manzaralarıyla ünlü Hisarönü hattında huzurlu ve konforlu bir seyir deneyimi.',
                stops: ['1. Cennet Adası', '2. Kumlubük', '3. Selimiye Koyu', '4. Bencik Koyu'],
                rec: 'Gulet & Süperyat',
                img: 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=900&q=80',
                link: '/yachts?location=Marmaris'
            },
            fethiye: {
                title: 'Fethiye, Ölüdeniz & Kelebekler Vadisi',
                badge: 'Ece Marina Kalkışlı',
                duration: '1 - 4 Gün Önerilir',
                desc: 'Yüksek kayalıkların gölgesindeki gizli koylar, Akvaryum Koyu ve St. Nicholas Adası ile doğa ve yüzme tutkunlarının favorisi.',
                stops: ['1. Kızıl Ada', '2. Kelebekler Vadisi', '3. St. Nicholas Adası', '4. Tarzan Koyu'],
                rec: 'Motor Yat & Yelkenli Yat',
                img: 'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=900&q=80',
                link: '/yachts?location=Fethiye'
            },
            bodrum: {
                title: 'Bodrum, Cennet Koyu & Orak Adası',
                badge: 'Yalıkavak & Bodrum Kalkışlı',
                duration: '1 - 7 Gün Önerilir',
                desc: 'Maldivler rengindeki Orak Adası suları ve seçkin beach club duraklarıyla lüks ve dinamik bir Ege rotası.',
                stops: ['1. Akvaryum Koyu', '2. Orak Adası', '3. Cennet Koyu', '4. Türkbükü'],
                rec: 'Süperyat & Motor Yat',
                img: 'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=900&q=80',
                link: '/yachts?location=Bodrum'
            }
        };

        document.querySelectorAll('.route-tab').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const key = this.dataset.route;
                const data = routesData[key];
                if (!data) return;

                document.querySelectorAll('.route-tab').forEach(function (t) {
                    t.className = 'route-tab px-4 py-2 rounded-xl text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition';
                });
                this.className = 'route-tab px-4 py-2 rounded-xl text-xs font-bold bg-[#0B1F3A] text-white transition';

                const routeImgEl = document.getElementById('routeImg');
                if (routeImgEl) {
                    delete routeImgEl.dataset.fallbackApplied;
                    routeImgEl.src = data.img;
                }
                document.getElementById('routeTitle').innerText = data.title;
                document.getElementById('routeBadge').innerText = data.badge;
                document.getElementById('routeDuration').innerHTML = '<i class="fa-regular fa-compass mr-1"></i>' + data.duration;
                document.getElementById('routeDesc').innerText = data.desc;
                document.getElementById('routeLink').href = data.link;
                const recPrefix = isEnHome ? 'Recommended Yacht Type: ' : 'Önerilen Tekne Tipi: ';
                document.getElementById('routeRec').innerHTML = recPrefix + '<strong class="text-slate-800">' + data.rec + '</strong>';
                document.getElementById('routeStops').innerHTML = data.stops.map(function (s) {
                    return '<span class="bg-slate-100 text-slate-700 font-semibold px-3 py-1.5 rounded-lg">' + s + '</span>';
                }).join('');
            });
        });

        document.querySelectorAll('.faq-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const ans = this.nextElementSibling;
                const icon = this.querySelector('i');
                const isOpen = !ans.classList.contains('hidden');
                document.querySelectorAll('.faq-ans').forEach(function (a) { a.classList.add('hidden'); });
                document.querySelectorAll('.faq-btn i').forEach(function (ic) { ic.classList.remove('rotate-45'); });
                if (!isOpen) {
                    ans.classList.remove('hidden');
                    if (icon) icon.classList.add('rotate-45');
                }
            });
        });
    })();
</script>

