<%- include('../partials/header') %>

<% const mbIsEn = (typeof isEn !== 'undefined') ? Boolean(isEn) : (typeof lang !== 'undefined' && lang === 'en'); %>
<% const emailVal = (typeof email !== 'undefined' && email) ? email : ''; %>
<% const displayMsg = (typeof msg !== 'undefined' && msg) ? msg : ''; %>
<% const displayErr = (typeof errMsg !== 'undefined' && errMsg) ? errMsg : ''; %>
<% const extrasTrToEn = {
    'VIP Havalimanı Transferi': 'VIP Airport Transfer',
    'Özel Şef & Gurme Menü': 'Private Chef & Gourmet Menu',
    'Jet Ski & Seabob Paketi': 'Jet Ski & Seabob Package',
    'Seabob & Su Sporları Paketi': 'Seabob & Water Sports Package'
}; %>

<main class="max-w-3xl mx-auto px-4 sm:px-6 py-14 space-y-8">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-8 text-center space-y-4">
        <div class="w-14 h-14 rounded-2xl bg-sky-50 text-[#0B1F3A] flex items-center justify-center mx-auto text-2xl">
            <i class="fa-solid fa-ticket"></i>
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-[#0B1F3A]"><%= mbIsEn ? 'Booking Lookup' : 'Rezervasyon Sorgulama' %></h1>
        <p class="text-slate-500 text-sm">
            <%= mbIsEn
                ? 'For your security, enter both your PNR code and booking email address to verify your session and view your reservation.'
                : 'Güvenliğiniz için oturum doğrulamasıyla rezervasyon detaylarını görüntülemek adına PNR kodunuzu ve rezervasyon e-posta adresinizi birlikte girin.' %>
        </p>

        <form action="/my-booking" method="POST" autocomplete="off" class="grid grid-cols-1 sm:grid-cols-12 gap-3 max-w-2xl mx-auto pt-2 text-left">
            <div class="sm:col-span-5">
                <label class="block text-[10px] font-bold uppercase text-slate-400 mb-1"><%= mbIsEn ? 'PNR Code *' : 'PNR Kodu *' %></label>
                <input type="text" name="pnr" value="<%= pnr || '' %>" placeholder="<%= mbIsEn ? 'E.g. YV2026-2841' : 'Örn: YV2026-2841' %>" required class="w-full p-3.5 text-sm font-mono uppercase border border-slate-200 rounded-xl focus:outline-none focus:border-[#0B1F3A]">
            </div>
            <div class="sm:col-span-5">
                <label class="block text-[10px] font-bold uppercase text-slate-400 mb-1"><%= mbIsEn ? 'Email Address *' : 'E-posta Adresi *' %></label>
                <input type="email" name="email" value="<%= emailVal %>" placeholder="<%= mbIsEn ? 'example@mail.com' : 'ornek@mail.com' %>" required class="w-full p-3.5 text-sm border border-slate-200 rounded-xl focus:outline-none focus:border-[#0B1F3A]">
            </div>
            <div class="sm:col-span-2 flex items-end">
                <button type="submit" class="w-full bg-[#0B1F3A] hover:bg-sky-900 text-white px-5 py-3.5 rounded-xl font-bold text-sm transition">
                    <%= mbIsEn ? 'Search' : 'Sorgula' %>
                </button>
            </div>
        </form>
    </div>

    <% if (displayErr) { %>
        <div class="bg-rose-50 border border-rose-200 text-rose-700 px-5 py-4 rounded-2xl text-sm font-semibold">
            <i class="fa-solid fa-circle-exclamation mr-2"></i><%= displayErr %>
        </div>
    <% } %>

    <% if (displayMsg) { %>
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-4 rounded-2xl text-sm font-semibold">
            <i class="fa-solid fa-circle-check mr-2"></i><%= displayMsg %>
        </div>
    <% } %>

    <% if (searched && !booking && !displayErr) { %>
        <div class="bg-rose-50 border border-rose-200 text-rose-700 p-6 rounded-2xl text-center text-sm font-semibold">
            <%= mbIsEn
                ? 'Please verify your PNR code and email address to view this booking.'
                : 'Bu rezervasyonu görüntülemek için PNR kodunuzu ve e-posta adresinizi doğrulayın.' %>
        </div>
    <% } %>

    <% if (booking) { %>
        <% const rawStatus = String(booking.status || ''); %>
        <% const isCancelled = ['İptal Edildi', 'İptal', 'Cancelled'].includes(rawStatus); %>
        <% const isRejected = ['Reddedildi', 'Reddedildi (Hava Muhalefeti)', 'Rejected'].includes(rawStatus); %>
        <% const isApproved = !isCancelled && !isRejected && ['Onaylandı', 'Approved', 'Confirmed'].includes(rawStatus); %>
        <% const isPendingApproval = !isCancelled && !isRejected && !isApproved; %>

        <% const statusLabel = mbIsEn
            ? (isCancelled
                ? 'Cancelled'
                : (isRejected
                    ? 'Rejected'
                    : (isApproved ? 'Approved' : 'Pending Admin Approval')))
            : (isCancelled
                ? 'İptal Edildi'
                : (isRejected
                    ? 'Reddedildi'
                    : (isApproved ? 'Onaylandı' : 'Admin Onayı Bekleniyor'))); %>

        <% const refundedAmt = Number(booking.refundedAmount || 0); %>
        <% const paidAmt = Number(booking.paidAmount || 0); %>
        <% const totalAmt = Number(booking.totalAmount || 0); %>

        <% const payStatusText = mbIsEn
            ? (isCancelled
                ? (refundedAmt > 0
                    ? (booking.refundStatus === 'refunded' ? 'Refund Completed' : 'Refund Issued')
                    : 'No Refund Due')
                : (isRejected
                    ? (paidAmt > 0 ? (refundedAmt > 0 ? 'Refund Issued' : 'Refund Pending') : 'No Charge Taken')
                    : (paidAmt <= 0 ? 'Payment Pending' : (paidAmt >= totalAmt ? 'Paid in Full' : 'Deposit Paid'))))
            : (isCancelled
                ? (refundedAmt > 0
                    ? (booking.refundStatus === 'refunded' ? 'İade Tamamlandı' : 'İade Edildi')
                    : 'İade Gerektirmiyor')
                : (isRejected
                    ? (paidAmt > 0 ? (refundedAmt > 0 ? 'İade Edildi' : 'İade Bekliyor') : 'Tahsilat Yapılmadı')
                    : (paidAmt <= 0 ? 'Ödeme Bekliyor' : (paidAmt >= totalAmt ? 'Tam Ödendi' : 'Ön Ödeme Alındı')))); %>

        <% const daysNum = Number(booking.days || 1); %>
        <% const guestsNum = Number(booking.guests || 1); %>
        <% const portText = (yacht && yacht.location) ? (' (' + yacht.location + ')') : ''; %>
        <% const methodLabel = mbIsEn
            ? ({ 'Kart': 'Card', 'Kredi / Banka Kartı': 'Credit / Debit Card', 'Havale / EFT': 'Bank Transfer / EFT', 'Marinada Ödeme': 'Marina Payment', 'Nakit / Marina Ödemesi': 'Cash / Marina Payment' }[booking.paymentMethod] || booking.paymentMethod || 'Card')
            : (booking.paymentMethod || 'Kart'); %>

        <% const captainName = String(booking.captainName || booking.assignedCaptain || '').trim(); %>
        <% const captainPhone = String(booking.captainPhone || '').trim(); %>
        <% const transferPhone = String(booking.transferPhone || booking.transferContactPhone || booking.assignedTransfer || '').trim(); %>
        <% const transferDriver = String(booking.transferContactName || booking.transferDriver || '').trim(); %>
        <% const boardingInfo = String(booking.boardingDetails || booking.marinaPier || booking.adminNote || '').trim(); %>
        <% const rejectionReasonText = String(booking.rejectionReason || booking.rejectReason || '').trim(); %>
        <% const refundRuleText = String(booking.refundRuleReason || booking.refundPolicyNote || '').trim(); %>
        <% const refundReasonSummary = refundRuleText
            || (refundedAmt > 0 && paidAmt > 0 && refundedAmt < paidAmt
                ? (mbIsEn
                    ? ('Partial refund of €' + refundedAmt.toLocaleString() + ' issued out of €' + paidAmt.toLocaleString() + ' paid.')
                    : ('Ödenen €' + paidAmt.toLocaleString() + ' tutardan €' + refundedAmt.toLocaleString() + ' kısmi/yarım iade uygulandı.'))
                : (refundedAmt > 0
                    ? (mbIsEn
                        ? 'Full paid amount refunded under the cancellation policy.'
                        : 'İptal kuralı kapsamında ödenen tutarın tamamı iade edildi.')
                    : (mbIsEn
                        ? 'No refund issued under the cancellation policy or payment status.'
                        : 'İptal kuralı veya ödeme durumuna göre iade uygulanmadı.'))); %>

        <div class="bg-white rounded-3xl border border-slate-200 shadow-lg p-8 space-y-6">
            <div class="flex flex-wrap justify-between items-center gap-3 border-b border-slate-100 pb-4">
                <div>
                    <span class="text-xs text-slate-400 uppercase font-bold block"><%= mbIsEn ? 'Booking Code' : 'Rezervasyon Kodu' %></span>
                    <span class="text-xl font-mono font-extrabold text-[#0B1F3A]">#<%= booking.id %></span>
                </div>
                <div class="flex flex-wrap gap-2">
                    <span class="px-3.5 py-1.5 rounded-full text-xs font-bold <%= (isCancelled || isRejected) ? 'bg-rose-100 text-rose-700' : (isPendingApproval ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-700') %>">
                        <%= mbIsEn ? 'Booking:' : 'Rezervasyon:' %> <%= statusLabel %>
                    </span>
                    <span class="px-3.5 py-1.5 rounded-full text-xs font-bold <%= paidAmt <= 0 ? 'bg-amber-100 text-amber-800' : 'bg-sky-100 text-sky-800' %>">
                        <%= mbIsEn ? 'Payment:' : 'Ödeme:' %> <%= payStatusText %>
                    </span>
                </div>
            </div>

            <% if (isPendingApproval) { %>
                <div class="bg-amber-50/90 border border-amber-200 rounded-2xl p-4 text-xs text-amber-900 space-y-1">
                    <div class="font-extrabold text-sm flex items-center gap-2">
                        <i class="fa-solid fa-hourglass-half"></i>
                        <span><%= mbIsEn ? 'Awaiting Admin Approval' : 'Admin Onayı Bekleniyor' %></span>
                    </div>
                    <p>
                        <%= mbIsEn
                            ? 'Your request is currently awaiting review by our operations team. Captain assignment, transfer contact number, and boarding pier details will appear here once approved.'
                            : 'Talebiniz operasyon ekibimiz tarafından incelenmek üzere beklemede tutulmaktadır. Onaylandıktan sonra kaptan bilgisi, transfer iletişim numarası ve biniş detayları burada görüntülenecektir.' %>
                    </p>
                </div>
            <% } %>

            <% if (isRejected) { %>
                <div class="bg-rose-50 border border-rose-200 rounded-2xl p-4 text-xs text-rose-900 space-y-1.5">
                    <div class="font-extrabold text-sm flex items-center gap-2 text-rose-800">
                        <i class="fa-solid fa-circle-xmark"></i>
                        <span><%= mbIsEn ? 'Booking Rejected by Operations' : 'Rezervasyon Reddedildi' %></span>
                    </div>
                    <p>
                        <strong><%= mbIsEn ? 'Rejection Reason:' : 'Red Sebebi:' %></strong>
                        <%= rejectionReasonText || (mbIsEn ? 'Weather conditions or operational unavailability.' : 'Hava koşulları veya operasyonel uygunsuzluk.') %>
                    </p>
                    <% if (refundRuleText || refundedAmt > 0) { %>
                        <p class="text-rose-800 font-semibold">
                            <%= mbIsEn ? 'Refunded Amount:' : 'İade Edilen Tutar:' %> €<%= refundedAmt.toLocaleString() %>
                            <% if (refundRuleText) { %> — <%= refundRuleText %><% } %>
                        </p>
                    <% } %>
                </div>
            <% } %>

            <% if (isApproved) { %>
                <div class="bg-emerald-50/80 border border-emerald-200 rounded-2xl p-5 space-y-3 text-xs text-slate-800">
                    <div class="font-extrabold text-sm text-emerald-900 flex items-center gap-2">
                        <i class="fa-solid fa-ship"></i>
                        <span><%= mbIsEn ? 'Approved Crew, Transfer & Boarding Details' : 'Onaylanan Kaptan, Transfer ve Biniş Detayları' %></span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="bg-white/90 border border-emerald-200/80 rounded-xl p-3">
                            <span class="text-[11px] font-bold uppercase text-slate-400 block"><%= mbIsEn ? 'Assigned Captain' : 'Atanan Kaptan' %></span>
                            <strong class="text-sm text-slate-900 block mt-0.5"><%= captainName || (mbIsEn ? 'Assigned by Marina' : 'Marina Tarafından Atandı') %></strong>
                            <% if (captainPhone) { %>
                                <span class="text-emerald-800 font-semibold block mt-0.5"><i class="fa-solid fa-phone mr-1"></i><%= captainPhone %></span>
                            <% } %>
                        </div>
                        <div class="bg-white/90 border border-emerald-200/80 rounded-xl p-3">
                            <span class="text-[11px] font-bold uppercase text-slate-400 block"><%= mbIsEn ? 'Transfer Contact' : 'Transfer İletişim' %></span>
                            <strong class="text-sm text-slate-900 block mt-0.5"><%= transferPhone || (mbIsEn ? 'Will be shared prior to pickup' : 'Alım öncesi paylaşılacaktır') %></strong>
                            <% if (transferDriver) { %>
                                <span class="text-slate-600 block mt-0.5"><%= mbIsEn ? 'Driver / Coordinator:' : 'Sürücü / Koordinatör:' %> <%= transferDriver %></span>
                            <% } %>
                        </div>
                    </div>
                    <% if (boardingInfo) { %>
                        <div class="bg-white/90 border border-emerald-200/80 rounded-xl p-3">
                            <span class="text-[11px] font-bold uppercase text-slate-400 block"><%= mbIsEn ? 'Marina / Boarding Instructions' : 'Marina / Biniş Bilgileri' %></span>
                            <span class="text-slate-800 font-medium block mt-0.5"><%= boardingInfo %></span>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <% if (isCancelled) { %>
                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-xs text-slate-800 space-y-1">
                    <div class="font-extrabold text-sm text-rose-700">
                        <%= mbIsEn ? 'Cancellation & Refund Summary' : 'İptal ve İade Özeti' %>
                    </div>
                    <div>
                        <strong><%= mbIsEn ? 'Refunded Amount:' : 'Geri Ödenen Tutar:' %></strong> €<%= refundedAmt.toLocaleString() %>
                    </div>
                    <% if (booking.cancelReason) { %>
                        <p class="text-slate-600">
                            <strong><%= mbIsEn ? 'Cancellation Reason:' : 'İptal Sebebi:' %></strong> <%= booking.cancelReason %>
                        </p>
                    <% } %>
                    <p class="text-slate-600">
                        <strong><%= mbIsEn ? 'Refund Reason:' : 'İade Gerekçesi:' %></strong> <%= refundReasonSummary %>
                    </p>
                </div>
            <% } %>

            <% if (booking.packageName) { %>
                <div class="bg-teal-50/80 border border-teal-200 rounded-xl px-4 py-3 text-xs text-teal-900 font-bold">
                    <%= mbIsEn ? 'Selected Package:' : 'Seçilen Paket:' %> <%= booking.packageName %>
                </div>
            <% } %>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div class="bg-slate-50 p-4 rounded-xl">
                    <span class="text-slate-400 block"><%= mbIsEn ? 'Yacht & Port' : 'Yat & Liman' %></span>
                    <strong class="text-sm text-slate-900"><%= booking.yacht %><%= portText %></strong>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl">
                    <span class="text-slate-400 block"><%= mbIsEn ? 'Dates' : 'Tarihler' %></span>
                    <strong class="text-sm text-slate-900">
                        <%= booking.checkIn %> → <%= booking.checkOut %> (<%= daysNum %> <%= mbIsEn ? (daysNum === 1 ? 'Day' : 'Days') : 'Gün' %>)
                        <% if (booking.tourTimeSlot) { %> • <%= booking.tourTimeSlot %><% } %>
                    </strong>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl">
                    <span class="text-slate-400 block"><%= mbIsEn ? 'Guest' : 'Misafir' %></span>
                    <strong class="text-sm text-slate-900">
                        <%= booking.customer %> (<%= guestsNum %> <%= mbIsEn ? (guestsNum === 1 ? 'Guest' : 'Guests') : 'Kişi' %>)
                    </strong>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl space-y-1">
                    <span class="text-slate-400 block"><%= mbIsEn ? 'Payment & Balance' : 'Ödeme & Bakiye' %> (<%= methodLabel %>)</span>
                    <strong class="text-sm text-[#0B1F3A] block">
                        <%= mbIsEn
                            ? ('Paid: €' + paidAmt.toLocaleString() + ' / Total: €' + totalAmt.toLocaleString())
                            : ('Tahsil Edilen: €' + paidAmt.toLocaleString() + ' / Toplam: €' + totalAmt.toLocaleString()) %>
                    </strong>
                    <% if (refundedAmt > 0) { %>
                        <span class="text-[11px] font-bold text-amber-700 block">
                            <%= mbIsEn ? ('Refunded Amount: €' + refundedAmt.toLocaleString()) : ('İade Edilen Tutar: €' + refundedAmt.toLocaleString()) %>
                        </span>
                    <% } %>
                </div>
            </div>

            <% if (Array.isArray(booking.extras) && booking.extras.length > 0) { %>
                <div class="bg-slate-50 p-4 rounded-xl text-xs">
                    <span class="text-slate-400 font-bold uppercase block mb-1.5"><%= mbIsEn ? 'Extras' : 'Ekstralar' %></span>
                    <div class="flex flex-wrap gap-2">
                        <% booking.extras.forEach(function(ex) { %>
                            <% const exTitle = mbIsEn ? (extrasTrToEn[ex] || ex) : ex; %>
                            <span class="bg-white border border-slate-200 px-3 py-1 rounded-lg font-semibold text-slate-700">✓ <%= exTitle %></span>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            <% if (booking.notes) { %>
                <div class="bg-amber-50/70 border border-amber-200 p-4 rounded-xl text-xs text-amber-900">
                    <strong><%= mbIsEn ? 'Guest Note:' : 'Misafir Notu:' %></strong> <%= booking.notes %>
                </div>
            <% } %>

            <div class="flex flex-wrap justify-between items-center gap-3 pt-4 border-t border-slate-100">
                <a href="/confirmation/<%= encodeURIComponent(booking.id) %>" class="px-5 py-2.5 bg-[#0B1F3A] text-white rounded-xl text-xs font-bold hover:bg-sky-900">
                    <%= mbIsEn ? 'View Official Voucher' : 'Resmi Voucher Görüntüle' %>
                </a>

                <% if (!isCancelled && !isRejected) { %>
                    <form id="cancelBookingForm" action="/my-booking/cancel" method="POST" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full sm:w-auto">
                        <input type="hidden" name="pnr" value="<%= booking.id %>">
                        <input type="hidden" name="email" value="<%= booking.email || emailVal %>">
                        <select name="cancelReason" id="cancelReasonSelect" class="px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-700 focus:outline-none focus:border-[#0B1F3A]">
                            <option value="<%= mbIsEn ? 'Plan change' : 'Plan değişikliği' %>"><%= mbIsEn ? 'Plan change' : 'Plan değişikliği' %></option>
                            <option value="<%= mbIsEn ? 'Travel / flight delay' : 'Seyahat / uçuş aksaklığı' %>"><%= mbIsEn ? 'Travel / flight delay' : 'Seyahat / uçuş aksaklığı' %></option>
                            <option value="<%= mbIsEn ? 'Weather / personal reason' : 'Kişisel / hava durumu sebebi' %>"><%= mbIsEn ? 'Weather / personal reason' : 'Kişisel / hava durumu sebebi' %></option>
                            <option value="other"><%= mbIsEn ? 'Other (specify below)' : 'Diğer (aşağıda belirtin)' %></option>
                        </select>
                        <input type="text" name="cancelReasonCustom" id="cancelReasonCustom" placeholder="<%= mbIsEn ? 'Cancellation reason...' : 'İptal sebebiniz...' %>" class="hidden px-3.5 py-2.5 bg-white border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none focus:border-[#0B1F3A]">
                        <button type="submit" id="cancelBookingBtn" class="px-5 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 rounded-xl text-xs font-bold transition shrink-0">
                            <%= mbIsEn ? 'Cancel Booking' : 'Rezervasyonu İptal Et' %>
                        </button>
                    </form>
                <% } %>
            </div>
        </div>
    <% } %>
</main>

<script>
    const isEnMb = document.documentElement.dataset.yvEn === '1';
    const cancelForm = document.getElementById('cancelBookingForm');
    const reasonSelect = document.getElementById('cancelReasonSelect');
    const reasonCustom = document.getElementById('cancelReasonCustom');

    if (reasonSelect && reasonCustom) {
        reasonSelect.addEventListener('change', function() {
            const isOther = this.value === 'other';
            reasonCustom.classList.toggle('hidden', !isOther);
            if (isOther) reasonCustom.focus();
        });
    }

    if (cancelForm) {
        cancelForm.addEventListener('submit', function(e) {
            if (reasonSelect && reasonSelect.value === 'other') {
                const customVal = (reasonCustom && reasonCustom.value.trim()) || '';
                if (!customVal) {
                    e.preventDefault();
                    alert(isEnMb ? 'Please enter a cancellation reason.' : 'Lütfen iptal sebebini yazın.');
                    if (reasonCustom) reasonCustom.focus();
                    return;
                }
                reasonSelect.value = customVal;
            }

            const confirmMsg = isEnMb
                ? 'Are you sure you want to cancel this booking? Refunds are calculated according to the 7-day policy.'
                : 'Bu rezervasyonu iptal etmek istediğinize emin misiniz? İade tutarı 7 günlük kurala göre hesaplanır.';
            const ok = confirm(confirmMsg);
            if (!ok) e.preventDefault();
        });
    }
</script>

<%- include('../partials/footer') %>