<%- include('../partials/header') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    <div class="border-b border-slate-200 pb-5">
        <span class="text-xs font-extrabold uppercase tracking-wider text-teal-600">Mavi Yolculuk Rotaları</span>
        <h1 class="text-3xl md:text-4xl font-extrabold text-[#0B1F3A] mt-1">Popüler Koy &amp; Liman Rehberi</h1>
    </div>

    <% const routeTours = (typeof tours !== 'undefined' && Array.isArray(tours)) ? tours : []; %>
    <% const routeYachts = (typeof yachts !== 'undefined' && Array.isArray(yachts)) ? yachts : []; %>

    <% if (routeTours.length === 0) { %>
        <div class="bg-white p-10 rounded-2xl border border-slate-200 text-center space-y-2">
            <p class="text-sm font-bold text-slate-700">Henüz aktif rota veya tur bulunmuyor.</p>
            <p class="text-xs text-slate-500">Admin paneldeki <strong>Turlar &amp; Kategoriler</strong> bölümünden yeni rota/tur ekleyebilirsiniz.</p>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
            <% routeTours.forEach(tour => { %>
                <% const linkedYacht = routeYachts.find(y => Number(y.id) === Number(tour.yachtId)) || routeYachts[0]; %>
                <% const tourImg = tour.img || (linkedYacht && linkedYacht.images && linkedYacht.images[0]) || 'https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=900&q=80'; %>
                <% const stops = Array.isArray(tour.included) ? tour.included.slice(0, 3) : []; %>
                <% const locQuery = encodeURIComponent(tour.region || (linkedYacht && linkedYacht.location) || ''); %>
                <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm flex flex-col justify-between">
                    <div>
                        <img src="<%= tourImg %>" onerror="fallbackYachtImg(this)" alt="<%= tour.title %>" class="w-full h-52 object-cover">
                        <div class="p-6 space-y-3">
                            <div class="flex justify-between items-start gap-3">
                                <h2 class="text-xl font-extrabold text-slate-900"><%= tour.title %></h2>
                                <span class="text-xs font-bold text-teal-700 bg-teal-50 px-3 py-1 rounded-lg shrink-0">
                                    <%= tour.durationLabel || ((tour.durationDays || 1) + ' Gün') %>
                                </span>
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                <%= tour.summary || (tour.region + ' hattında özel tekne rotası ve koy keşfi.') %>
                            </p>
                            <% if (stops.length > 0) { %>
                                <div class="flex flex-wrap gap-1.5 pt-1 text-[11px] font-semibold text-slate-700">
                                    <% stops.forEach((item, idx) => { %>
                                        <span class="bg-slate-100 px-2.5 py-1 rounded-lg"><%= idx + 1 %>. <%= item %></span>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-between items-center gap-3">
                        <span class="text-xs text-slate-500">
                            Bölge: <strong class="text-slate-800"><%= tour.region %></strong>
                            <% if (linkedYacht) { %>
                                • Yat: <strong class="text-slate-800"><%= linkedYacht.name %></strong>
                            <% } %>
                        </span>
                        <a href="<%= linkedYacht ? ('/yachts/' + linkedYacht.id) : ('/yachts?location=' + locQuery) %>" class="bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold px-4 py-2 rounded-xl transition shrink-0">
                            İncele →
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</main>

<%- include('../partials/footer') %>