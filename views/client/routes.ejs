<%- include('../partials/header') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    <div class="border-b border-slate-200 pb-5">
        <span class="text-xs font-extrabold uppercase tracking-wider text-teal-600">Mavi Yolculuk Rotaları</span>
        <h1 class="text-3xl md:text-4xl font-extrabold text-[#0B1F3A] mt-1">Popüler Koy &amp; Liman Rehberi</h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm flex flex-col justify-between">
            <div>
                <img src="https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=900&q=80" onerror="fallbackYachtImg(this)" alt="Göcek" class="w-full h-52 object-cover">
                <div class="p-6 space-y-3">
                    <div class="flex justify-between items-center">
                        <h2 class="text-xl font-extrabold text-slate-900">Göcek 12 Adalar &amp; Bedri Rahmi Koyu</h2>
                        <span class="text-xs font-bold text-teal-700 bg-teal-50 px-3 py-1 rounded-lg">1 - 3 Gün</span>
                    </div>
                    <p class="text-xs text-slate-600 leading-relaxed">Rüzgâra kapalı sakin koyları, çam ormanlarıyla çevrili turkuaz suları ve kısa seyir mesafeleriyle öne çıkar.</p>
                    <div class="flex flex-wrap gap-1.5 pt-1 text-[11px] font-semibold text-slate-700">
                        <span class="bg-slate-100 px-2.5 py-1 rounded-lg">1. Yassıca Adaları</span>
                        <span class="bg-slate-100 px-2.5 py-1 rounded-lg">2. Bedri Rahmi Koyu</span>
                        <span class="bg-slate-100 px-2.5 py-1 rounded-lg">3. Kleopatra Hamamı</span>
                    </div>
                </div>
            </div>
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-between items-center">
                <span class="text-xs text-slate-500">Önerilen: <strong class="text-slate-800">Katamaran &amp; Motor Yat</strong></span>
                <a href="/yachts?location=G%C3%B6cek" class="bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold px-4 py-2 rounded-xl transition">Yatları Gör →</a>
            </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm flex flex-col justify-between">
            <div>
                <img src="https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=900&q=80" onerror="fallbackYachtImg(this)" alt="Marmaris" class="w-full h-52 object-cover">
                <div class="p-6 space-y-3">
                    <div class="flex justify-between items-center">
                        <h2 class="text-xl font-extrabold text-slate-900">Marmaris, Bozburun &amp; Hisarönü</h2>
                        <span class="text-xs font-bold text-teal-700 bg-teal-50 px-3 py-1 rounded-lg">2 - 5 Gün</span>
                    </div>
                    <p class="text-xs text-slate-600 leading-relaxed">Berrak koyları, balıkçı köyleri ve gün batımı manzaralarıyla Hisarönü hattında huzurlu bir seyir sunar.</p>
                    <div class="flex flex-wrap gap-1.5 pt-1 text-[11px] font-semibold text-slate-700">
                        <span class="bg-slate-100 px-2.5 py-1 rounded-lg">1. Cennet Adası</span>
                        <span class="bg-slate-100 px-2.5 py-1 rounded-lg">2. Kumlubük</span>
                        <span class="bg-slate-100 px-2.5 py-1 rounded-lg">3. Selimiye Koyu</span>
                    </div>
                </div>
            </div>
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-between items-center">
                <span class="text-xs text-slate-500">Önerilen: <strong class="text-slate-800">Gulet &amp; Süperyat</strong></span>
                <a href="/yachts?location=Marmaris" class="bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold px-4 py-2 rounded-xl transition">Yatları Gör →</a>
            </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm flex flex-col justify-between">
            <div>
                <img src="https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=900&q=80" onerror="fallbackYachtImg(this)" alt="Fethiye" class="w-full h-52 object-cover">
                <div class="p-6 space-y-3">
                    <div class="flex justify-between items-center">
                        <h2 class="text-xl font-extrabold text-slate-900">Fethiye, Ölüdeniz &amp; Kelebekler Vadisi</h2>
                        <span class="text-xs font-bold text-teal-700 bg-teal-50 px-3 py-1 rounded-lg">1 - 4 Gün</span>
                    </div>
                    <p class="text-xs text-slate-600 leading-relaxed">Yüksek kayalıkların gölgesindeki gizli koylar, Akvaryum Koyu ve St. Nicholas Adası ile öne çıkar.</p>
                    <div class="flex flex-wrap gap-1.5 pt-1 text-[11px] font-semibold text-slate-700">
                        <span class="bg-slate-100 px-2.5 py-1 rounded-lg">1. Kızıl Ada</span>
                        <span class="bg-slate-100 px-2.5 py-1 rounded-lg">2. Kelebekler Vadisi</span>
                        <span class="bg-slate-100 px-2.5 py-1 rounded-lg">3. St. Nicholas Adası</span>
                    </div>
                </div>
            </div>
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-between items-center">
                <span class="text-xs text-slate-500">Önerilen: <strong class="text-slate-800">Motor Yat &amp; Yelkenli</strong></span>
                <a href="/yachts?location=Fethiye" class="bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold px-4 py-2 rounded-xl transition">Yatları Gör →</a>
            </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm flex flex-col justify-between">
            <div>
                <img src="https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=900&q=80" onerror="fallbackYachtImg(this)" alt="Bodrum" class="w-full h-52 object-cover">
                <div class="p-6 space-y-3">
                    <div class="flex justify-between items-center">
                        <h2 class="text-xl font-extrabold text-slate-900">Bodrum, Cennet Koyu &amp; Orak Adası</h2>
                        <span class="text-xs font-bold text-teal-700 bg-teal-50 px-3 py-1 rounded-lg">1 - 7 Gün</span>
                    </div>
                    <p class="text-xs text-slate-600 leading-relaxed">Turkuaz Orak Adası suları ve seçkin koy duraklarıyla lüks ve dinamik bir Ege rotası.</p>
                    <div class="flex flex-wrap gap-1.5 pt-1 text-[11px] font-semibold text-slate-700">
                        <span class="bg-slate-100 px-2.5 py-1 rounded-lg">1. Akvaryum Koyu</span>
                        <span class="bg-slate-100 px-2.5 py-1 rounded-lg">2. Orak Adası</span>
                        <span class="bg-slate-100 px-2.5 py-1 rounded-lg">3. Türkbükü</span>
                    </div>
                </div>
            </div>
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-between items-center">
                <span class="text-xs text-slate-500">Önerilen: <strong class="text-slate-800">Süperyat &amp; Motor Yat</strong></span>
                <a href="/yachts?location=Bodrum" class="bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold px-4 py-2 rounded-xl transition">Yatları Gör →</a>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>