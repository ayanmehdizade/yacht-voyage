    function isValidLuhn(digits) {
        if (!/^\d{13,19}$/.test(digits)) return false;
        let sum = 0;
        let shouldDouble = false;
        for (let i = digits.length - 1; i >= 0; i--) {
            let d = Number(digits[i]);
            if (shouldDouble) {
                d *= 2;
                if (d > 9) d -= 9;
            }
            sum += d;
            shouldDouble = !shouldDouble;
        }
        return sum % 10 === 0;
    }

    function detectCardBrand(digits) {
        if (/^3[47]/.test(digits)) return 'AMEX';
        if (/^4/.test(digits)) return 'VISA';
        if (/^(5[1-5]|222[1-9]|22[3-9]\d|2[3-6]\d{2}|27[01]\d|2720)/.test(digits)) return 'MC';
        return 'OTHER';
    }

    function isExpiryNotPast(mmYyStr) {
        const match = /^(\d{2})\/(\d{2})$/.exec(mmYyStr);
        if (!match) return false;
        const expMonth = Number(match[1]);
        const expYear = 2000 + Number(match[2]);
        if (expMonth < 1 || expMonth > 12) return false;

        const curYear = nowRef.getFullYear();
        const curMonth = nowRef.getMonth() + 1;
        if (expYear < curYear) return false;
        if (expYear === curYear && expMonth < curMonth) return false;
        return true;
    }

    function validateCardDetails() {
        const { isCard } = getSelectedMethodFlags();
        if (!isCard) return true;

        const holderVal = cardHolderInput ? cardHolderInput.value.trim() : '';
        const numDigits = cardNumberInput ? cardNumberInput.value.replace(/\D/g, '') : '';
        const expVal = cardExpInput ? cardExpInput.value.trim() : '';
        const cvvDigits = cardCvvInput ? cardCvvInput.value.replace(/\D/g, '') : '';
        const brand = detectCardBrand(numDigits);
        const expectedCvvLen = brand === 'AMEX' ? 4 : 3;

        if (!holderVal) {
            showCardError(isEnCo ? 'Please enter the cardholder name.' : 'Lütfen kart üzerindeki adı soyadı girin.');
            if (cardHolderInput) cardHolderInput.focus();
            return false;
        }
        if (!isValidLuhn(numDigits)) {
            showCardError(isEnCo
                ? 'Please enter a valid card number.'
                : 'Lütfen geçerli bir kart numarası girin.');
            if (cardNumberInput) cardNumberInput.focus();
            return false;
        }
        if (!/^(0[1-9]|1[0-2])\/\d{2}$/.test(expVal) || !isExpiryNotPast(expVal)) {
            showCardError(isEnCo
                ? 'Please enter a valid non-expired expiry date in MM/YY format (e.g. 08/29).'
                : 'Lütfen geçmiş olmayan geçerli bir son kullanma tarihi (AA/YY, ör. 08/29) girin.');
            if (cardExpInput) cardExpInput.focus();
            return false;
        }
        if (cvvDigits.length !== expectedCvvLen) {
            showCardError(isEnCo
                ? ('Please enter a ' + expectedCvvLen + '-digit CVV security code.')
                : ('Lütfen ' + expectedCvvLen + ' haneli CVV güvenlik kodunu girin.'));
            if (cardCvvInput) cardCvvInput.focus();
            return false;
        }

        hideCardError();
        return true;
    }

