    function findActivePromo(codeStr) {
        const normalized = String(codeStr || '').trim().toUpperCase();
        if (!normalized) return null;
        return configuredPromoCodes.find(function(item) {
            if (!item || !item.code) return false;
            const itemCode = String(item.code).trim().toUpperCase();
            if (itemCode !== normalized) return false;
            if (item.active === false || item.isActive === false) return false;
            if (item.expiresAt && /^\d{4}-\d{2}-\d{2}$/.test(String(item.expiresAt)) && String(item.expiresAt) < todayYmd) {
                return false;
            }
            return Number(item.discountPercent || 0) > 0;
        }) || null;
    }

    function evaluatePromoCode(silentWhenEmpty) {
        const code = promoInputEl ? promoInputEl.value.trim().toUpperCase() : '';
        const msg = document.getElementById('promoMsg');
        if (!code) {
            discountPercent = 0;
            appliedPromoCode = '';
            if (promoAppliedInputEl) promoAppliedInputEl.value = '';
            if (msg && silentWhenEmpty) msg.classList.add('hidden');
            return;
        }
        const matched = findActivePromo(code);
        if (msg) msg.classList.remove('hidden');
        if (matched) {
            discountPercent = Number(matched.discountPercent || 0);
            appliedPromoCode = String(matched.code || code).trim().toUpperCase();
            if (promoAppliedInputEl) promoAppliedInputEl.value = appliedPromoCode;
            if (msg) {
                msg.className = 'text-[11px] mt-1 text-emerald-600 font-semibold';
                msg.innerText = isEnCo
                    ? ('✓ ' + discountPercent + '% promo discount applied (' + appliedPromoCode + ')!')
                    : ('✓ %' + discountPercent + ' promo indirimi uygulandı (' + appliedPromoCode + ')!');
            }
        } else {
            discountPercent = 0;
            appliedPromoCode = '';
            if (promoAppliedInputEl) promoAppliedInputEl.value = '';
            if (msg) {
                msg.className = 'text-[11px] mt-1 text-rose-600 font-semibold';
                msg.innerText = isEnCo
                    ? 'Promo code is invalid or inactive.'
                    : 'Promosyon kodu geçersiz veya aktif değil.';
            }
        }
    }

