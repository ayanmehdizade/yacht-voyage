    function checkAvailability() {
        const isDaily = isDailyTourSelected();
        const cIn = cInEl.value;
        const cOut = isDaily ? cIn : cOutEl.value;
        const badge = document.getElementById('availBadge');
        const btn = document.getElementById('nextStepBtn');

        if (!cIn || (!isDaily && !cOut)) {
            badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-amber-50 text-amber-800';
            badge.innerHTML = '<i class="fa-solid fa-calendar-day mr-1"></i>' + (isDaily
                ? (isEnCo ? 'Select Tour Date' : 'Tur Tarihi Seçin')
                : (isEnCo ? 'Select Check-in & Check-out Dates' : 'Giriş ve Çıkış Tarihi Seçin'));
            btn.disabled = true;
            btn.classList.add('opacity-50', 'cursor-not-allowed');
            return;
        }

        if (cIn < todayYmd || (!isDaily && cOut <= cIn)) {
            badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-amber-50 text-amber-800';
            badge.innerHTML = '<i class="fa-solid fa-triangle-exclamation mr-1"></i>' + (isEnCo ? 'Select valid future dates' : 'Geçerli ileri tarih seçin');
            btn.disabled = true;
            btn.classList.add('opacity-50', 'cursor-not-allowed');
            return;
        }

        const effectiveOut = isDaily ? addDaysYMD(cIn, 1) : cOut;
        const conflict = existingBookings.find(function(b) {
            return cIn < b.checkOut && effectiveOut > b.checkIn;
        });

        if (conflict) {
            badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-rose-50 text-rose-700';
            badge.innerHTML = '<i class="fa-solid fa-circle-xmark mr-1"></i>' + (isEnCo ? 'Booked' : 'Dolu') + ' (' + conflict.checkIn + ' - ' + conflict.checkOut + ')';
            showInlineWarning(isEnCo
                ? ('Selected dates overlap with an existing booking (' + conflict.checkIn + ' - ' + conflict.checkOut + ').')
                : ('Seçilen tarih aralığı mevcut bir rezervasyonla çakışıyor (' + conflict.checkIn + ' - ' + conflict.checkOut + ').'));
            btn.disabled = true;
            btn.classList.add('opacity-50', 'cursor-not-allowed');
        } else {
            badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-emerald-50 text-emerald-700';
            badge.innerHTML = '<i class="fa-solid fa-circle-check mr-1"></i>' + (isEnCo ? 'Selected Dates Available' : 'Seçilen Tarihler Müsait');
            if (dateWarnBox && dateWarnText && dateWarnText.innerText.indexOf(isEnCo ? 'overlap' : 'çakışıyor') !== -1) {
                hideInlineWarning();
            }
            btn.disabled = false;
            btn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
    }

    function recalculate() {
        checkAvailability();

        const selectDateLabel = isEnCo ? 'Select dates' : 'Tarih seçin';
        const isDaily = isDailyTourSelected();
        let guestsVal = Math.max(1, Number(guestsEl.value) || 1);
        if (guestsVal > maxGuests) {
            guestsVal = maxGuests;
            guestsEl.value = maxGuests;
        }

        let selectedDays = 0;
        if (isDaily && cInEl.value && cInEl.value >= todayYmd) {
            selectedDays = 1;
        } else if (cInEl.value && cOutEl.value && cInEl.value >= todayYmd && cOutEl.value > cInEl.value) {
            const diff = diffDaysYMD(cInEl.value, cOutEl.value);
            if (!isNaN(diff) && diff >= 1) selectedDays = diff;
        }

        const hasFixedPackage = fixedPackagePrice > 0;
        const hasValidDates = selectedDays > 0;
        const effectiveDays = hasFixedPackage
            ? (fixedPackageDays > 0 ? fixedPackageDays : selectedDays)
            : selectedDays;
        const nightsCount = isDaily ? 0 : Math.max(0, effectiveDays - 1);

        const timeSlotVal = (timeSlotEl && timeSlotEl.value) ? timeSlotEl.value : '10:30 - 18:00';
        const sumTimeSlotEl = document.getElementById('sumTimeSlot');
        if (sumTimeSlotEl) sumTimeSlotEl.textContent = timeSlotVal;

        const sumDurEl = document.getElementById('sumDurationBreakdown');
        if (sumDurEl) {
            if (!hasValidDates) {
                sumDurEl.textContent = selectDateLabel;
            } else if (isDaily) {
                sumDurEl.textContent = isEnCo ? '1 Day / 0 Nights (Same Day)' : '1 Gün / 0 Gece (Aynı Gün)';
            } else {
                const dWord = isEnCo ? (effectiveDays === 1 ? 'Day' : 'Days') : 'Gün';
                const nWord = isEnCo ? (nightsCount === 1 ? 'Night' : 'Nights') : 'Gece';
                sumDurEl.textContent = `${effectiveDays} ${dWord} / ${nightsCount} ${nWord}`;
            }
        }

        const guestUnit = isEnCo ? (guestsVal === 1 ? 'guest' : 'guests') : 'kişi';
        let extrasTotal = 0;
        document.querySelectorAll('.extra-cb').forEach(function(cb) {
            const perGuest = Number(cb.dataset.perGuest || 0);
            const itemSum = perGuest * guestsVal;
            const badge = cb.closest('label') ? cb.closest('label').querySelector('.extra-calc-badge') : null;
            if (badge) {
                badge.innerText = '+€' + itemSum.toLocaleString() + ' (' + guestsVal + ' ' + guestUnit + ')';
            }
            if (cb.checked) {
                extrasTotal += itemSum;
            }
        });

        const baseLabelEl = document.getElementById('sumBaseLabel');
        if (baseLabelEl) {
            const titlePart = hasFixedPackage
                ? (packageName || (isEnCo ? 'Tour Package' : 'Tur Paketi'))
                : (isEnCo ? 'Yacht Charter' : 'Yat Kirası');
            if (!hasValidDates && hasFixedPackage) {
                baseLabelEl.textContent = titlePart;
            } else {
                const dayWord = isEnCo ? (effectiveDays === 1 ? 'day' : 'days') : 'gün';
                baseLabelEl.textContent = `${titlePart} (${effectiveDays} ${dayWord})`;
            }
        }

        document.getElementById('sumGuests').innerText = guestsVal;
        document.getElementById('sumExtras').innerText = '€' + extrasTotal.toLocaleString();

        const autoRow = document.getElementById('autoDiscountRow');
        const discRow = document.getElementById('discountRow');
        const adjRow = document.getElementById('planAdjustmentRow');
        const transferRow = document.getElementById('transferBreakdownRow');
        const payNowLabelEl = document.getElementById('payNowLabel');
        const ibanTransferEl = document.getElementById('ibanTransferAmount');
        const ibanMarinaEl = document.getElementById('ibanMarinaAmount');

        if (!hasValidDates) {
            autoRow.classList.add('hidden');
            discRow.classList.add('hidden');
            adjRow.classList.add('hidden');
            if (transferRow) {
                transferRow.classList.add('hidden');
                transferRow.classList.remove('flex');
            }
            document.getElementById('daysInput').value = hasFixedPackage && fixedPackageDays > 0 ? fixedPackageDays : 0;
            document.getElementById('nightsInput').value = 0;
            document.getElementById('discountInput').value = 0;
            document.getElementById('extrasTotalInput').value = extrasTotal;
            document.getElementById('totalAmountInput').value = 0;
            document.getElementById('paidAmountInput').value = 0;

            document.getElementById('sumBase').innerText = hasFixedPackage
                ? ('€' + fixedPackagePrice.toLocaleString() + ' (' + selectDateLabel + ')')
                : selectDateLabel;
            document.getElementById('sumTotal').innerText = selectDateLabel;
            document.getElementById('sumPayNow').innerText = selectDateLabel;
            document.getElementById('sumRemaining').innerText = selectDateLabel;
            document.getElementById('payBtnAmount').innerText = selectDateLabel;
            if (ibanTransferEl) ibanTransferEl.innerText = selectDateLabel;
            if (ibanMarinaEl) ibanMarinaEl.innerText = selectDateLabel;
            return;
        }

        const baseTotal = hasFixedPackage ? fixedPackagePrice : (selectedDays * rate);
        const autoDisc = (!hasFixedPackage && selectedDays >= 5) ? Math.round(baseTotal * 0.05) : 0;
        const subBeforePromo = Math.max(0, baseTotal - autoDisc + extrasTotal);
        const promoDisc = Math.round(subBeforePromo * (discountPercent / 100));
        const subTotal = Math.max(0, subBeforePromo - promoDisc);

        const planEl = document.querySelector('.pay-plan:checked');
        const selectedPlan = planEl ? planEl.value : 'Hisseli Ödeme';
        const isFullPayment = selectedPlan === 'Tam Ödeme (İndirimli)';

        let grandTotal = subTotal;
        let planDelta = 0;
        const adjLabel = document.getElementById('planAdjustmentLabel');
        const adjVal = document.getElementById('sumPlanAdjustment');

        if (isFullPayment && fullPaymentDiscountPct > 0) {
            planDelta = -Math.round(subTotal * (fullPaymentDiscountPct / 100));
            grandTotal = Math.max(0, subTotal + planDelta);
            adjRow.className = 'flex justify-between text-emerald-700 font-bold';
            adjLabel.innerText = isEnCo ? ('Full Payment Discount (' + fullPaymentDiscountPct + '%)') : ('Tam Ödeme İndirimi (%' + fullPaymentDiscountPct + ')');
            adjVal.innerText = '-€' + Math.abs(planDelta).toLocaleString();
        } else if (!isFullPayment && installmentInterestPct > 0) {
            planDelta = Math.round(subTotal * (installmentInterestPct / 100));
            grandTotal = Math.max(0, subTotal + planDelta);
            adjRow.className = 'flex justify-between text-amber-700 font-bold';
            adjLabel.innerText = isEnCo ? ('Installment Surcharge (' + installmentInterestPct + '%)') : ('Hisseli Ödeme Farkı (%' + installmentInterestPct + ')');
            adjVal.innerText = '+€' + planDelta.toLocaleString();
        } else {
            adjRow.classList.add('hidden');
        }

        const { isCard, isTransfer } = getSelectedMethodFlags();
        const plannedPayNow = isFullPayment
            ? grandTotal
            : Math.round(grandTotal * (installmentPct / 100));
        const payNow = isCard ? plannedPayNow : 0;
        const remaining = isTransfer
            ? Math.max(0, grandTotal - plannedPayNow)
            : Math.max(0, grandTotal - payNow);

        document.getElementById('daysInput').value = effectiveDays;
        document.getElementById('nightsInput').value = nightsCount;
        document.getElementById('discountInput').value = autoDisc + promoDisc;
        document.getElementById('extrasTotalInput').value = extrasTotal;
        document.getElementById('totalAmountInput').value = grandTotal;
        document.getElementById('paidAmountInput').value = payNow;

        document.getElementById('sumBase').innerText = '€' + baseTotal.toLocaleString();

        if (autoDisc > 0) {
            autoRow.classList.remove('hidden');
            document.getElementById('sumAutoDiscount').innerText = '-€' + autoDisc.toLocaleString();
        } else {
            autoRow.classList.add('hidden');
        }

        if (promoDisc > 0) {
            discRow.classList.remove('hidden');
            const discLabelEl = document.getElementById('discountRowLabel');
            if (discLabelEl) {
                discLabelEl.innerText = isEnCo
                    ? ('Promo Discount (' + appliedPromoCode + ' - ' + discountPercent + '%)')
                    : ('Promo İndirimi (' + appliedPromoCode + ' - %' + discountPercent + ')');
            }
            document.getElementById('sumDiscount').innerText = '-€' + promoDisc.toLocaleString();
        } else {
            discRow.classList.add('hidden');
        }

        document.getElementById('sumTotal').innerText = '€' + grandTotal.toLocaleString();

        if (transferRow) {
            if (isTransfer) {
                transferRow.classList.remove('hidden');
                transferRow.classList.add('flex');
                document.getElementById('sumTransferDue').innerText = '€' + plannedPayNow.toLocaleString();
            } else {
                transferRow.classList.add('hidden');
                transferRow.classList.remove('flex');
            }
        }

        if (payNowLabelEl) {
            payNowLabelEl.innerText = isCard
                ? (isEnCo ? 'Pay Now' : 'Şimdi Ödenecek')
                : (isEnCo ? 'Charged on Site Now' : 'Sayfadan Şimdi Çekilecek');
        }

        if (ibanTransferEl) ibanTransferEl.innerText = '€' + plannedPayNow.toLocaleString();
        if (ibanMarinaEl) ibanMarinaEl.innerText = '€' + remaining.toLocaleString();

        document.getElementById('sumPayNow').innerText = '€' + payNow.toLocaleString();
        document.getElementById('sumRemaining').innerText = '€' + remaining.toLocaleString();
        document.getElementById('payBtnAmount').innerText = '€' + payNow.toLocaleString();
    }

    const monthNames = isEnCo
        ? ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
        : ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
    const pickerState = {
        in: { year: nowRef.getFullYear(), month: nowRef.getMonth() },
        out: { year: nowRef.getFullYear(), month: nowRef.getMonth() }
    };

    function isDayBooked(ymd) {
        return existingBookings.some(function(b) {
            return ymd >= b.checkIn && ymd < b.checkOut;
        });
    }

    function renderMiniPicker(target) {
        const state = pickerState[target];
        const gridEl = document.getElementById(target === 'in' ? 'gridIn' : 'gridOut');
        const labelEl = document.getElementById(target === 'in' ? 'labelIn' : 'labelOut');
        if (!gridEl || !labelEl) return;

        labelEl.innerText = monthNames[state.month] + ' ' + state.year;
        gridEl.innerHTML = '';

        const firstDay = new Date(state.year, state.month, 1);
        let offset = firstDay.getDay() - 1;
        if (offset < 0) offset = 6;
        const totalDays = new Date(state.year, state.month + 1, 0).getDate();

        for (let i = 0; i < offset; i++) {
            const emptyDiv = document.createElement('div');
            emptyDiv.className = 'h-7';
            gridEl.appendChild(emptyDiv);
        }

        for (let d = 1; d <= totalDays; d++) {
            const ymd = state.year + '-' + String(state.month + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
            const isPast = ymd < todayYmd;
            const booked = !isPast && isDayBooked(ymd);
            const beforeOrSameCheckIn = (!isPast && target === 'out' && cInEl.value && ymd <= cInEl.value);
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.innerText = d;

            if (isPast || beforeOrSameCheckIn) {
                btn.className = 'w-full h-7 rounded-md font-semibold bg-slate-100 text-slate-300 cursor-not-allowed flex items-center justify-center';
            } else if (booked) {
                btn.className = 'w-full h-7 rounded-md font-extrabold bg-rose-500 text-white cursor-not-allowed flex items-center justify-center';
            } else {
                btn.className = 'w-full h-7 rounded-md font-bold bg-emerald-100 text-emerald-800 hover:bg-emerald-500 hover:text-white transition flex items-center justify-center';
                btn.addEventListener('click', function() {
                    hideStep1Error();
                    if (target === 'in') {
                        cInEl.value = ymd;
                        if (isDailyTourSelected()) {
                            cOutEl.value = ymd;
                        } else if (fixedPackageDays >= 2) {
                            syncPackageCheckOutDate();
                        } else if (cOutEl.value && cOutEl.value <= cInEl.value) {
                            cOutEl.value = '';
                        }
                    } else {
                        cOutEl.value = ymd;
                    }
                    isDateSelectionValid(false);
                    recalculate();
                    document.getElementById(target === 'in' ? 'pickerIn' : 'pickerOut').classList.add('hidden');
                });
            }
            gridEl.appendChild(btn);
        }
    }

    function openPicker(target, inputEl) {
        const otherId = target === 'in' ? 'pickerOut' : 'pickerIn';
        const targetId = target === 'in' ? 'pickerIn' : 'pickerOut';
        document.getElementById(otherId).classList.add('hidden');
        const pEl = document.getElementById(targetId);
        const refStr = inputEl.value || cInEl.value;
        if (refStr && /^\d{4}-\d{2}-\d{2}$/.test(refStr)) {
            const parts = refStr.split('-').map(Number);
            pickerState[target].year = parts[0];
            pickerState[target].month = (parts[1] || 1) - 1;
        }
        renderMiniPicker(target);
        pEl.classList.remove('hidden');
    }

    cInEl.addEventListener('mousedown', function(e) {
        e.preventDefault();
        openPicker('in', cInEl);
    });

    cOutEl.addEventListener('mousedown', function(e) {
        e.preventDefault();
        if (this.dataset.lockedByPackage === '1') return;
        openPicker('out', cOutEl);
    });

    document.querySelectorAll('.cal-nav-btn').forEach(function(navBtn) {
        navBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            const target = this.dataset.picker;
            const dir = Number(this.dataset.dir) || 1;
            pickerState[target].month += dir;
            if (pickerState[target].month < 0) {
                pickerState[target].month = 11;
                pickerState[target].year--;
            } else if (pickerState[target].month > 11) {
                pickerState[target].month = 0;
                pickerState[target].year++;
            }
            renderMiniPicker(target);
        });
    });

    document.addEventListener('click', function(e) {
        const pIn = document.getElementById('pickerIn');
        const pOut = document.getElementById('pickerOut');
        if (pIn && !pIn.contains(e.target) && e.target !== cInEl) {
            pIn.classList.add('hidden');
        }
        if (pOut && !pOut.contains(e.target) && e.target !== cOutEl) {
            pOut.classList.add('hidden');
        }
    });

    cInEl.addEventListener('change', function() {
        hideStep1Error();
        if (isDailyTourSelected()) {
            cOutEl.value = cInEl.value;
        } else if (fixedPackageDays >= 2 && cInEl.value >= todayYmd) {
            syncPackageCheckOutDate();
        } else if (cOutEl.value && cOutEl.value <= cInEl.value) {
            cOutEl.value = '';
        }
        isDateSelectionValid(true);
        recalculate();
    });

    cOutEl.addEventListener('change', function() {
        hideStep1Error();
        isDateSelectionValid(true);
        recalculate();
    });

    guestsEl.addEventListener('input', recalculate);
    document.querySelectorAll('.calc-trigger').forEach(function(el) {
        el.addEventListener('change', recalculate);
    });

    function setStepTwoActive(active) {
        const step2Ind = document.getElementById('stepIndicator2');
        const step2Cir = document.getElementById('stepCircle2');
        if (!step2Ind || !step2Cir) return;

        if (active) {
            step2Ind.classList.remove('text-slate-400');
            step2Ind.classList.add('text-[#0B1F3A]');
            step2Cir.classList.remove('bg-slate-200', 'text-slate-600');
            step2Cir.classList.add('bg-[#0B1F3A]', 'text-white');
        } else {
            step2Ind.classList.remove('text-[#0B1F3A]');
            step2Ind.classList.add('text-slate-400');
            step2Cir.classList.remove('bg-[#0B1F3A]', 'text-white');
            step2Cir.classList.add('bg-slate-200', 'text-slate-600');
        }
    }

    document.getElementById('nextStepBtn').addEventListener('click', function() {
        hideStep1Error();
        if (!isDateSelectionValid(true)) {
            showStep1Error(isEnCo
                ? 'Please select valid dates before continuing.'
                : 'Devam etmeden önce geçerli tarih seçin.');
            recalculate();
            return;
        }
        const nameEl = document.getElementById('custName');
        const emailEl = document.getElementById('custEmail');
        const phoneEl = document.getElementById('custPhone');
        const name = nameEl ? nameEl.value.trim() : '';
        const email = emailEl ? emailEl.value.trim() : '';
        const phone = phoneEl ? phoneEl.value.trim() : '';

        if (!name || !email || !phone) {
            const missMsg = isEnCo
                ? 'Please fill in Full Name, Email and Phone fields.'
                : 'Lütfen Ad Soyad, E-posta ve Telefon alanlarını doldurun.';
            showStep1Error(missMsg);
            if (!name && nameEl) nameEl.focus();
            else if (!email && emailEl) emailEl.focus();
            else if (!phone && phoneEl) phoneEl.focus();
            return;
        }

        hideInlineWarning();
        hideStep1Error();
        document.getElementById('step1Box').classList.add('hidden');
        document.getElementById('step2Box').classList.remove('hidden');
        setStepTwoActive(true);
        syncCardFieldsRequired();
        recalculate();
    });

    document.getElementById('backStepBtn').addEventListener('click', function() {
        hideStep1Error();
        document.getElementById('step2Box').classList.add('hidden');
        document.getElementById('step1Box').classList.remove('hidden');
        setStepTwoActive(false);
    });

    let isBookingSubmitting = false;

    document.getElementById('bookingForm').addEventListener('submit', function(e) {
        if (isBookingSubmitting) {
            e.preventDefault();
            return;
        }

        if (!isDateSelectionValid(true)) {
            e.preventDefault();
            recalculate();
            return;
        }
        if (!validateCardDetails()) {
            e.preventDefault();
            return;
        }
        if (contractAgreeCb && !contractAgreeCb.checked) {
            e.preventDefault();
            if (contractModal) contractModal.classList.remove('hidden');
            return;
        }

        recalculate();
        isBookingSubmitting = true;

        const submitBtn = this.querySelector('button[type="submit"]');
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
            submitBtn.dataset.originalHtml = submitBtn.innerHTML;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i>' +
                (isEnCo ? 'Processing...' : 'Gönderiliyor...');
        }

        window.setTimeout(function() {
            isBookingSubmitting = false;
            if (submitBtn && submitBtn.dataset.originalHtml) {
                submitBtn.disabled = false;
                submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                submitBtn.innerHTML = submitBtn.dataset.originalHtml;
            }
        }, 10000);
    });

    syncCharterModeUI();
    syncPayPlanCards();
    syncCardFieldsRequired();
    recalculate();
})();
</script>

<%- include('../partials/footer') %>