    <script>
        const YV_IS_EN = document.documentElement.dataset.yvEn === '1';

        function fallbackYachtImg(imgEl) {
            if (imgEl.dataset.fallbackApplied) return;
            imgEl.dataset.fallbackApplied = '1';
            const svg = encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#0B1F3A"/><stop offset="100%" stop-color="#0F766E"/></linearGradient></defs><rect width="800" height="500" fill="url(#g)"/></svg>');
            imgEl.src = 'data:image/svg+xml;charset=utf-8,' + svg;
        }

        function getBookedRangesFromDom() {
            const seen = new Set();
            const ranges = [];

            function addRange(checkIn, checkOut) {
                const sIn = String(checkIn || '').trim();
                const sOut = String(checkOut || '').trim();
                if (!/^\d{4}-\d{2}-\d{2}$/.test(sIn) || !/^\d{4}-\d{2}-\d{2}$/.test(sOut)) return;
                if (sOut <= sIn) return;
                const key = sIn + '__' + sOut;
                if (seen.has(key)) return;
                seen.add(key);
                ranges.push({ checkIn: sIn, checkOut: sOut });
            }

            document.querySelectorAll('.booked-range').forEach(function (el) {
                addRange(el.dataset.in, el.dataset.out);
            });
            if (Array.isArray(window.YACHT_BOOKED_RANGES)) {
                window.YACHT_BOOKED_RANGES.forEach(function (r) {
                    if (r) addRange(r.checkIn, r.checkOut);
                });
            }
            if (Array.isArray(window.HOME_BOOKED_RANGES)) {
                window.HOME_BOOKED_RANGES.forEach(function (r) {
                    if (r) addRange(r.checkIn, r.checkOut);
                });
            }
            return ranges;
        }

        function formatLocalYMD(dateObj) {
            const y = dateObj.getFullYear();
            const m = String(dateObj.getMonth() + 1).padStart(2, '0');
            const d = String(dateObj.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + d;
        }

        function detectInputRole(inputEl) {
            const id = (inputEl.id || '').toLowerCase();
            const name = (inputEl.name || '').toLowerCase();
            if (id.includes('out') || name.includes('out')) return 'checkout';
            if (id.includes('in') || name.includes('in')) return 'checkin';
            return 'general';
        }

        function isYmdBookedForRole(ymd, ranges, role) {
            if (!Array.isArray(ranges) || ranges.length === 0) return false;
            return ranges.some(function (r) {
                if (role === 'checkout') {
                    return ymd > r.checkIn && ymd <= r.checkOut;
                }
                return ymd >= r.checkIn && ymd < r.checkOut;
            });
        }

