    brandName: 'YachtVoyage',
    brandSubtext: 'Yacht Charter',
    phone: '+90 252 123 45 67',
    whatsappNumber: '902521234567',
    email: 'hello@yachtvoyage.com'
};
const pageTitle = sCfg.brandName + ' — ' + (en ? 'Yacht Charter & Tour Packages' : 'Yat Kiralama & Tur Paketleri');
const activeTabClass = 'bg-white text-[#0B1F3A] shadow-xs';
const idleTabClass = 'text-slate-200 hover:text-white';
