                </div>
                <div>
                    <span class="text-xl font-extrabold tracking-tight block leading-none"><%= sCfg.brandName %></span>
                    <span class="text-[10px] text-sky-300 tracking-[0.2em] uppercase"><%= sCfg.brandSubtext %></span>
