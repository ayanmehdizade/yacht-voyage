<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <% const sCfg = (typeof siteSettings !== 'undefined' && siteSettings) ? siteSettings : {
        brandName: 'YachtVoyage',
        brandSubtext: 'Yacht Charter',
        phone: '+90 252 123 45 67',
        whatsappNumber: '902521234567',
        email: 'hello@yachtvoyage.com'
    }; %>
    <title><%= sCfg.brandName %> — Yat Kiralama &amp; Tur Paketleri</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%230B1F3A'/%3E%3Cpath d='M16 42h32l-4 7H20l-4-7z' fill='%2338BDF8'/%3E%3Cpath d='M33 14v24H19l14-24zm2 4l11 20H35V18z' fill='%23FFFFFF'/%3E%3C/svg%3E">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/tr.js"></script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; overflow-x: hidden; }
        @media print { .no-print { display: none !important; } }
        .yv-dd-menu {
            transform-origin: top center;
            animation: yvDdIn 0.16s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes yvDdIn {
            from { opacity: 0; transform: translateY(-6px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .flatpickr-calendar {
            font-family: 'Plus Jakarta Sans', sans-serif !important;
            border-radius: 18px !important;
            border: 1px solid #e2e8f0 !important;
            box-shadow: 0 20px 45px -10px rgba(11, 31, 58, 0.22) !important;
            padding: 12px !important;
            width: 340px !important;
            max-width: 92vw !important;
            box-sizing: border-box !important;
        }
        .flatpickr-rContainer,
        .flatpickr-days,
        .dayContainer {
            width: 100% !important;
            min-width: 100% !important;
            max-width: 100% !important;
            box-sizing: border-box !important;
        }
        .flatpickr-weekdaycontainer {
            display: grid !important;
            grid-template-columns: repeat(7, minmax(0, 1fr)) !important;
            width: 100% !important;
        }
        span.flatpickr-weekday {
            width: 100% !important;
            max-width: 100% !important;
            color: #64748b !important;
            font-weight: 700 !important;
            font-size: 11px !important;
        }
        .dayContainer {
            display: grid !important;
            grid-template-columns: repeat(7, minmax(0, 1fr)) !important;
            gap: 4px !important;
        }
        .flatpickr-months .flatpickr-month {
            color: #0B1F3A !important;
            fill: #0B1F3A !important;
            height: 36px !important;
        }
        .flatpickr-current-month .flatpickr-monthDropdown-months,
        .flatpickr-current-month input.cur-year {
            font-weight: 800 !important;
            font-size: 14px !important;
            color: #0B1F3A !important;
        }
        .flatpickr-day {
            width: 100% !important;
            max-width: none !important;
            height: 34px !important;
            line-height: 34px !important;
            margin: 0 !important;
            border-radius: 8px !important;
            font-weight: 700 !important;
            font-size: 12px !important;
            background: #dcfce7 !important;
            border-color: #bbf7d0 !important;
            color: #166534 !important;
            box-sizing: border-box !important;
        }
        .flatpickr-day:hover:not(.yv-booked-day):not(.prevMonthDay):not(.nextMonthDay) {
            background: #10b981 !important;
            border-color: #10b981 !important;
            color: #ffffff !important;
        }
        .flatpickr-day.prevMonthDay,
        .flatpickr-day.nextMonthDay {
            background: transparent !important;
            border-color: transparent !important;
            color: #cbd5e1 !important;
            font-weight: 500 !important;
        }
        .flatpickr-day.yv-booked-day,
        .flatpickr-day.yv-booked-day:hover,
        .flatpickr-day.flatpickr-disabled,
        .flatpickr-day.flatpickr-disabled:hover {
            background: #f43f5e !important;
            border-color: #f43f5e !important;
            color: #ffffff !important;
            font-weight: 800 !important;
            opacity: 1 !important;
            cursor: not-allowed !important;
        }
        .flatpickr-day.selected:not(.yv-booked-day),
        .flatpickr-day.selected:hover:not(.yv-booked-day) {
            background: #0B1F3A !important;
            border-color: #0B1F3A !important;
            color: #ffffff !important;
        }
        .yv-cal-legend {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid #f1f5f9;
            font-size: 11px;
            font-weight: 700;
        }
        .yv-legend-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .yv-legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 9999px;
            display: inline-block;
            flex-shrink: 0;
        }
    </style>
    <script>
        function fallbackYachtImg(imgEl) {
            if (imgEl.dataset.fallbackApplied) return;
            imgEl.dataset.fallbackApplied = '1';
            const svg = encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#0B1F3A"/><stop offset="100%" stop-color="#0F766E"/></linearGradient></defs><rect width="800" height="500" fill="url(#g)"/></svg>`);
            imgEl.src = `data:image/svg+xml;charset=utf-8,${svg}`;
        }

        function getBookedRangesFromDom() {
            const seen = new Set();
            const ranges = [];

            function addRange(checkIn, checkOut) {
                if (!checkIn || !checkOut) return;
                const key = `${checkIn}__${checkOut}`;
                if (seen.has(key)) return;
                seen.add(key);
                ranges.push({ checkIn: checkIn, checkOut: checkOut });
            }

            document.querySelectorAll('.booked-range').forEach(function (el) {
                addRange(el.dataset.in, el.dataset.out);
            });
            if (Array.isArray(window.YACHT_BOOKED_RANGES)) {
                window.YACHT_BOOKED_RANGES.forEach(function (r) {
                    if (r) addRange(r.checkIn, r.checkOut);
                });
            }
            if (Array.isArray(window.HOME_BOOKED_RANGES)) {
                window.HOME_BOOKED_RANGES.forEach(function (r) {
                    if (r) addRange(r.checkIn, r.checkOut);
                });
            }
            return ranges;
        }

        function formatLocalYMD(dateObj) {
            const y = dateObj.getFullYear();
            const m = String(dateObj.getMonth() + 1).padStart(2, '0');
            const d = String(dateObj.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function detectInputRole(inputEl) {
            const id = (inputEl.id || '').toLowerCase();
            const name = (inputEl.name || '').toLowerCase();
            if (id.includes('out') || name.includes('out')) return 'checkout';
            if (id.includes('in') || name.includes('in')) return 'checkin';
            return 'general';
        }

        function isYmdBookedForRole(ymd, ranges, role) {
            return ranges.some(function (r) {
                if (role === 'checkout') {
                    return ymd > r.checkIn && ymd <= r.checkOut;
                }
                return ymd >= r.checkIn && ymd < r.checkOut;
            });
        }

        function attachLegendToCalendar(instance) {
            const cal = instance && instance.calendarContainer;
            if (!cal || cal.querySelector('.yv-cal-legend')) return;

            const legend = document.createElement('div');
            legend.className = 'yv-cal-legend';
            legend.innerHTML = `
                <span class="yv-legend-item text-emerald-700">
                    <span class="yv-legend-dot bg-emerald-500"></span>
                    <span>Yeşil: Boş</span>
                </span>
                <span class="yv-legend-item text-rose-700">
                    <span class="yv-legend-dot bg-rose-500"></span>
                    <span>Kırmızı: Dolu</span>
                </span>
            `;
            cal.appendChild(legend);
        }

        function decorateCalendarDays(instance, role) {
            const cal = instance && instance.calendarContainer;
            if (!cal) return;
            const ranges = getBookedRangesFromDom();

            cal.querySelectorAll('.flatpickr-day').forEach(function (dayEl) {
                dayEl.classList.remove('yv-booked-day');
                if (!dayEl.dateObj) return;
                if (dayEl.classList.contains('prevMonthDay') || dayEl.classList.contains('nextMonthDay')) return;
                const ymd = formatLocalYMD(dayEl.dateObj);
                if (isYmdBookedForRole(ymd, ranges, role)) {
                    dayEl.classList.add('yv-booked-day');
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            const mobileBtn = document.getElementById('mobileMenuBtn');
            const mobileMenu = document.getElementById('mobileMenu');
            if (mobileBtn && mobileMenu) {
                mobileBtn.addEventListener('click', function () {
                    mobileMenu.classList.toggle('hidden');
                });
            }

            if (typeof flatpickr !== 'undefined') {
                const instances = [];

                document.querySelectorAll('input[type="date"]:not([data-no-flatpickr="true"])').forEach(function (inp) {
                    const role = detectInputRole(inp);

                    const fp = flatpickr(inp, {
                        locale: 'tr',
                        dateFormat: 'Y-m-d',
                        altInput: true,
                        altFormat: 'd M Y',
                        disableMobile: true,
                        disable: [
                            function (dateObj) {
                                return isYmdBookedForRole(formatLocalYMD(dateObj), getBookedRangesFromDom(), role);
                            }
                        ],
                        onReady: function (_, __, instance) {
                            attachLegendToCalendar(instance);
                            decorateCalendarDays(instance, role);
                        },
                        onOpen: function (_, __, instance) {
                            attachLegendToCalendar(instance);
                            decorateCalendarDays(instance, role);
                        },
                        onMonthChange: function (_, __, instance) {
                            decorateCalendarDays(instance, role);
                        },
                        onYearChange: function (_, __, instance) {
                            decorateCalendarDays(instance, role);
                        },
                        onChange: function (_, __, instance) {
                            instances.forEach(function (item) {
                                decorateCalendarDays(item.fp, item.role);
                            });
                            inp.dispatchEvent(new Event('change', { bubbles: true }));
                        }
                    });

                    instances.push({ fp: fp, role: role });
                });
            }

            const wrappers = document.querySelectorAll('.yv-dropdown');

            function closeAllDropdowns(exceptWrapper) {
                wrappers.forEach(function (w) {
                    if (w === exceptWrapper) return;
                    w.classList.remove('z-[90]');
                    const menu = w.querySelector('.yv-dd-menu');
                    const chevron = w.querySelector('.yv-dd-chevron');
                    if (menu) {
                        menu.classList.add('hidden');
                        menu.classList.remove('bottom-[calc(100%+8px)]');
                        menu.classList.add('top-[calc(100%+8px)]');
                    }
                    if (chevron) chevron.classList.remove('rotate-180');
                });
            }

            function positionMenu(wrapper, menu) {
                menu.classList.remove('bottom-[calc(100%+8px)]');
                menu.classList.add('top-[calc(100%+8px)]');

                const rect = wrapper.getBoundingClientRect();
                const menuHeight = Math.min(menu.scrollHeight || 240, 260);
                const spaceBelow = window.innerHeight - rect.bottom;
                const spaceAbove = rect.top;

                if (spaceBelow < menuHeight + 16 && spaceAbove > spaceBelow) {
                    menu.classList.remove('top-[calc(100%+8px)]');
                    menu.classList.add('bottom-[calc(100%+8px)]');
                }
            }

            wrappers.forEach(function (w) {
                const trigger = w.querySelector('.yv-dd-trigger');
                const menu = w.querySelector('.yv-dd-menu');
                const labelEl = w.querySelector('.yv-dd-label');
                const hiddenInput = w.querySelector('input[type="hidden"]');
                const chevron = w.querySelector('.yv-dd-chevron');
                const options = w.querySelectorAll('.yv-dd-option');

                if (!trigger || !menu) return;

                trigger.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const isHidden = menu.classList.contains('hidden');
                    closeAllDropdowns(w);

                    if (isHidden) {
                        w.classList.add('z-[90]');
                        menu.classList.remove('hidden');
                        positionMenu(w, menu);
                        if (chevron) chevron.classList.add('rotate-180');
                    } else {
                        w.classList.remove('z-[90]');
                        menu.classList.add('hidden');
                        if (chevron) chevron.classList.remove('rotate-180');
                    }
                });

                options.forEach(function (opt) {
                    opt.addEventListener('click', function (e) {
                        e.stopPropagation();
                        const val = this.dataset.value || '';
                        const text = this.dataset.label || this.innerText.trim();

                        if (hiddenInput) hiddenInput.value = val;
                        if (labelEl) labelEl.innerText = text;

                        options.forEach(function (o) {
                            o.classList.remove('bg-slate-100', 'font-bold', 'text-[#0B1F3A]');
                            const check = o.querySelector('.yv-dd-check');
                            if (check) check.classList.add('hidden');
                        });

                        this.classList.add('bg-slate-100', 'font-bold', 'text-[#0B1F3A]');
                        const activeCheck = this.querySelector('.yv-dd-check');
                        if (activeCheck) activeCheck.classList.remove('hidden');

                        w.classList.remove('z-[90]');
                        menu.classList.add('hidden');
                        if (chevron) chevron.classList.remove('rotate-180');
                    });
                });
            });

            document.addEventListener('click', function () {
                closeAllDropdowns(null);
            });

            window.addEventListener('resize', function () {
                wrappers.forEach(function (w) {
                    const menu = w.querySelector('.yv-dd-menu');
                    if (menu && !menu.classList.contains('hidden')) {
                        positionMenu(w, menu);
                    }
                });
            });
        });
    </script>
</head>
<body class="bg-slate-50 text-slate-900 antialiased">
    <div class="no-print bg-[#08172E] text-slate-300 text-xs py-2 px-4 border-b border-white/10">
