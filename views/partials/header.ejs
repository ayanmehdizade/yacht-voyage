            </a>

            <nav class="hidden md:flex items-center space-x-7 text-sm font-medium text-slate-200">
                <a href="/yachts" class="hover:text-white transition">Yatlar</a>
                <a href="/tur-paketleri" class="hover:text-white transition">Tur Paketleri</a>
                <a href="/rotalar" class="hover:text-white transition">Rotalar</a>
                <a href="/kategoriler" class="hover:text-white transition">Kategoriler</a>
                <a href="/my-booking" class="hover:text-white transition">Rezervasyonum</a>
            </nav>

            <div class="hidden md:flex items-center space-x-3">
                <a href="/yachts" class="bg-white text-[#0B1F3A] hover:bg-sky-50 px-5 py-2.5 rounded-lg text-sm font-bold transition shadow">
                    Hemen Rezervasyon Yap
                </a>
            </div>

            <button id="mobileMenuBtn" type="button" class="md:hidden w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center text-white">
                <i class="fa-solid fa-bars text-lg"></i>
            </button>
        </div>

        <div id="mobileMenu" class="hidden md:hidden bg-[#08172E] border-t border-white/10 px-4 py-4 space-y-3 text-sm">
            <a href="/yachts" class="block py-1.5 text-slate-200 hover:text-white">Yatlar</a>
            <a href="/tur-paketleri" class="block py-1.5 text-slate-200 hover:text-white">Tur Paketleri</a>
            <a href="/rotalar" class="block py-1.5 text-slate-200 hover:text-white">Rotalar</a>
            <a href="/kategoriler" class="block py-1.5 text-slate-200 hover:text-white">Kategoriler</a>
            <a href="/my-booking" class="block py-1.5 text-slate-200 hover:text-white">Rezervasyonum (PNR)</a>
            <a href="/admin" class="block py-1.5 text-amber-400 font-semibold">Admin Panel →</a>
            <a href="/yachts" class="block text-center bg-white text-[#0B1F3A] py-2.5 rounded-lg font-bold">Hemen Rezervasyon Yap</a>
        </div>
    </header>