            </div>
            <div class="flex items-center space-x-4">
                <a href="/my-booking" class="hover:text-white transition"><i class="fa-solid fa-ticket text-sky-400 mr-1"></i>PNR Sorgula</a>
                <a href="/admin" class="text-amber-400 hover:text-amber-300 font-semibold transition">Admin Panel →</a>
