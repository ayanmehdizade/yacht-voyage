            const SKIP_TAGS = new Set(['SCRIPT', 'STYLE', 'NOSCRIPT', 'TEXTAREA', 'CODE', 'PRE', 'INPUT', 'SELECT', 'OPTION']);

            function sanitizeTranslatedText(str) {
                return String(str || '')
                    .replace(/<[^>]+>/g, '')
                    .replace(/\s+/g, ' ')
                    .trim();
            }

            function shouldSkipNode(node) {
                const el = node.nodeType === 1 ? node : node.parentElement;
                if (!el) return true;
                if (SKIP_TAGS.has(el.tagName)) return true;
                if (el.closest('[data-no-auto-translate="true"]')) return true;
                return false;
            }

            function normalizeText(raw) {
                return sanitizeTranslatedText(raw);
            }

            function isTranslatableText(clean) {
                if (!clean || clean.length < 2) return false;
                if (/^[\d\s€$₺.,:/+-]+$/.test(clean)) return false;
                if (/^[A-Z0-9_-]{4,}$/.test(clean)) return false;
                return /[çğıöşüÇĞİÖŞÜa-zA-Z]{2,}/.test(clean);
            }

            function getCached(text) {
                try {
                    const val = localStorage.getItem(CACHE_PREFIX + text);
                    return val ? sanitizeTranslatedText(val) : null;
                } catch {
                    return null;
                }
            }

            function setCached(text, val) {
                try {
                    localStorage.setItem(CACHE_PREFIX + text, sanitizeTranslatedText(val));
                } catch {
                    // ignore storage quota errors
                }
            }

            function applyGlossaryPrefix(clean) {
                if (GLOSSARY[clean]) return GLOSSARY[clean];

                const dailyPriceMatch = clean.match(/^Günlük\s+([€$₺]\s*[\d.,]+)$/i);
                if (dailyPriceMatch) {
                    return dailyPriceMatch[1] + ' per day';
                }

                const cabinMatch = clean.match(/^(\d+)\s*Kabin$/i);
                if (cabinMatch) {
                    const n = Number(cabinMatch[1]);
                    return n + ' ' + (n === 1 ? 'Cabin' : 'Cabins');
                }

                const crewMatch = clean.match(/^(\d+)\s*Mürettebat$/i);
                if (crewMatch) {
                    const n = Number(crewMatch[1]);
                    return n + ' ' + (n === 1 ? 'Crew Member' : 'Crew Members');
                }

                const photoCountMatch = clean.match(/^(\d+)\s*\/\s*(\d+)\s*Fotoğraf$/i);
                if (photoCountMatch) {
                    const count = Number(photoCountMatch[2]);
                    return photoCountMatch[1] + ' / ' + photoCountMatch[2] + ' ' + (count === 1 ? 'Photo' : 'Photos');
                }

                const yachtCountMatch = clean.match(/^(\d+)\s*Yat$/i);
                if (yachtCountMatch) {
                    const n = Number(yachtCountMatch[1]);
                    return n + ' ' + (n === 1 ? 'Yacht' : 'Yachts');
                }

                if (clean.startsWith('Yat Kirası (')) {
                    return clean.replace('Yat Kirası (', 'Yacht Charter (').replace('gün)', 'days)');
                }
                if (clean.startsWith('Ekstralar (')) {
                    return clean.replace('Ekstralar (', 'Extras (').replace('kişi)', 'guests)');
                }
                if (clean.startsWith('Ekstra Hizmetler (')) {
                    return clean.replace('Ekstra Hizmetler (', 'Extra Services (').replace('kişi)', 'guests)');
                }
                const maxGuestsMatch = clean.match(/^MİSAFİR SAYISI \(MAKS\.\s*(\d+)\)$/i);
                if (maxGuestsMatch) {
                    return 'GUESTS (MAX. ' + maxGuestsMatch[1] + ')';
                }
                const maxMatch = clean.match(/^MİSAFİR \(MAKS\.\s*(\d+)\)$/i);
                if (maxMatch) {
                    return 'GUESTS (MAX. ' + maxMatch[1] + ')';
                }
                return null;
            }

            async function requestBatchTranslation(stringsToTranslate) {
                const dict = {};
                const uncached = [];

                for (const s of stringsToTranslate) {
                    const mapped = applyGlossaryPrefix(s);
                    if (mapped) {
                        dict[s] = sanitizeTranslatedText(mapped);
                    } else {
                        const c = getCached(s);
                        if (c && c.toLowerCase() !== s.toLowerCase()) {
                            dict[s] = c;
                        } else {
                            uncached.push(s);
                        }
                    }
                }

                for (let i = 0; i < uncached.length; i += 20) {
                    const chunk = uncached.slice(i, i + 20);
                    try {
                        const resp = await fetch('/api/translate', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ texts: chunk })
                        });
                        if (resp.ok) {
                            const data = await resp.json();
                            const remoteMap = (data && data.translations) ? data.translations : {};
                            for (const s of chunk) {
                                const rawOut = (typeof remoteMap[s] === 'string') ? remoteMap[s] : s;
                                const out = sanitizeTranslatedText(rawOut) || s;
                                dict[s] = out;
                                if (out && out.toLowerCase() !== s.toLowerCase()) {
                                    setCached(s, out);
                                }
                            }
                        }
                    } catch {
                        // keep original text on network error
                    }
                }

                return dict;
            }

            const pendingTargets = [];
            let timer = null;

            function collectTarget(node) {
                if (!node || shouldSkipNode(node)) return;

                if (node.nodeType === 3) {
                    const clean = normalizeText(node.nodeValue);
                    if (isTranslatableText(clean)) {
                        pendingTargets.push({ kind: 'text', node: node, raw: node.nodeValue, clean: clean });
                    }
                } else if (node.nodeType === 1) {
                    if (node.placeholder && isTranslatableText(normalizeText(node.placeholder))) {
                        const cleanPh = normalizeText(node.placeholder);
                        pendingTargets.push({ kind: 'attr', attr: 'placeholder', node: node, raw: node.placeholder, clean: cleanPh });
                    }
                    if (node.title && isTranslatableText(normalizeText(node.title))) {
                        const cleanTitle = normalizeText(node.title);
                        pendingTargets.push({ kind: 'attr', attr: 'title', node: node, raw: node.title, clean: cleanTitle });
                    }
                }
            }

            function scanTree(root) {
                if (!root || shouldSkipNode(root)) return;
                const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT | NodeFilter.SHOW_ELEMENT);
                let cur = walker.currentNode;
                while (cur) {
                    collectTarget(cur);
                    cur = walker.nextNode();
                }
            }

            async function runBatch() {
                if (!pendingTargets.length) return;
                const batch = pendingTargets.splice(0, pendingTargets.length);
                const uniqueClean = [...new Set(batch.map(item => item.clean))];
                const dict = await requestBatchTranslation(uniqueClean);

                for (const item of batch) {
                    const translatedClean = dict[item.clean];
                    if (!translatedClean || translatedClean === item.clean) continue;

                    if (item.kind === 'text' && item.node.isConnected) {
                        const replaced = item.raw.replace(item.clean, translatedClean);
                        if (replaced !== item.node.nodeValue) {
                            item.node.nodeValue = replaced;
                        }
                    } else if (item.kind === 'attr' && item.node.isConnected) {
                        const currentAttr = item.node.getAttribute(item.attr) || '';
                        const replacedAttr = currentAttr.replace(item.clean, translatedClean);
                        if (replacedAttr !== currentAttr) {
                            item.node.setAttribute(item.attr, replacedAttr);
                        }
                    }
                }
            }

            function scheduleBatch(delayMs) {
                clearTimeout(timer);
                timer = setTimeout(runBatch, typeof delayMs === 'number' ? delayMs : 60);
            }

            function triggerFullScan(delayMs) {
                scanTree(document.body);
                scheduleBatch(delayMs);
            }

            document.addEventListener('DOMContentLoaded', function () {
                triggerFullScan(30);
                setTimeout(function () {
                    triggerFullScan(30);
                }, 400);

                document.addEventListener('click', function () {
                    setTimeout(function () {
                        triggerFullScan(30);
                    }, 80);
                });

                const observer = new MutationObserver(function (mutations) {
                    for (const m of mutations) {
                        if (m.type === 'characterData') {
                            collectTarget(m.target);
                        } else if (m.type === 'childList') {
                            m.addedNodes.forEach(function (n) {
                                scanTree(n);
                            });
                        }
                    }
                    scheduleBatch(60);
                });

                observer.observe(document.body, {
                    childList: true,
                    characterData: true,
                    subtree: true
                });
            });
        })();

        document.addEventListener('DOMContentLoaded', function () {
            const mobileBtn = document.getElementById('mobileMenuBtn');
            const mobileMenu = document.getElementById('mobileMenu');
            if (mobileBtn && mobileMenu) {
                mobileBtn.addEventListener('click', function () {
                    mobileMenu.classList.toggle('hidden');
                });
            }

            if (typeof flatpickr !== 'undefined') {
                document.querySelectorAll('input[type="date"]:not([data-no-flatpickr="true"])').forEach(function (inp) {
                    const role = detectInputRole(inp);

                    flatpickr(inp, {
                        locale: YV_IS_EN ? 'default' : 'tr',
                        dateFormat: 'Y-m-d',
                        altInput: true,
                        altFormat: 'd M Y',
                        minDate: inp.min || 'today',
                        disableMobile: true,
                        disable: [
                            function (dateObj) {
                                return isYmdBookedForRole(formatLocalYMD(dateObj), getBookedRangesFromDom(), role);
                            }
                        ],
                        onChange: function () {
                            inp.dispatchEvent(new Event('change', { bubbles: true }));
                        }
                    });
                });
            }

            const wrappers = document.querySelectorAll('.yv-dropdown');

            function closeAllDropdowns(exceptWrapper) {
                wrappers.forEach(function (w) {
                    if (w === exceptWrapper) return;
                    w.classList.remove('z-[90]');
                    const menu = w.querySelector('.yv-dd-menu');
                    const chevron = w.querySelector('.yv-dd-chevron');
                    if (menu) {
                        menu.classList.add('hidden');
                        menu.classList.remove('bottom-[calc(100%+8px)]');
                        menu.classList.add('top-[calc(100%+8px)]');
                    }
                    if (chevron) chevron.classList.remove('rotate-180');
                });
            }

            function positionMenu(wrapper, menu) {
                menu.classList.remove('bottom-[calc(100%+8px)]');
                menu.classList.add('top-[calc(100%+8px)]');

                const rect = wrapper.getBoundingClientRect();
                const menuHeight = Math.min(menu.scrollHeight || 240, 260);
                const spaceBelow = window.innerHeight - rect.bottom;
                const spaceAbove = rect.top;

                if (spaceBelow < menuHeight + 16 && spaceAbove > spaceBelow) {
                    menu.classList.remove('top-[calc(100%+8px)]');
                    menu.classList.add('bottom-[calc(100%+8px)]');
                }
            }

            wrappers.forEach(function (w) {
                const trigger = w.querySelector('.yv-dd-trigger');
                const menu = w.querySelector('.yv-dd-menu');
                const labelEl = w.querySelector('.yv-dd-label');
                const hiddenInput = w.querySelector('input[type="hidden"]');
                const chevron = w.querySelector('.yv-dd-chevron');
                const options = w.querySelectorAll('.yv-dd-option');

                if (!trigger || !menu) return;

                trigger.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const isHidden = menu.classList.contains('hidden');
                    closeAllDropdowns(w);

                    if (isHidden) {
                        w.classList.add('z-[90]');
                        menu.classList.remove('hidden');
                        positionMenu(w, menu);
                        if (chevron) chevron.classList.add('rotate-180');
                    } else {
                        w.classList.remove('z-[90]');
                        menu.classList.add('hidden');
                        if (chevron) chevron.classList.remove('rotate-180');
                    }
                });

                options.forEach(function (opt) {
                    opt.addEventListener('click', function (e) {
                        e.stopPropagation();
                        const val = this.dataset.value || '';
                        const text = this.dataset.label || this.innerText.trim();

                        if (hiddenInput) hiddenInput.value = val;
                        if (labelEl) labelEl.innerText = text;

                        options.forEach(function (o) {
                            o.classList.remove('bg-slate-100', 'font-bold', 'text-[#0B1F3A]');
                            const check = o.querySelector('.yv-dd-check');
                            if (check) check.classList.add('hidden');
                        });

                        this.classList.add('bg-slate-100', 'font-bold', 'text-[#0B1F3A]');
                        const activeCheck = this.querySelector('.yv-dd-check');
                        if (activeCheck) activeCheck.classList.remove('hidden');

                        w.classList.remove('z-[90]');
                        menu.classList.add('hidden');
                        if (chevron) chevron.classList.remove('rotate-180');
                    });
                });
            });

            document.addEventListener('click', function () {
                closeAllDropdowns(null);
            });

            window.addEventListener('resize', function () {
                wrappers.forEach(function (w) {
                    const menu = w.querySelector('.yv-dd-menu');
                    if (menu && !menu.classList.contains('hidden')) {
                        positionMenu(w, menu);
                    }
                });
            });
        });
    </script>
</head>
