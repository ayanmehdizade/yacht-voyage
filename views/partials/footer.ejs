            <div class="flex flex-wrap gap-1.5">
                <button type="button" data-wa-msg="Merhaba, Göcek / Marmaris rotaları hakkında bilgi almak istiyorum." class="wa-preset px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px] transition">
                    Rota Bilgisi
                </button>
                <button type="button" data-wa-msg="Merhaba, günlük tur paketleri ve fiyatlar hakkında bilgi alabilir miyim?" class="wa-preset px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px] transition">
                    Tur Paketleri
                </button>
                <button type="button" data-wa-msg="Merhaba, özel şef ve VIP transfer seçeneklerini sormak istiyorum." class="wa-preset px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px] transition">
                    Özel Hizmetler
                </button>
            </div>
            <a id="conciergeWaLink" href="https://wa.me/902521234567?text=Merhaba%2C%20yat%20kiralama%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum." target="_blank" rel="noopener noreferrer" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-xl flex items-center justify-center space-x-2 transition shadow">
                <i class="fa-brands fa-whatsapp text-sm"></i>
                <span>WhatsApp ile Bağlan</span>
            </a>
        </div>
    </div>

    <button id="conciergeToggleBtn" type="button" class="ml-auto bg-[#0B1F3A] hover:bg-sky-900 text-white px-4 py-3 rounded-full shadow-2xl border border-white/15 flex items-center space-x-2.5 text-xs font-bold transition">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <i class="fa-brands fa-whatsapp text-emerald-400 text-base"></i>
        <span>Yat Danışmanı</span>
    </button>
</div>

<script>
    (function () {
        const toggleBtn = document.getElementById('conciergeToggleBtn');
        const closeBtn = document.getElementById('conciergeCloseBtn');
        const box = document.getElementById('conciergeBox');
        const waLink = document.getElementById('conciergeWaLink');

        if (toggleBtn && box) {
            toggleBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                box.classList.toggle('hidden');
            });
        }

        if (closeBtn && box) {
            closeBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                box.classList.add('hidden');
            });
        }

        document.querySelectorAll('.wa-preset').forEach(function (presetBtn) {
            presetBtn.addEventListener('click', function () {
                const msg = this.dataset.waMsg || 'Merhaba, bilgi almak istiyorum.';
                if (waLink) {
                    waLink.href = 'https://wa.me/902521234567?text=' + encodeURIComponent(msg);
                }
                document.querySelectorAll('.wa-preset').forEach(function (b) {
                    b.classList.remove('bg-teal-600', 'text-white');
                    b.classList.add('bg-slate-100', 'text-slate-700');
                });
                this.classList.remove('bg-slate-100', 'text-slate-700');
                this.classList.add('bg-teal-600', 'text-white');
            });
        });

        document.addEventListener('click', function (e) {
            if (box && !box.contains(e.target) && toggleBtn && !toggleBtn.contains(e.target)) {
                box.classList.add('hidden');
            }
        });
    })();
</script>
