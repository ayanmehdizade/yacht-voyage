<%
const fCurLang = (typeof lang !== 'undefined' && lang === 'en') ? 'en' : 'tr';
const fEn = (typeof isEn !== 'undefined') ? Boolean(isEn) : (fCurLang === 'en');
const fCfg = (typeof siteSettings !== 'undefined' && siteSettings) ? siteSettings : {
    brandName: 'YachtVoyage',
    phone: '+90 252 123 45 67',
    whatsappNumber: '902521234567',
    email: 'hello@yachtvoyage.com',
    footerAbout: fEn
        ? 'Private yacht charter and daily boat tour platform with licensed captains across Gocek, Marmaris, Fethiye, and Bodrum.'
        : 'Göcek, Marmaris, Fethiye ve Bodrum koylarında lisanslı kaptanlar ve özel filo ile yat kiralama ve günlük tur platformu.',
    copyrightText: fEn
        ? '© 2026 YachtVoyage. All rights reserved.'
        : '© 2026 YachtVoyage. Tüm hakları saklıdır.',
    conciergeWelcome: fEn
        ? 'Hello! Feel free to message us for route planning, custom menus, or yacht availability.'
        : 'Merhaba! Rota planlaması, özel menü veya tekne müsaitliği için hızlıca yazabilirsiniz.'
};
const fCats = (typeof categories !== 'undefined' && Array.isArray(categories) && categories.length) ? categories : [
    { key: 'Motor Yachts', nameTr: 'Motor Yatlar', nameEn: 'Motor Yachts' },
    { key: 'Gulets', nameTr: 'Guletler', nameEn: 'Gulets' },
    { key: 'Sailing Yachts', nameTr: 'Yelkenli Yatlar', nameEn: 'Sailing Yachts' },
    { key: 'Catamarans', nameTr: 'Katamaranlar', nameEn: 'Catamarans' },
    { key: 'Superyachts', nameTr: 'Süperyatlar', nameEn: 'Superyachts' }
];
const fDeps = (typeof departurePoints !== 'undefined' && Array.isArray(departurePoints) && departurePoints.length) ? departurePoints : [
    { name: 'Göcek', desc: fEn ? 'Gocek Bays' : 'Göcek Koyları' },
    { name: 'Marmaris', desc: fEn ? 'Marmaris & Paradise Island' : 'Marmaris & Cennet Adası' },
    { name: 'Fethiye', desc: 'Fethiye' },
    { name: 'Bodrum', desc: 'Bodrum' }
];
const presetRouteMsg = fEn
    ? 'Hello, I would like information about Marmaris, Gocek, Fethiye and Bodrum routes.'
    : 'Merhaba, Marmaris, Göcek, Fethiye ve Bodrum rotaları hakkında bilgi almak istiyorum.';
const presetToursMsg = fEn
    ? 'Hello, could I get details on daily tour packages, times, meeting points and pricing?'
    : 'Merhaba, günlük tur paketleri, saatler, görüş yerleri ve fiyatlar hakkında bilgi alabilir miyim?';
const presetServicesMsg = fEn
    ? 'Hello, I would like to ask about what is included and special services.'
    : 'Merhaba, fiyata dahil olanlar ve özel hizmet seçeneklerini sormak istiyorum.';
const defaultWaUrl = 'https://wa.me/' + fCfg.whatsappNumber + '?text=' + encodeURIComponent(
    fEn ? 'Hello, I would like information about yacht charter.' : 'Merhaba, yat kiralama hakkında bilgi almak istiyorum.'
);
%>

<footer class="no-print bg-[#0B1F3A] text-slate-300 mt-20 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14 grid grid-cols-1 md:grid-cols-4 gap-10 text-sm">
        <div class="space-y-3">
            <div class="text-white text-xl font-extrabold flex items-center space-x-2">
                <i class="fa-solid fa-sailboat text-sky-400"></i>
                <span><%= fCfg.brandName %></span>
            </div>
            <p class="text-slate-400 text-xs leading-relaxed">
                <%= fCfg.footerAbout %>
            </p>
        </div>
        <div>
            <h4 class="text-white font-bold mb-3"><%= fEn ? 'Yacht Categories' : 'Yat Kategorileri' %></h4>
            <ul class="space-y-2 text-xs text-slate-400">
                <% fCats.forEach(function(cat) { %>
                    <li>
                        <a href="/yachts?category=<%= encodeURIComponent(cat.key) %>" class="hover:text-white transition">
                            <%= fEn ? (cat.nameEn || cat.nameTr || cat.title || cat.key) : (cat.nameTr || cat.title || cat.key) %>
                        </a>
                    </li>
                <% }) %>
            </ul>
        </div>
        <div>
            <h4 class="text-white font-bold mb-3"><%= fEn ? 'Popular Routes' : 'Popüler Rotalar' %></h4>
            <ul class="space-y-2 text-xs text-slate-400">
                <% fDeps.forEach(function(dep) { %>
                    <li>
                        <a href="/yachts?location=<%= encodeURIComponent(dep.name) %>" class="hover:text-white transition">
                            <%= dep.desc || dep.name %>
                        </a>
                    </li>
                <% }) %>
            </ul>
        </div>
        <div class="space-y-2.5">
            <h4 class="text-white font-bold mb-3"><%= fEn ? '24/7 Support' : '7/24 Destek' %></h4>
            <div class="text-white font-bold text-sm"><%= fCfg.phone %></div>
            <div class="text-sky-400 text-xs"><%= fCfg.email %></div>
            <div class="pt-1">
                <a href="https://wa.me/<%= fCfg.whatsappNumber %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center space-x-1.5 text-xs font-bold text-emerald-400 hover:text-emerald-300 transition">
                    <i class="fa-brands fa-whatsapp text-sm"></i>
                    <span><%= fEn ? 'WhatsApp Support Line' : 'WhatsApp Destek Hattı' %></span>
                </a>
            </div>
            <div class="pt-2 flex items-center space-x-3 text-xs">
                <a href="/admin" class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white font-bold transition">
                    <i class="fa-solid fa-user-shield text-sky-400"></i>
                    <span><%= fEn ? 'Admin Panel' : 'Admin Girişi' %></span>
                </a>
                <a href="/lang/<%= fEn ? 'tr' : 'en' %>" class="text-slate-400 hover:text-white font-bold underline">
                    <%= fEn ? 'Türkçe' : 'English' %>
                </a>
            </div>
        </div>
    </div>
    <div class="border-t border-white/10 py-5 text-center text-xs text-slate-500">
        <%= fCfg.copyrightText %>
    </div>
</footer>

<!-- CANLI YAT KONSYERJ WIDGET -->
<div id="conciergeConfig" data-wa="<%= fCfg.whatsappNumber %>" class="hidden"></div>
<div class="no-print fixed bottom-5 right-5 z-50">
    <div id="conciergeBox" class="hidden mb-3 w-80 bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden text-slate-800">
        <div class="bg-[#0B1F3A] text-white p-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-9 h-9 rounded-full bg-teal-500/20 border border-teal-400/40 flex items-center justify-center text-teal-300">
                    <i class="fa-solid fa-headset"></i>
                </div>
                <div>
                    <div class="text-xs font-extrabold"><%= fCfg.brandName %> <%= fEn ? 'Concierge' : 'Konsyerj' %></div>
                    <div class="text-[10px] text-emerald-300 flex items-center">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5"></span><%= fEn ? 'Online • Avg. 3 min reply' : 'Çevrimiçi • Ort. 3 dk yanıt' %>
                    </div>
                </div>
            </div>
            <button id="conciergeCloseBtn" type="button" class="text-slate-300 hover:text-white text-xs p-1">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="p-4 space-y-3 text-xs">
            <p id="conciergePreviewText" class="text-slate-600 bg-slate-50 p-3 rounded-2xl leading-relaxed">
                <%= fCfg.conciergeWelcome %>
            </p>
            <div class="flex flex-wrap gap-1.5">
                <button type="button" data-wa-msg="<%= presetRouteMsg %>" class="wa-preset px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px] transition">
                    <%= fEn ? 'Route Info' : 'Rota Bilgisi' %>
                </button>
                <button type="button" data-wa-msg="<%= presetToursMsg %>" class="wa-preset px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px] transition">
                    <%= fEn ? 'Tour Packages' : 'Tur Paketleri' %>
                </button>
                <button type="button" data-wa-msg="<%= presetServicesMsg %>" class="wa-preset px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px] transition">
                    <%= fEn ? 'Special Services' : 'Özel Hizmetler' %>
                </button>
            </div>
            <a id="conciergeWaLink" href="<%= defaultWaUrl %>" target="_blank" rel="noopener noreferrer" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-xl flex items-center justify-center space-x-2 transition shadow">
                <i class="fa-brands fa-whatsapp text-sm"></i>
                <span><%= fEn ? 'Connect via WhatsApp' : 'WhatsApp ile Bağlan' %></span>
            </a>
        </div>
    </div>

    <button id="conciergeToggleBtn" type="button" class="ml-auto bg-[#0B1F3A] hover:bg-sky-900 text-white px-4 py-3 rounded-full shadow-2xl border border-white/15 flex items-center space-x-2.5 text-xs font-bold transition">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <i class="fa-brands fa-whatsapp text-emerald-400 text-base"></i>
        <span><%= fEn ? 'Yacht Advisor' : 'Yat Danışmanı' %></span>
    </button>
</div>

<script>
    (function () {
        const cfgEl = document.getElementById('conciergeConfig');
        const waNum = (cfgEl && cfgEl.dataset.wa) ? cfgEl.dataset.wa : '902521234567';
        const toggleBtn = document.getElementById('conciergeToggleBtn');
        const closeBtn = document.getElementById('conciergeCloseBtn');
        const box = document.getElementById('conciergeBox');
        const waLink = document.getElementById('conciergeWaLink');
        const previewEl = document.getElementById('conciergePreviewText');

        if (toggleBtn && box) {
            toggleBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                box.classList.toggle('hidden');
            });
        }

        if (closeBtn && box) {
            closeBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                box.classList.add('hidden');
            });
        }

        document.querySelectorAll('.wa-preset').forEach(function (presetBtn) {
            presetBtn.addEventListener('click', function () {
                const msg = this.dataset.waMsg || 'Merhaba, bilgi almak istiyorum.';
                if (waLink) {
                    waLink.href = 'https://wa.me/' + waNum + '?text=' + encodeURIComponent(msg);
                }
                if (previewEl) {
                    previewEl.textContent = msg;
                }
                document.querySelectorAll('.wa-preset').forEach(function (b) {
                    b.classList.remove('bg-teal-600', 'text-white');
                    b.classList.add('bg-slate-100', 'text-slate-700');
                });
                this.classList.remove('bg-slate-100', 'text-slate-700');
                this.classList.add('bg-teal-600', 'text-white');
            });
        });

        document.addEventListener('click', function (e) {
            if (box && !box.contains(e.target) && toggleBtn && !toggleBtn.contains(e.target)) {
                box.classList.add('hidden');
            }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && box) {
                box.classList.add('hidden');
            }
        });
    })();
</script>
</body>
</html>