<!-- MOBİL MENÜ -->
<div id="adminMobileDrawer" class="hidden md:hidden bg-[#08172E] text-slate-200 border-b border-white/10 px-4 py-3 space-y-1.5 text-xs z-30">
    <button type="button" data-admin-tab="dashboard" class="admin-nav-btn w-full text-left flex items-center space-x-2.5 px-3.5 py-2.5 rounded-xl bg-teal-600 text-white font-bold">
        <i class="fa-solid fa-chart-pie w-4"></i><span>Dashboard</span>
    </button>
    <button type="button" data-admin-tab="rezervasyonlar" class="admin-nav-btn w-full text-left flex items-center space-x-2.5 px-3.5 py-2.5 rounded-xl hover:bg-white/10 font-semibold">
        <i class="fa-solid fa-calendar-check w-4"></i><span><%= isAdminEn ? 'Bookings' : 'Rezervasyonlar' %></span>
    </button>
    <button type="button" data-admin-tab="filo-listesi" class="admin-nav-btn w-full text-left flex items-center space-x-2.5 px-3.5 py-2.5 rounded-xl hover:bg-white/10 font-semibold">
        <i class="fa-solid fa-ship w-4"></i><span><%= isAdminEn ? 'Active Fleet & Capacity' : 'Aktif Filo & Kapasite' %></span>
    </button>
    <button type="button" data-admin-tab="turlar-kategoriler" class="admin-nav-btn w-full text-left flex items-center space-x-2.5 px-3.5 py-2.5 rounded-xl hover:bg-white/10 font-semibold">
        <i class="fa-solid fa-compass w-4"></i><span><%= isAdminEn ? 'Tours & Categories' : 'Turlar & Kategoriler' %></span>
    </button>
    <button type="button" data-admin-tab="ayarlar" class="admin-nav-btn w-full text-left flex items-center space-x-2.5 px-3.5 py-2.5 rounded-xl hover:bg-white/10 font-semibold">
        <i class="fa-solid fa-sliders w-4"></i><span><%= isAdminEn ? 'Site, Promo & Contract' : 'Site, Promokod & Sözleşme' %></span>
    </button>
    <div class="pt-2 border-t border-white/10 flex items-center justify-between text-[11px] text-slate-400">
        <span><%= (typeof adminUser !== 'undefined' && adminUser && adminUser.name) ? adminUser.name : 'CRM Panel' %></span>
        <form action="/admin/logout" method="POST">
            <button type="submit" class="px-3 py-1.5 rounded-lg bg-rose-600 text-white font-bold">
                <%= isAdminEn ? 'Log Out' : 'Çıkış Yap' %>
            </button>
        </form>
    </div>
</div>

<!-- MASAÜSTÜ SIDEBAR -->
