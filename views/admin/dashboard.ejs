<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yacht CRM — Admin Panel</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%230B1F3A'/%3E%3Cpath d='M16 42h32l-4 7H20l-4-7z' fill='%2338BDF8'/%3E%3Cpath d='M33 14v24H19l14-24zm2 4l11 20H35V18z' fill='%23FFFFFF'/%3E%3C/svg%3E">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 text-slate-900 flex min-h-screen">
    <!-- Sidebar -->
    <aside class="w-64 bg-[#0B1F3A] text-slate-300 p-6 flex flex-col justify-between shrink-0">
        <div>
            <div class="text-white font-extrabold text-lg mb-7 flex items-center space-x-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center">
                    <i class="fa-solid fa-sailboat text-sky-400"></i>
                </div>
                <div>
                    <span class="block leading-none">Yacht CRM</span>
                    <span class="text-[10px] text-sky-300 tracking-widest uppercase">Operations</span>
                </div>
            </div>
            <nav class="space-y-1.5 text-sm" id="adminSidebarNav">
                <button type="button" data-admin-tab="dashboard" class="admin-nav-btn w-full text-left flex items-center space-x-3 p-3 bg-teal-600 text-white rounded-xl font-semibold shadow transition">
                    <i class="fa-solid fa-chart-pie w-4"></i><span>Dashboard</span>
                </button>
                <button type="button" data-admin-tab="yeni-yat" class="admin-nav-btn w-full text-left flex items-center space-x-3 p-3 hover:bg-white/10 rounded-xl transition">
                    <i class="fa-solid fa-plus-circle w-4"></i><span>Yeni Yat Ekle</span>
                </button>
                <button type="button" data-admin-tab="rezervasyonlar" class="admin-nav-btn w-full text-left flex items-center space-x-3 p-3 hover:bg-white/10 rounded-xl transition">
                    <i class="fa-solid fa-calendar-check w-4"></i><span>Rezervasyonlar</span>
                </button>
                <button type="button" data-admin-tab="filo-listesi" class="admin-nav-btn w-full text-left flex items-center space-x-3 p-3 hover:bg-white/10 rounded-xl transition">
                    <i class="fa-solid fa-ship w-4"></i><span>Aktif Filo</span>
                </button>
                <a href="/" class="flex items-center space-x-3 p-3 hover:bg-white/10 rounded-xl transition">
                    <i class="fa-solid fa-globe w-4"></i><span>Müşteri Sitesi</span>
                </a>
            </nav>
        </div>
        <div class="text-xs text-slate-400 border-t border-white/10 pt-4 space-y-3">
            <div>
                <div class="font-bold text-white">Özcan Uçar</div>
                <div>Club &amp; Fleet Manager • CRM v2</div>
            </div>
            <form action="/admin/logout" method="POST">
                <button type="submit" class="w-full py-2 px-3 rounded-xl bg-white/10 hover:bg-rose-600/80 text-white font-bold text-xs transition flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Çıkış Yap</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-8 space-y-6 overflow-x-auto">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <h1 id="adminPageTitle" class="text-2xl font-extrabold text-[#0B1F3A]">Dashboard &amp; Genel Bakış</h1>
                <p id="adminPageSubtitle" class="text-xs text-slate-500 mt-0.5">Genel performans metrikleri ve özet durum</p>
            </div>
            <a href="/" class="text-xs bg-white border border-slate-200 px-4 py-2.5 rounded-xl font-bold text-slate-700 hover:bg-slate-50 shadow-sm">
                ← Müşteri Sayfasına Dön
            </a>
        </div>

        <% if (typeof notice !== 'undefined' && notice) { %>
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-2xl text-xs font-bold flex items-center space-x-2">
                <i class="fa-solid fa-circle-check text-emerald-600"></i>
                <span><%= notice %></span>
            </div>
        <% } %>

        <!-- BÖLÜM 1: DASHBOARD -->
        <section id="view-dashboard" class="admin-view space-y-6">
            <% const activeBookingsCount = bookings.filter(b => b.status !== 'İptal Edildi' && b.status !== 'İptal').length; %>
            <% const pendingBookingsCount = bookings.filter(b => b.status === 'Ödeme Bekliyor' || b.status === 'Beklemede').length; %>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                    <span class="text-slate-400 text-xs font-bold uppercase">Toplam Rezervasyon</span>
                    <h3 class="text-3xl font-extrabold text-[#0B1F3A] mt-2"><%= bookings.length %></h3>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                    <span class="text-slate-400 text-xs font-bold uppercase">Aktif / Onaylı İşlem</span>
                    <h3 class="text-3xl font-extrabold text-emerald-700 mt-2"><%= activeBookingsCount %></h3>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                    <span class="text-slate-400 text-xs font-bold uppercase">Aktif Yat Filosu</span>
                    <h3 class="text-3xl font-extrabold text-[#0B1F3A] mt-2"><%= yachts.length %></h3>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                    <span class="text-slate-400 text-xs font-bold uppercase">Tahsilat / Aktif Hacim</span>
                    <h3 class="text-3xl font-extrabold text-teal-700 mt-2">€<%= Number(totalRevenue || 0).toLocaleString() %></h3>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <button type="button" data-admin-tab="yeni-yat" class="admin-nav-btn bg-white hover:border-teal-500 p-6 rounded-2xl border border-slate-200 shadow-sm text-left transition space-y-2">
                    <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center"><i class="fa-solid fa-plus"></i></div>
                    <div class="font-extrabold text-slate-900 text-sm">Yeni Yat Ekle →</div>
                    <p class="text-xs text-slate-500">Filoya yeni tekne ve günlük fiyat tanımlayın.</p>
                </button>
                <button type="button" data-admin-tab="rezervasyonlar" class="admin-nav-btn bg-white hover:border-teal-500 p-6 rounded-2xl border border-slate-200 shadow-sm text-left transition space-y-2">
                    <div class="w-10 h-10 rounded-xl bg-sky-50 text-[#0B1F3A] flex items-center justify-center"><i class="fa-solid fa-calendar-check"></i></div>
                    <div class="font-extrabold text-slate-900 text-sm">Rezervasyonları Yönet (<%= pendingBookingsCount %> Bekleyen) →</div>
                    <p class="text-xs text-slate-500">Gelen talepleri onaylayın, beklemeye alın veya PNR arayın.</p>
                </button>
                <button type="button" data-admin-tab="filo-listesi" class="admin-nav-btn bg-white hover:border-teal-500 p-6 rounded-2xl border border-slate-200 shadow-sm text-left transition space-y-2">
                    <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center"><i class="fa-solid fa-ship"></i></div>
                    <div class="font-extrabold text-slate-900 text-sm">Aktif Filoyu Görüntüle →</div>
                    <p class="text-xs text-slate-500">Kayıtlı yatları inceleyin ve günlük fiyatlarını güncelleyin.</p>
                </button>
            </div>
        </section>

        <!-- BÖLÜM 2: YENİ YAT EKLE -->
        <section id="view-yeni-yat" class="admin-view hidden bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h3 class="font-extrabold text-slate-900 text-base">Sisteme Yeni Yat Ekle</h3>
            <form action="/admin/add-yacht" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-3.5">
                <input type="text" name="name" placeholder="Yat Adı (Örn: Azimut 60)" required class="p-2.5 border border-slate-200 rounded-xl text-xs font-medium">
                <select name="category" class="p-2.5 border border-slate-200 rounded-xl text-xs font-medium bg-white">
                    <option value="Motor Yachts">Motor Yachts</option>
                    <option value="Gulets">Gulets</option>
                    <option value="Sailing Yachts">Sailing Yachts</option>
                    <option value="Catamarans">Catamarans</option>
                    <option value="Superyachts">Superyachts</option>
                </select>
                <input type="text" name="categoryTr" placeholder="Tür Adı (Örn: Motor Yat)" required class="p-2.5 border border-slate-200 rounded-xl text-xs font-medium">
                <input type="text" name="location" placeholder="Liman (Göcek, Marmaris...)" required class="p-2.5 border border-slate-200 rounded-xl text-xs font-medium">
                <input type="text" name="length" placeholder="Uzunluk (Örn: 19 m)" class="p-2.5 border border-slate-200 rounded-xl text-xs font-medium">
                <input type="number" name="price" placeholder="Günlük Fiyat (€)" required class="p-2.5 border border-slate-200 rounded-xl text-xs font-medium">
                <input type="number" name="guests" placeholder="Kişi Kapasitesi" required class="p-2.5 border border-slate-200 rounded-xl text-xs font-medium">
                <input type="number" name="cabins" placeholder="Kabin Sayısı" class="p-2.5 border border-slate-200 rounded-xl text-xs font-medium">
                <input type="text" name="image" placeholder="Görsel URL (İsteğe bağlı)" class="md:col-span-2 p-2.5 border border-slate-200 rounded-xl text-xs font-medium">
                <input type="text" name="description" placeholder="Kısa açıklama" class="p-2.5 border border-slate-200 rounded-xl text-xs font-medium">
                <button type="submit" class="bg-teal-600 hover:bg-teal-700 text-white py-2.5 px-4 rounded-xl font-bold text-xs transition shadow">
                    + Yat Veritabanına Kaydet
                </button>
            </form>
        </section>

        <!-- BÖLÜM 3: REZERVASYONLAR -->
        <section id="view-rezervasyonlar" class="admin-view hidden bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="font-extrabold text-slate-900 text-base mr-2">Rezervasyon Talepleri (<%= bookings.length %>)</span>
                    <button type="button" data-status-filter="all" class="status-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-bold bg-[#0B1F3A] text-white">Tümü</button>
                    <button type="button" data-status-filter="Onaylandı" class="status-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-bold bg-slate-100 text-slate-700 hover:bg-slate-200">Onaylandı</button>
                    <button type="button" data-status-filter="Ödeme Bekliyor" class="status-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-bold bg-slate-100 text-slate-700 hover:bg-slate-200">Beklemede</button>
                    <button type="button" data-status-filter="İptal Edildi" class="status-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-bold bg-slate-100 text-slate-700 hover:bg-slate-200">İptal</button>
                </div>
                <input id="bookingSearchInput" type="text" placeholder="PNR, müşteri veya yat ara..." class="px-3.5 py-2 text-xs border border-slate-200 rounded-xl w-full sm:w-64 focus:outline-none">
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 text-slate-400 uppercase text-[10px]">
                        <tr>
                            <th class="p-4">PNR</th>
                            <th class="p-4">Müşteri</th>
                            <th class="p-4">Yat</th>
                            <th class="p-4">Tarih &amp; Kişi</th>
                            <th class="p-4">Toplam / Alınan</th>
                            <th class="p-4">Durum</th>
                            <th class="p-4 text-right">İşlem</th>
                        </tr>
                    </thead>
                    <tbody id="bookingsTableBody" class="divide-y divide-slate-100">
                        <% bookings.forEach(b => { %>
                            <% const displayTotal = Number(b.totalAmount || b.amount || 0); %>
                            <% const displayPaid = Number(b.paidAmount || 0); %>
                            <% const dateText = b.checkIn ? (b.checkIn + ' → ' + b.checkOut) : (b.date || ''); %>
                            <% const normStatus = (b.status === 'İptal') ? 'İptal Edildi' : ((b.status === 'Beklemede') ? 'Ödeme Bekliyor' : (b.status || 'Ödeme Bekliyor')); %>
                            <tr class="booking-row hover:bg-slate-50/70" data-booking-status="<%= normStatus %>">
                                <td class="p-4 font-mono font-bold text-[#0B1F3A]"><%= b.id %></td>
                                <td class="p-4">
                                    <div class="font-bold text-slate-900"><%= b.customer %></div>
                                    <% if (b.phone) { %><div class="text-[11px] text-slate-400"><%= b.phone %></div><% } %>
                                </td>
                                <td class="p-4 font-semibold text-slate-700"><%= b.yacht %></td>
                                <td class="p-4 text-slate-600"><%= dateText %> • <strong><%= b.guests %></strong> kişi</td>
                                <td class="p-4">
                                    <div class="font-extrabold text-slate-900">€<%= displayTotal.toLocaleString() %></div>
                                    <div class="text-[11px] text-teal-700 font-semibold">Tahsilat: €<%= displayPaid.toLocaleString() %></div>
                                </td>
                                <td class="p-4">
                                    <% if (normStatus === 'Onaylandı') { %>
                                        <span class="bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded-full font-bold">Onaylandı</span>
                                    <% } else if (normStatus === 'İptal Edildi') { %>
                                        <span class="bg-rose-100 text-rose-700 px-2.5 py-1 rounded-full font-bold">İptal Edildi</span>
                                    <% } else { %>
                                        <span class="bg-amber-100 text-amber-700 px-2.5 py-1 rounded-full font-bold"><%= normStatus %></span>
                                    <% } %>
                                </td>
                                <td class="p-4 text-right space-x-1 whitespace-nowrap">
                                    <form action="/admin/bookings/<%= b.id %>/status" method="POST" class="inline">
                                        <input type="hidden" name="status" value="Onaylandı">
                                        <button type="submit" class="px-2.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold transition">Onayla</button>
                                    </form>
                                    <form action="/admin/bookings/<%= b.id %>/status" method="POST" class="inline">
                                        <input type="hidden" name="status" value="Ödeme Bekliyor">
                                        <button type="submit" class="px-2.5 py-1.5 bg-amber-100 hover:bg-amber-200 text-amber-800 rounded-lg font-bold transition">Beklet</button>
                                    </form>
                                    <form action="/admin/bookings/<%= b.id %>/status" method="POST" class="inline">
                                        <input type="hidden" name="status" value="İptal Edildi">
                                        <button type="submit" class="px-2.5 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-bold transition">İptal</button>
                                    </form>
                                    <form action="/admin/bookings/<%= b.id %>/delete" method="POST" class="inline">
                                        <button type="submit" class="px-2.5 py-1.5 text-rose-600 hover:bg-rose-50 rounded-lg transition" title="Sil"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- BÖLÜM 4: AKTİF FİLO -->
        <section id="view-filo-listesi" class="admin-view hidden bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-100 font-extrabold text-slate-900 text-base">Aktif Yat Filosu (<%= yachts.length %>)</div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 text-slate-400 uppercase text-[10px]">
                        <tr>
                            <th class="p-4">Ad</th>
                            <th class="p-4">Tür &amp; Liman</th>
                            <th class="p-4">Kapasite</th>
                            <th class="p-4">Günlük Fiyat Güncelle</th>
                            <th class="p-4 text-right">İşlem</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% yachts.forEach(y => { %>
                            <tr class="hover:bg-slate-50/70">
                                <td class="p-4 font-bold text-slate-900"><%= y.name %></td>
                                <td class="p-4 text-slate-600"><%= y.categoryTr || y.type %> • <%= y.location %></td>
                                <td class="p-4 text-slate-700"><%= y.guests %> kişi</td>
                                <td class="p-4">
                                    <form action="/admin/yachts/<%= y.id %>/price" method="POST" class="inline-flex items-center space-x-2">
                                        <span class="font-bold text-slate-400">€</span>
                                        <input type="number" name="price" value="<%= Number(y.price || 0) %>" min="1" class="w-24 px-2.5 py-1.5 border border-slate-200 rounded-lg text-xs font-bold text-slate-900">
                                        <button type="submit" class="px-2.5 py-1.5 bg-teal-600 hover:bg-teal-700 text-white rounded-lg font-bold transition">Kaydet</button>
                                    </form>
                                </td>
                                <td class="p-4 text-right">
                                    <form action="/admin/yachts/<%= y.id %>/delete" method="POST" class="inline">
                                        <button type="submit" class="px-3 py-1.5 text-rose-600 hover:bg-rose-50 rounded-lg font-bold transition">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <script>
        const tabMeta = {
            'dashboard': {
                title: 'Dashboard & Genel Bakış',
                subtitle: 'Genel performans metrikleri ve özet durum'
            },
            'yeni-yat': {
                title: 'Yeni Yat Ekle',
                subtitle: 'Sisteme yeni tekne, kapasite ve günlük tarife tanımlayın'
            },
            'rezervasyonlar': {
                title: 'Rezervasyon Yönetimi',
                subtitle: 'Müşteri rezervasyon taleplerini onaylayın, beklemeye alın veya PNR arayın'
            },
            'filo-listesi': {
                title: 'Aktif Yat Filosu',
                subtitle: 'Sistemde yayında olan yatları yönetin ve günlük fiyatlarını güncelleyin'
            }
        };

        function switchAdminTab(tabKey) {
            const targetKey = tabMeta[tabKey] ? tabKey : 'dashboard';

            document.querySelectorAll('.admin-view').forEach(function (view) {
                view.classList.toggle('hidden', view.id !== 'view-' + targetKey);
            });

            document.querySelectorAll('#adminSidebarNav .admin-nav-btn').forEach(function (btn) {
                const isActive = btn.dataset.adminTab === targetKey;
                btn.className = isActive
                    ? 'admin-nav-btn w-full text-left flex items-center space-x-3 p-3 bg-teal-600 text-white rounded-xl font-semibold shadow transition'
                    : 'admin-nav-btn w-full text-left flex items-center space-x-3 p-3 hover:bg-white/10 rounded-xl transition';
            });

            document.getElementById('adminPageTitle').innerText = tabMeta[targetKey].title;
            document.getElementById('adminPageSubtitle').innerText = tabMeta[targetKey].subtitle;
        }

        document.querySelectorAll('.admin-nav-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                switchAdminTab(this.dataset.adminTab);
            });
        });

        const urlParams = new URLSearchParams(window.location.search);
        switchAdminTab(urlParams.get('tab') || 'dashboard');

        let currentStatusFilter = 'all';
        const searchInput = document.getElementById('bookingSearchInput');

        function filterBookings() {
            const q = searchInput ? searchInput.value.trim().toLowerCase() : '';
            document.querySelectorAll('.booking-row').forEach(function (row) {
                const statusMatch = currentStatusFilter === 'all' || row.dataset.bookingStatus === currentStatusFilter;
                const textMatch = !q || row.innerText.toLowerCase().includes(q);
                row.classList.toggle('hidden', !(statusMatch && textMatch));
            });
        }

        document.querySelectorAll('.status-filter-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                currentStatusFilter = this.dataset.statusFilter;
                document.querySelectorAll('.status-filter-btn').forEach(function (b) {
                    const active = b.dataset.statusFilter === currentStatusFilter;
                    b.className = active
                        ? 'status-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-bold bg-[#0B1F3A] text-white'
                        : 'status-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-bold bg-slate-100 text-slate-700 hover:bg-slate-200';
                });
                filterBookings();
            });
        });

        if (searchInput) {
            searchInput.addEventListener('input', filterBookings);
        }
    </script>
</body>
</html>