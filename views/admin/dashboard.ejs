        <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center">
            <i class="fa-solid fa-sailboat text-sky-400"></i>
        </div>
        <div>
            <span class="font-extrabold text-sm block leading-none">Yacht CRM</span>
            <span class="text-[10px] text-sky-300 tracking-[0.18em]">OPERATIONS</span>
