<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yacht CRM — Admin Panel</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%230B1F3A'/%3E%3Cpath d='M16 42h32l-4 7H20l-4-7z' fill='%2338BDF8'/%3E%3Cpath d='M33 14v24H19l14-24zm2 4l11 20H35V18z' fill='%23FFFFFF'/%3E%3C/svg%3E">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }
        @media (min-width: 768px) {
            body.sidebar-collapsed .admin-sidebar {
                display: none !important;
            }
        }
        @media (max-width: 767.98px) {
            .admin-main-wrap { padding: 1rem !important; }
            .admin-top-header { flex-direction: column; align-items: flex-start !important; gap: 0.75rem; }
            .admin-action-btn { min-height: 34px; display: inline-flex; align-items: center; justify-content: center; }
            .admin-table th, .admin-table td { padding: 0.7rem 0.75rem !important; white-space: nowrap; }
        }
        #bookingDetailDrawer.drawer-open {
            pointer-events: auto;
        }
        #bookingDetailDrawer.drawer-open #bookingDrawerBackdrop {
            opacity: 1;
        }
        #bookingDetailDrawer.drawer-open #bookingDrawerPanel {
            transform: translateX(0);
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen flex flex-col md:flex-row">
    <%
        const safeBookings = (typeof bookings !== 'undefined' && Array.isArray(bookings)) ? bookings : [];
        const safeYachts = (typeof yachts !== 'undefined' && Array.isArray(yachts)) ? yachts : [];
        const safeTours = (typeof tours !== 'undefined' && Array.isArray(tours)) ? tours : [];
        const safeCategories = (typeof categories !== 'undefined' && Array.isArray(categories)) ? categories : [];
        const safeExtras = (typeof extras !== 'undefined' && Array.isArray(extras)) ? extras : [];
        const safePayments = (typeof paymentOptions !== 'undefined' && Array.isArray(paymentOptions)) ? paymentOptions : [];
        const safeDepartures = (typeof departurePoints !== 'undefined' && Array.isArray(departurePoints)) ? departurePoints : [];
        const safeAdminUsers = (typeof adminUsers !== 'undefined' && Array.isArray(adminUsers)) ? adminUsers : [];
        const safePromoCodes = (typeof promoCodes !== 'undefined' && Array.isArray(promoCodes)) ? promoCodes : [];
        const safeTimeSlots = (typeof timeSlots !== 'undefined' && Array.isArray(timeSlots)) ? timeSlots : [];
        const safeCaptains = (typeof captains !== 'undefined' && Array.isArray(captains)) ? captains : [];
        const safeFaqs = (typeof faqs !== 'undefined' && Array.isArray(faqs)) ? faqs : [];
        const safeReviews = (typeof allReviews !== 'undefined' && Array.isArray(allReviews)) ? allReviews : [];

        const defaultWaTpl =
            'Merhaba {customer}, {yacht} için rezervasyonunuz oluşturuldu.\n' +
            'PNR: {pnr}\n' +
            'Tarih: {checkIn} - {checkOut} ({timeSlot})\n' +
            'Misafir: {guests} kişi\n' +
            'Toplam: €{totalAmount} | Ödenen: €{paidAmount} | Kalan: €{remainingAmount}\n' +
            'Kaptan: {captain} | Transfer: {transfer}\n' +
            'Not: {notes}';
        const activeWaTemplate = (typeof manualBookingWaTemplate !== 'undefined' && manualBookingWaTemplate)
            ? manualBookingWaTemplate
            : ((typeof siteSettings !== 'undefined' && siteSettings && siteSettings.manualBookingWaTemplate)
                ? siteSettings.manualBookingWaTemplate
                : defaultWaTpl);

        const planCfg = (typeof paymentPlanSettings !== 'undefined' && paymentPlanSettings) ? paymentPlanSettings : {
            installmentPercent: 50,
            installmentInterestPercent: 0,
            fullPaymentDiscountPercent: 10
        };
        const contractCfg = (typeof rentalContract !== 'undefined' && rentalContract) ? rentalContract : {
            title: 'YachtVoyage Tekne Kiralama ve İptal Sözleşmesi',
            body: ''
        };
        const sCfg = (typeof siteSettings !== 'undefined' && siteSettings) ? siteSettings : {
            brandName: 'YachtVoyage',
            brandSubtext: 'Yacht Charter',
            phone: '+90 252 123 45 67',
            whatsappNumber: '902521234567',
            email: 'hello@yachtvoyage.com',
            footerAbout: 'Göcek, Marmaris, Fethiye ve Bodrum koylarında lisanslı kaptanlar ve özel filo ile yat kiralama ve günlük tur platformu.',
            copyrightText: '© 2026 YachtVoyage. Tüm hakları saklıdır.',
            conciergeWelcome: 'Merhaba! Rota planlaması, özel menü veya tekne müsaitliği için hızlıca yazabilirsiniz.'
        };
        const isAdminEn = (typeof isEn !== 'undefined' && Boolean(isEn)) || (typeof lang !== 'undefined' && lang === 'en');

        const normalizeBookingStatus = (raw) => {
            const v = String(raw || '').trim();
            if (v === 'Onaylandı' || v === 'confirmed' || v === 'approved') return 'Onaylandı';
            if (v === 'İptal' || v === 'İptal Edildi' || v === 'cancelled' || v === 'rejected' || v === 'Reddedildi' || v === 'Reddedildi (Hava Muhalefeti)') return 'İptal Edildi';
            return 'Beklemede';
        };

        const calcDaysUntilCheckIn = (checkInStr) => {
            if (!checkInStr || !/^\d{4}-\d{2}-\d{2}$/.test(String(checkInStr))) return null;
            const now = new Date();
            const todayUtc = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
            const p = String(checkInStr).split('-').map(Number);
            const targetUtc = Date.UTC(p[0], (p[1] || 1) - 1, p[2] || 1);
            return Math.round((targetUtc - todayUtc) / 86400000);
        };

        const buildWaLinkForRow = (bookingObj) => {
            if (bookingObj && bookingObj.whatsappUrl) return bookingObj.whatsappUrl;
            const cleanPh = String((bookingObj && bookingObj.phone) || '').replace(/\D/g, '');
            const tot = Number((bookingObj && bookingObj.totalAmount) || 0);
            const pd = Number((bookingObj && bookingObj.paidAmount) || 0);
            const rem = Math.max(0, tot - pd);
            const mapObj = {
                '{pnr}': (bookingObj && bookingObj.id) || '',
                '{customer}': (bookingObj && bookingObj.customer) || 'Misafir',
                '{yacht}': (bookingObj && bookingObj.yacht) || '',
                '{checkIn}': (bookingObj && bookingObj.checkIn) || '',
                '{checkOut}': (bookingObj && (bookingObj.checkOut || bookingObj.checkIn)) || '',
                '{timeSlot}': (bookingObj && bookingObj.tourTimeSlot) || 'Tam Gün',
                '{guests}': String((bookingObj && bookingObj.guests) || 1),
                '{totalAmount}': tot.toLocaleString(),
                '{paidAmount}': pd.toLocaleString(),
                '{remainingAmount}': rem.toLocaleString(),
                '{captain}': (bookingObj && bookingObj.assignedCaptain) || '-',
                '{transfer}': (bookingObj && bookingObj.assignedTransfer) || '-',
                '{notes}': (bookingObj && bookingObj.notes) || '-'
            };
            let msg = activeWaTemplate;
            Object.keys(mapObj).forEach(k => { msg = msg.split(k).join(mapObj[k]); });
            return cleanPh
                ? ('https://wa.me/' + encodeURIComponent(cleanPh) + '?text=' + encodeURIComponent(msg))
                : ('https://wa.me/?text=' + encodeURIComponent(msg));
        };
    %>

    <datalist id="adminCaptainList">
        <% safeCaptains.forEach(cp => { %>
            <option value="<%= cp.name %>"></option>
        <% }) %>
    </datalist>

    <datalist id="adminSlotList">
        <% safeTimeSlots.forEach(sl => { %>
            <option value="<%= sl.label %>"></option>
        <% }) %>
    </datalist>

<!-- MOBİL ÜST BAR -->
